lign: top;">Metakognitif</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Kaitan dengan Kehidupan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(254, 243, 199);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IV. INTEGRASI NILAI &amp; KARAKTER</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Nilai Karakter</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(224, 231, 255);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">V. DIMENSI PROFIL LULUSAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">DPL yang Dikembangkan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr></tbody></table><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VI. DESAIN PEMBELAJARAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Capaian Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Tujuan Pembelajaran</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Pemahaman Bermakna</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Model Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metode Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(240, 253, 244);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VII. LINTAS DISIPLIN ILMU</td></tr><tr style="background-color: rgb(252, 231, 243);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VIII. KEMITRAAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(207, 250, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IX. LINGKUNGAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(237, 233, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">X. PEMANFAATAN DIGITAL</td></tr></tbody></table><div style="margin-bottom: 30px;"><div style="background-color: rgb(226, 232, 240); padding: 8px; font-weight: bold; margin-bottom: 16px; border: 1px solid black;">XI. PENGALAMAN BELAJAR (LANGKAH PEMBELAJARAN)</div><div style="padding: 20px; text-align: center; color: rgb(107, 114, 128); border: 1px solid black;">Langkah pembelajaran akan muncul setelah generate modul</div></div><table style="width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin-top: 50px;"><tbody><tr><td style="width: 50%; text-align: center; vertical-align: top;">Mengetahui,<br>Kepala Sekolah<br><br><br><br><strong>...........................</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td><td style="width: 50%; text-align: center; vertical-align: top;">Guru Mata Pelajaran<br><br><br><br><br><strong>Guru</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td></tr></tbody></table></div><div data-section="lkpd" style="display: block; margin-top: 40px;"><div style=""></div><h2 style="text-align: center; font-weight: bold; font-size: 14pt; margin-bottom: 4px;">LEMBAR KERJA PESERTA DIDIK</h2><p style="text-align: center; font-size: 10pt; margin-bottom: 24px;">Model: Deep Learning 2026</p><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-bottom: 24px;"><h3 style="font-weight: bold; font-size: 12pt; margin-bottom: 12px;">Persiapan Akhir dan Simulasi Singkat</h3><div style="background-color: rgb(249, 250, 251); padding: 12px; margin-bottom: 12px;"><strong style="font-size: 10pt; color: rgb(75, 85, 99);">📖 Bacaan:</strong><p style="text-align: justify; white-space: pre-line; margin-top: 8px; margin-bottom: 0px;"><span>Etika Berwawancara:<br>1. Mengucapkan salam saat bertemu narasumber.<br>2. Memperkenalkan diri dan menjelaskan tujuan kedatangan.<br>3. Mengajukan pertanyaan secara berurutan sesuai daftar yang telah disiapkan.<br>4. Mendengarkan jawaban narasumber dengan seksama tanpa memotong pembicaraan.<br>5. Mengucapkan terima kasih setelah wawancara selesai.</span></p></div><p style="margin-bottom: 12px;"><span>Baca kembali etika berwawancara di atas bersama kelompokmu. Lakukan simulasi singkat selama 5 menit dengan teman sekelompok untuk membagi peran sebagai pewawancara dan pencatat.</span></p><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Siapa anggota kelompok yang bertugas mengajukan pertanyaan dan siapa yang mencatat?</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Apakah semua pertanyaan dalam daftar sudah disusun secara runtut?</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-bottom: 24px;"><h3 style="font-weight: bold; font-size: 12pt; margin-bottom: 12px;">Pelaksanaan Wawancara dengan Tokoh Sekolah</h3><div style="background-color: rgb(249, 250, 251); padding: 12px; margin-bottom: 12px;"><strong style="font-size: 10pt; color: rgb(75, 85, 99);">📖 Bacaan:</strong><p style="text-align: justify; white-space: pre-line; margin-top: 8px; margin-bottom: 0px;"><span>Panduan Pelaksanaan:<br>- Datanglah ke tempat narasumber sesuai jadwal yang telah ditentukan.<br>- Tunjukkan sikap sopan santun (senyum, salam, sapa).<br>- Rekam atau catat poin-poin penting dari jawaban narasumber.</span></p></div><p style="margin-bottom: 12px;"><span>Temui tokoh sekolah yang telah ditentukan (misalnya pustakawan atau guru piket). Lakukan wawancara sesuai dengan panduan pertanyaan yang telah dibuat pada pertemuan sebelumnya secara santun.</span></p><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Apa informasi paling menarik yang disampaikan oleh narasumber?</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Bagaimana kesan narasumber saat diwawancarai oleh kelompokmu?</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-bottom: 24px;"><h3 style="font-weight: bold; font-size: 12pt; margin-bottom: 12px;">Penyusunan Laporan Sederhana</h3><div style="background-color: rgb(249, 250, 251); padding: 12px; margin-bottom: 12px;"><strong style="font-size: 10pt; color: rgb(75, 85, 99);">📖 Bacaan:</strong><p style="text-align: justify; white-space: pre-line; margin-top: 8px; margin-bottom: 0px;"><span>Laporan hasil wawancara memuat:<br>1. Nama narasumber<br>2. Nama pewawancara (kelompok)<br>3. Waktu dan tempat wawancara<br>4. Hasil wawancara (inti jawaban narasumber)</span></p></div><p style="margin-bottom: 12px;"><span>Kembalilah ke kelas bersama kelompokmu. Susun hasil catatan wawancara menjadi sebuah laporan sederhana yang rapi dan mudah dibaca.</span></p><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Bagaimana cara menyusun poin-poin jawaban narasumber menjadi laporan yang runtut?</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div></div></div></div></div></div><div data-v2-export-item="d89ffb36-3eb1-4f40-ae43-f9708d7ae418:asesmen" data-v2-export-jenis="asesmen" data-v2-export-pertemuan="31" class="page-break-before" style="break-before: page;"><div data-v2-export-marker="true" style="font-size: 10pt; font-weight: 700; margin-bottom: 8px;">Pertemuan 31 — Asesmen</div><div class="document-preview bg-white mx-auto p-6 md:p-12 text-black" style="width: 100%; max-width: 210mm;"><div data-section="modul" style="display: none;"><div style="text-align: center; margin-bottom: 20px; border-bottom: 3px solid black; padding-bottom: 10px;"><h1 style="font-size: 16pt; font-weight: bold; margin: 0px; text-transform: uppercase;">MODUL AJAR: BAHASA INDONESIA</h1><p class="italic">Materi: Materi - Kelas Kelas</p></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">I. IDENTIFIKASI DASAR</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Identitas Umum</td><td style="border: 1px solid black; padding: 6px; vertical-align: top;"><div><strong>Nama Penyusun:</strong> Guru</div><div><strong>Sekolah:</strong> Sekolah</div><div><strong>Mata Pelajaran:</strong> Bahasa Indonesia</div><div><strong>Materi:</strong> Materi </div><div><strong>Kelas/Fase:</strong> Kelas / Fase</div><div><strong>Semester:</strong> 1</div><div><strong>Jumlah Pertemuan:</strong> 32 (0 Menit)</div></td></tr><tr style="background-color: rgb(219, 234, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">II. IDENTIFIKASI MURID</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Pengetahuan Awal</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Minat</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Latar Belakang</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Kebutuhan Belajar</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(209, 250, 229);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">III. JENIS PENGETAHUAN MATERI</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Faktual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Konseptual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Prosedural</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metakognitif</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Kaitan dengan Kehidupan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(254, 243, 199);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IV. INTEGRASI NILAI &amp; KARAKTER</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Nilai Karakter</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(224, 231, 255);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">V. DIMENSI PROFIL LULUSAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">DPL yang Dikembangkan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr></tbody></table><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VI. DESAIN PEMBELAJARAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Capaian Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Tujuan Pembelajaran</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Pemahaman Bermakna</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Model Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metode Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(240, 253, 244);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VII. LINTAS DISIPLIN ILMU</td></tr><tr style="background-color: rgb(252, 231, 243);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VIII. KEMITRAAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(207, 250, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IX. LINGKUNGAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(237, 233, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">X. PEMANFAATAN DIGITAL</td></tr></tbody></table><div style="margin-bottom: 30px;"><div style="background-color: rgb(226, 232, 240); padding: 8px; font-weight: bold; margin-bottom: 16px; border: 1px solid black;">XI. PENGALAMAN BELAJAR (LANGKAH PEMBELAJARAN)</div><div style="padding: 20px; text-align: center; color: rgb(107, 114, 128); border: 1px solid black;">Langkah pembelajaran akan muncul setelah generate modul</div></div><table style="width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin-top: 50px;"><tbody><tr><td style="width: 50%; text-align: center; vertical-align: top;">Mengetahui,<br>Kepala Sekolah<br><br><br><br><strong>...........................</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td><td style="width: 50%; text-align: center; vertical-align: top;">Guru Mata Pelajaran<br><br><br><br><br><strong>Guru</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td></tr></tbody></table></div><div data-section="asesmen" style="display: block; margin-top: 40px;"><div style=""></div><h2 style="text-align: center; font-weight: bold; font-size: 14pt; text-transform: uppercase; margin-bottom: 24px;">Instrumen Asesmen Pembelajaran</h2><div style="margin-bottom: 24px;"><h3 style="font-weight: bold; font-size: 12pt; margin-bottom: 8px;">A. ASESMEN AWAL PEMBELAJARAN (Diagnostik)</h3><p style="font-style: italic; font-size: 10pt; margin-bottom: 8px;">Mengidentifikasi kesiapan siswa dalam mempraktikkan teknik dasar wawancara setelah menyusun daftar pertanyaan pada pertemuan sebelumnya.</p><p style="margin-bottom: 12px;"><strong>Metode:</strong> Pertanyaan Lisan dan Tanya Jawab</p><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black;"><thead><tr style="background-color: rgb(241, 245, 249);"><th style="border: 1px solid black; padding: 8px; width: 5%;">No</th><th style="border: 1px solid black; padding: 8px; width: 55%;">Pertanyaan Pemantik</th><th style="border: 1px solid black; padding: 8px; width: 40%;">Tujuan</th></tr></thead><tbody><tr><td style="border: 1px solid black; padding: 8px; text-align: center;">1</td><td style="border: 1px solid black; padding: 8px;"><span>Masih ingatkah kalian, apa saja hal penting yang harus diperhatikan saat kita mulai berbicara atau menyapa narasumber?</span></td><td style="border: 1px solid black; padding: 8px;"><span>Menggali pengetahuan awal mengenai kesopanan dan etika dasar dalam memulai wawancara.</span></td></tr><tr><td style="border: 1px solid black; padding: 8px; text-align: center;">2</td><td style="border: 1px solid black; padding: 8px;"><span>Bagaimana cara kalian bersikap jika narasumber menjawab pertanyaan dengan jawaban yang panjang dan bercerita?</span></td><td style="border: 1px solid black; padding: 8px;"><span>Mengetahui pemahaman siswa tentang sikap menyimak dan mencatat poin penting.</span></td></tr></tbody></table></div></div><div style="margin-bottom: 24px;"><h3 style="font-weight: bold; font-size: 12pt; margin-bottom: 8px;">B. ASESMEN PROSES PEMBELAJARAN (Formatif)</h3><p style="font-style: italic; font-size: 10pt; margin-bottom: 8px;">Assessment as Learning untuk memantau proses simulasi wawancara antar teman sejawat sebelum praktik langsung dengan tokoh sekolah.</p><p style="margin-bottom: 16px;"><strong>Metode:</strong> Observasi, Penilaian Kinerja, Diskusi Kelompok</p><div style="margin-bottom: 16px;"><h4 style="font-weight: bold; margin-bottom: 8px;">Aktivitas 1: Simulasi Wawancara Berpasangan (Role Play)</h4><p style="margin-bottom: 8px;"><strong>Instruksi:</strong> <span>Bentuk kelompok berpasangan. Siswa A bertindak sebagai pewawancara menggunakan daftar pertanyaan yang sudah dibuat, siswa B bertindak sebagai tokoh sekolah (misal: penjaga sekolah atau pustakawan). Lakukan secara bergantian selama 15 menit.</span></p><div style="margin-bottom: 8px;"><strong>Pertanyaan Diskusi:</strong><ul style="margin-left: 20px; margin-top: 4px; list-style-type: disc;"><li><span>Bagian mana dari wawancara tadi yang terasa paling sulit?</span></li><li><span>Apakah intonasi suara dan bahasa tubuh sudah mencerminkan sikap santun?</span></li></ul></div><div><strong>Kunci Jawaban:</strong><ul style="margin-left: 20px; margin-top: 4px; list-style-type: disc;"><li><span>Siswa mampu membaca pertanyaan dengan jelas tanpa terpaku kaku pada teks.</span></li><li><span>Siswa mampu menggunakan bahasa Indonesia yang santun dan gestur tubuh yang menghargai lawan bicara.</span></li></ul></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-top: 16px;"><h4 style="font-weight: bold; margin-bottom: 8px;">Rubrik Penilaian Proses</h4><table style="width: 100%; border-collapse: collapse; border: 1px solid black;"><thead><tr style="background-color: rgb(241, 245, 249);"><th style="border: 1px solid black; padding: 8px;">Aspek</th><th style="border: 1px solid black; padding: 8px;">Sangat Baik (4)</th><th style="border: 1px solid black; padding: 8px;">Baik (3)</th><th style="border: 1px solid black; padding: 8px;">Cukup (2)</th><th style="border: 1px solid black; padding: 8px;">Kurang (1)</th></tr></thead><tbody><tr><td style="border: 1px solid black; padding: 8px; font-weight: bold;">Penggunaan Bahasa dan Sikap Tubuh</td><td style="border: 1px solid black; padding: 8px;"><span>Menggunakan bahasa yang santun, intonasi jelas, kontak mata baik, dan gestur menghargai narasumber sepanjang praktik.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Menggunakan bahasa santun dan intonasi cukup jelas, sesekali kontak mata terlewat namun tetap sopan.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Bahasa kurang bervariasi, intonasi terlalu pelan atau cepat, kurang menjaga kontak mata dengan narasumber.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Menggunakan bahasa yang kurang sopan atau tidak sesuai konteks, acuh tak acuh selama proses wawancara.</span></td></tr><tr><td style="border: 1px solid black; padding: 8px; font-weight: bold;">Penyampaian Pertanyaan dan Menyimak</td><td style="border: 1px solid black; padding: 8px;"><span>Menyampaikan pertanyaan sesuai daftar secara runtut dan menyimak jawaban dengan mencatat poin penting.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Menyampaikan pertanyaan secara runtut tetapi kurang optimal dalam mencatat jawaban narasumber.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Pertanyaan disampaikan meloncat-loncat dan kurang menyimak jawaban narasumber.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Tidak membawa atau tidak menggunakan daftar pertanyaan yang telah disiapkan.</span></td></tr></tbody></table></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-top: 16px;"><p style="font-weight: bold; margin-bottom: 4px;">📝 Penilaian Diri:</p><ul style="margin-left: 20px; list-style-type: disc;"><li><span>Apakah saya sudah menggunakan nada suara yang ramah dan sopan saat bertanya?</span></li><li><span>Apakah saya mendengarkan jawaban teman saya dengan seksama sebelum beralih ke pertanyaan berikutnya?</span></li></ul></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-top: 12px;"><p style="font-weight: bold; margin-bottom: 4px;">👥 Penilaian Sejawat:</p><ul style="margin-left: 20px; list-style-type: disc;"><li><span>Teman saya menggunakan sapaan dan kalimat penutup yang santun.</span></li><li><span>Teman saya membaca dan menyampaikan daftar pertanyaan dengan jelas dan percaya diri.</span></li></ul></div></div></div><div style="margin-bottom: 24px;"><h3 style="font-weight: bold; font-size: 12pt; margin-bottom: 8px;">C. ASESMEN AKHIR PEMBELAJARAN (Sumatif)</h3><p style="font-style: italic; font-size: 10pt; margin-bottom: 8px;">Assessment of Learning untuk mengukur pencapaian TP14 melalui praktik nyata wawancara dengan tokoh di sekolah (misalnya penjaga perpustakaan atau petugas kebersihan) pada akhir sesi.</p><p style="margin-bottom: 12px;"><strong>Metode:</strong> Tes Tertulis Uraian dan Penilaian Kinerja Praktik</p><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-bottom: 16px;"><h4 style="font-weight: bold; margin-bottom: 8px;">Soal Uraian</h4><table style="width: 100%; border-collapse: collapse; border: 1px solid black;"><thead><tr style="background-color: rgb(241, 245, 249);"><th style="border: 1px solid black; padding: 8px; width: 5%;">No</th><th style="border: 1px solid black; padding: 8px; width: 45%;">Pertanyaan</th><th style="border: 1px solid black; padding: 8px; width: 40%;">Kunci Jawaban</th><th style="border: 1px solid black; padding: 8px; width: 10%;">Skor</th></tr></thead><tbody><tr><td style="border: 1px solid black; padding: 8px; text-align: center;">1</td><td style="border: 1px solid black; padding: 8px;"><span>Jelaskan langkah pertama yang harus kamu lakukan saat pertama kali berjumpa dengan tokoh sekolah yang akan kamu wawancarai!</span></td><td style="border: 1px solid black; padding: 8px;"><span>Mengucapkan salam dengan ramah, memperkenalkan diri, menyebutkan tujuan kedatangan dengan sopan, dan meminta izin untuk memulai wawancara.</span></td><td style="border: 1px solid black; padding: 8px; text-align: center;">25</td></tr><tr><td style="border: 1px solid black; padding: 8px; text-align: center;">2</td><td style="border: 1px solid black; padding: 8px;"><span>Mengapa seorang pewawancara harus bersikap ramah dan menyimak dengan baik saat narasumber sedang berbicara?</span></td><td style="border: 1px solid black; padding: 8px;"><span>Agar narasumber merasa dihargai, nyaman, dan mau memberikan informasi yang jujur serta lengkap.</span></td><td style="border: 1px solid black; padding: 8px; text-align: center;">25</td></tr><tr><td style="border: 1px solid black; padding: 8px; text-align: center;">3</td><td style="border: 1px solid black; padding: 8px;"><span>Tuliskan satu contoh kalimat penutup yang santun untuk mengakhiri kegiatan wawancara dengan tokoh sekolah!</span></td><td style="border: 1px solid black; padding: 8px;"><span>Contoh: 'Terima kasih banyak atas waktu dan informasi yang Bapak/Ibu berikan, semoga sehat selalu.'</span></td><td style="border: 1px solid black; padding: 8px; text-align: center;">25</td></tr><tr><td style="border: 1px solid black; padding: 8px; text-align: center;">4</td><td style="border: 1px solid black; padding: 8px;"><span>Bagaimana cara menyikapi jawaban narasumber yang terlalu cepat atau sulit dipahami saat kamu sedang mencatat?</span></td><td style="border: 1px solid black; padding: 8px;"><span>Meminta izin dengan sopan kepada narasumber untuk mengulangi penjelasannya menggunakan kalimat yang lebih pelan.</span></td><td style="border: 1px solid black; padding: 8px; text-align: center;">25</td></tr></tbody></table></div></div><div style="margin-top: 16px;"><h4 style="font-weight: bold; margin-bottom: 8px;">Rubrik Penilaian Akhir</h4><table style="width: 100%; border-collapse: collapse; border: 1px solid black;"><thead><tr style="background-color: rgb(241, 245, 249);"><th style="border: 1px solid black; padding: 8px;">Aspek</th><th style="border: 1px solid black; padding: 8px;">Sangat Baik (4)</th><th style="border: 1px solid black; padding: 8px;">Baik (3)</th><th style="border: 1px solid black; padding: 8px;">Cukup (2)</th><th style="border: 1px solid black; padding: 8px;">Kurang (1)</th></tr></thead><tbody><tr><td style="border: 1px solid black; padding: 8px; font-weight: bold;">Ketepatan Konsep Etika dan Praktik Wawancara</td><td style="border: 1px solid black; padding: 8px;"><span>Menjawab seluruh pertanyaan uraian dengan sangat tepat, runtut, dan mencerminkan pemahaman mendalam tentang etika wawancara.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Menjawab pertanyaan dengan tepat namun ada sedikit detail kecil yang terlewat.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Menjawab pertanyaan dengan cukup akurat tetapi kurang mendalam dalam menjelaskan alasannya.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Jawaban tidak sesuai dengan konsep wawancara yang santun dan benar.</span></td></tr></tbody></table></div><div style="margin-top: 16px;"><p><strong>Pedoman Penskoran:</strong></p><p>Skor Total: 100</p><p>Rumus Nilai: (Skor Perolehan / Skor Maksimal) x 100</p></div></div></div></div></div><div data-v2-export-item="d89ffb36-3eb1-4f40-ae43-f9708d7ae418:soal" data-v2-export-jenis="soal" data-v2-export-pertemuan="31" class="page-break-before" style="break-before: page;"><div data-v2-export-marker="true" style="font-size: 10pt; font-weight: 700; margin-bottom: 8px;">Pertemuan 31 — Soal</div><div class="document-preview bg-white mx-auto p-6 md:p-12 text-black" style="width: 100%; max-width: 210mm;"><div data-section="modul" style="display: none;"><div style="text-align: center; margin-bottom: 20px; border-bottom: 3px solid black; padding-bottom: 10px;"><h1 style="font-size: 16pt; font-weight: bold; margin: 0px; text-transform: uppercase;">MODUL AJAR: BAHASA INDONESIA</h1><p class="italic">Materi: Materi - Kelas Kelas</p></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">I. IDENTIFIKASI DASAR</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Identitas Umum</td><td style="border: 1px solid black; padding: 6px; vertical-align: top;"><div><strong>Nama Penyusun:</strong> Guru</div><div><strong>Sekolah:</strong> Sekolah</div><div><strong>Mata Pelajaran:</strong> Bahasa Indonesia</div><div><strong>Materi:</strong> Materi </div><div><strong>Kelas/Fase:</strong> Kelas / Fase</div><div><strong>Semester:</strong> 1</div><div><strong>Jumlah Pertemuan:</strong> 32 (0 Menit)</div></td></tr><tr style="background-color: rgb(219, 234, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">II. IDENTIFIKASI MURID</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Pengetahuan Awal</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Minat</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Latar Belakang</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Kebutuhan Belajar</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(209, 250, 229);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">III. JENIS PENGETAHUAN MATERI</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Faktual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Konseptual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Prosedural</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metakognitif</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Kaitan dengan Kehidupan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(254, 243, 199);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IV. INTEGRASI NILAI &amp; KARAKTER</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Nilai Karakter</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(224, 231, 255);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">V. DIMENSI PROFIL LULUSAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">DPL yang Dikembangkan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr></tbody></table><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VI. DESAIN PEMBELAJARAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Capaian Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Tujuan Pembelajaran</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Pemahaman Bermakna</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Model Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metode Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(240, 253, 244);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VII. LINTAS DISIPLIN ILMU</td></tr><tr style="background-color: rgb(252, 231, 243);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VIII. KEMITRAAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(207, 250, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IX. LINGKUNGAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(237, 233, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">X. PEMANFAATAN DIGITAL</td></tr></tbody></table><div style="margin-bottom: 30px;"><div style="background-color: rgb(226, 232, 240); padding: 8px; font-weight: bold; margin-bottom: 16px; border: 1px solid black;">XI. PENGALAMAN BELAJAR (LANGKAH PEMBELAJARAN)</div><div style="padding: 20px; text-align: center; color: rgb(107, 114, 128); border: 1px solid black;">Langkah pembelajaran akan muncul setelah generate modul</div></div><table style="width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin-top: 50px;"><tbody><tr><td style="width: 50%; text-align: center; vertical-align: top;">Mengetahui,<br>Kepala Sekolah<br><br><br><br><strong>...........................</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td><td style="width: 50%; text-align: center; vertical-align: top;">Guru Mata Pelajaran<br><br><br><br><br><strong>Guru</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td></tr></tbody></table></div><div data-section="soal" style="display: block; margin-top: 40px;"><div data-subsection="soal-siswa"><h2 style="font-weight: bold; font-size: 12pt; text-align: center; margin-bottom: 12px;">LEMBAR SOAL</h2><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 1</p><p style="text-align: justify; margin: 0px;"><span>Pagi itu, suasana di SD Nusantara terlihat sangat ceria. Siti dan Budi mendapatkan tugas dari guru bahasa Indonesia untuk melakukan wawancara dengan kepala sekolah, Bapak Ahmad. Mereka telah mempersiapkan daftar pertanyaan dengan baik sehari sebelumnya. Siti bertugas membawa buku catatan dan pulpen, sedangkan Budi bertugas mengajukan pertanyaan secara langsung. Topik utama wawancara tersebut adalah pentingnya menjaga kebersihan lingkungan sekolah agar kegiatan belajar menjadi lebih nyaman dan sehat bagi seluruh siswa.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">1.</span> <span style="font-weight: normal;"><span>Siapakah tokoh yang bertugas mengajukan pertanyaan secara langsung kepada kepala sekolah?</span></span></p><div style="margin-left: 20px; margin-top: 4px;"><p style="margin: 2px 0px; font-weight: normal;">A. <span>Siti</span></p><p style="margin: 2px 0px; font-weight: normal;">B. <span>Budi</span></p><p style="margin: 2px 0px; font-weight: normal;">C. <span>Ahmad</span></p><p style="margin: 2px 0px; font-weight: normal;">D. <span>Dewi</span></p></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 2</p><p style="text-align: justify; margin: 0px;"><span>Sebelum memulai wawancara, seorang pewawancara yang baik harus memperhatikan etika dan kesopanan. Dewi dan Siti datang menemui Ibu Dewi selaku pustakawan sekolah dengan mengucapkan salam terlebih dahulu. Mereka mengetuk pintu ruangan dan menunggu izin sebelum masuk. Dewi juga memperkenalkan diri dengan ramah dan menyampaikan maksud kedatangan mereka secara jelas. Sikap santun ini sangat penting agar narasumber merasa dihargai dan wawancara dapat berjalan dengan lancar serta menyenangkan.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">2.</span> <span style="font-weight: normal;"><span>Apa tindakan pertama yang dilakukan Dewi dan Siti sebelum masuk ke ruangan narasumber?</span></span></p><div style="margin-left: 20px; margin-top: 4px;"><p style="margin: 2px 0px; font-weight: normal;">A. <span>Mengetuk pintu</span></p><p style="margin: 2px 0px; font-weight: normal;">B. <span>Langsung duduk</span></p><p style="margin: 2px 0px; font-weight: normal;">C. <span>Membawa buku</span></p><p style="margin: 2px 0px; font-weight: normal;">D. <span>Berbicara keras</span></p></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 3</p><p style="text-align: justify; margin: 0px;"><span>Dalam menyusun daftar pertanyaan wawancara, kita harus menggunakan kalimat tanya yang efektif dan sesuai dengan kaidah bahasa. Kata tanya yang sering digunakan meliputi apa, siapa, di mana, kapan, mengapa, dan bagaimana atau yang sering disingkat menjadi adik simba. Ahmad ingin menggali informasi tentang sejarah berdirinya kantin sehat di sekolah. Oleh karena itu, ia merumuskan pertanyaan menggunakan kata tanya bagaimana proses awal mula pendirian kantin tersebut bersama Ibu Siti selaku pengelola.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">3.</span> <span style="font-weight: normal;"><span>Informasi apa yang ingin digali Ahmad saat mewawancarai pengelola kantin sekolah?</span></span></p><div style="margin-left: 20px; margin-top: 4px;"><p style="margin: 2px 0px; font-weight: normal;">A. <span>Sejarah kantin</span></p><p style="margin: 2px 0px; font-weight: normal;">B. <span>Jadwal olahraga</span></p><p style="margin: 2px 0px; font-weight: normal;">C. <span>Jumlah siswa</span></p><p style="margin: 2px 0px; font-weight: normal;">D. <span>Peraturan kelas</span></p></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 4</p><p style="text-align: justify; margin: 0px;"><span>Saat wawancara berlangsung, seorang pewawancara harus aktif mendengarkan jawaban dari narasumber. Budi mencatat poin-poin penting yang disampaikan oleh Bapak Ahmad terkait jadwal kegiatan kerja bakti mingguan. Terkadang, Budi juga mengajukan pertanyaan lanjutan untuk memperjelas informasi yang belum lengkap. Sikap aktif dan antusias ini menunjukkan bahwa pewawancara benar-benar menghargai waktu dan ilmu yang dibagikan oleh narasumber di sekolah.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">4.</span> <span style="font-weight: normal;"><span>Apa yang dilakukan Budi untuk merekam informasi penting yang disampaikan oleh kepala sekolah?</span></span></p><div style="margin-left: 20px; margin-top: 4px;"><p style="margin: 2px 0px; font-weight: normal;">A. <span>Mencatat poin</span></p><p style="margin: 2px 0px; font-weight: normal;">B. <span>Diam saja</span></p><p style="margin: 2px 0px; font-weight: normal;">C. <span>Segera pulang</span></p><p style="margin: 2px 0px; font-weight: normal;">D. <span>Bermain bola</span></p></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 5</p><p style="text-align: justify; margin: 0px;"><span>Setelah proses tanya jawab selesai, rangkaian kegiatan wawancara belum sepenuhnya berakhir. Siti dan Budi mengucapkan terima kasih kepada Bapak Ahmad atas kesediaan waktu dan informasi yang telah diberikan. Keesokan harinya, mereka merapikan catatan hasil wawancara tersebut ke dalam bentuk laporan tertulis yang rapi dan mudah dibaca oleh teman-teman sekelas. Laporan ini kemudian dikumpulkan kepada guru untuk dinilai sebagai bagian dari tugas praktik bahasa Indonesia.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">5.</span> <span style="font-weight: normal;"><span>Kepada siapakah laporan hasil wawancara tersebut dikumpulkan keesokan harinya?</span></span></p><div style="margin-left: 20px; margin-top: 4px;"><p style="margin: 2px 0px; font-weight: normal;">A. <span>Guru kelas</span></p><p style="margin: 2px 0px; font-weight: normal;">B. <span>Kepala desa</span></p><p style="margin: 2px 0px; font-weight: normal;">C. <span>Penjaga toko</span></p><p style="margin: 2px 0px; font-weight: normal;">D. <span>Petugas pos</span></p></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 6</p><p style="text-align: justify; margin: 0px;"><span>Pagi itu, suasana di SD Nusantara terlihat sangat ceria. Siti dan Budi mendapatkan tugas dari guru bahasa Indonesia untuk melakukan wawancara dengan kepala sekolah, Bapak Ahmad. Mereka telah mempersiapkan daftar pertanyaan dengan baik sehari sebelumnya. Siti bertugas membawa buku catatan dan pulpen, sedangkan Budi bertugas mengajukan pertanyaan secara langsung. Topik utama wawancara tersebut adalah pentingnya menjaga kebersihan lingkungan sekolah agar kegiatan belajar menjadi lebih nyaman dan sehat bagi seluruh siswa.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">6.</span> <span style="font-weight: normal;"><span>Tentukan apakah pernyataan berikut Benar atau Salah berdasarkan teks tentang persiapan wawancara!</span></span></p><table style="width: 95%; border-collapse: collapse; border: 1px solid rgb(0, 0, 0); margin-bottom: 16px; margin-left: 20px; margin-top: 6px;"><thead><tr><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 40px;">No</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left;">Pernyataan</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 60px;">Benar</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 60px;">Salah</th></tr></thead><tbody><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">1</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Siti dan Budi mendapatkan tugas dari guru bahasa Indonesia</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">2</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Bapak Ahmad bertindak sebagai siswa kelas empat</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">3</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Topik wawancara berkaitan dengan kebersihan lingkungan sekolah</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr></tbody></table></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 7</p><p style="text-align: justify; margin: 0px;"><span>Sebelum memulai wawancara, seorang pewawancara yang baik harus memperhatikan etika dan kesopanan. Dewi dan Siti datang menemui Ibu Dewi selaku pustakawan sekolah dengan mengucapkan salam terlebih dahulu. Mereka mengetuk pintu ruangan dan menunggu izin sebelum masuk. Dewi juga memperkenalkan diri dengan ramah dan menyampaikan maksud kedatangan mereka secara jelas. Sikap santun ini sangat penting agar narasumber merasa dihargai dan wawancara dapat berjalan dengan lancar serta menyenangkan.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">7.</span> <span style="font-weight: normal;"><span>Tentukan apakah pernyataan berikut Benar atau Salah berdasarkan teks etika wawancara!</span></span></p><table style="width: 95%; border-collapse: collapse; border: 1px solid rgb(0, 0, 0); margin-bottom: 16px; margin-left: 20px; margin-top: 6px;"><thead><tr><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 40px;">No</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left;">Pernyataan</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 60px;">Benar</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 60px;">Salah</th></tr></thead><tbody><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">1</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Dewi dan Siti menemui pustakawan tanpa mengucapkan salam</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">2</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Pewawancara yang baik harus bersikap santun dan ramah</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">3</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Tujuan kedatangan harus disampaikan secara jelas</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr></tbody></table></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 8</p><p style="text-align: justify; margin: 0px;"><span>Dalam menyusun daftar pertanyaan wawancara, kita harus menggunakan kalimat tanya yang efektif dan sesuai dengan kaidah bahasa. Kata tanya yang sering digunakan meliputi apa, siapa, di mana, kapan, mengapa, dan bagaimana atau yang sering disingkat menjadi adik simba. Ahmad ingin menggali informasi tentang sejarah berdirinya kantin sehat di sekolah. Oleh karena itu, ia merumuskan pertanyaan menggunakan kata tanya bagaimana proses awal mula pendirian kantin tersebut bersama Ibu Siti selaku pengelola.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">8.</span> <span style="font-weight: normal;"><span>Tentukan apakah pernyataan berikut Benar atau Salah mengenai penyusunan pertanyaan wawancara!</span></span></p><table style="width: 95%; border-collapse: collapse; border: 1px solid rgb(0, 0, 0); margin-bottom: 16px; margin-left: 20px; margin-top: 6px;"><thead><tr><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 40px;">No</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left;">Pernyataan</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 60px;">Benar</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 60px;">Salah</th></tr></thead><tbody><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">1</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Kata tanya adik simba mencakup apa, siapa, dan bagaimana</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">2</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Ahmad menanyakan tentang sejarah berdirinya kantin sehat</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">3</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Pewawancara boleh menggunakan kalimat yang tidak sopan</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr></tbody></table></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 9</p><p style="text-align: justify; margin: 0px;"><span>Setelah proses tanya jawab selesai, rangkaian kegiatan wawancara belum sepenuhnya berakhir. Siti dan Budi mengucapkan terima kasih kepada Bapak Ahmad atas kesediaan waktu dan informasi yang telah diberikan. Keesokan harinya, mereka merapikan catatan hasil wawancara tersebut ke dalam bentuk laporan tertulis yang rapi dan mudah dibaca oleh teman-teman sekelas. Laporan ini kemudian dikumpulkan kepada guru untuk dinilai sebagai bagian dari tugas praktik bahasa Indonesia.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">9.</span> <span style="font-weight: normal;"><span>Tentukan apakah pernyataan berikut Benar atau Salah mengenai kegiatan penutup wawancara!</span></span></p><table style="width: 95%; border-collapse: collapse; border: 1px solid rgb(0, 0, 0); margin-bottom: 16px; margin-left: 20px; margin-top: 6px;"><thead><tr><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 40px;">No</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left;">Pernyataan</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 60px;">Benar</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 60px;">Salah</th></tr></thead><tbody><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">1</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Siti dan Budi mengucapkan terima kasih kepada narasumber</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">2</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Hasil wawancara dibiarkan berserakan tanpa dirapikan</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">3</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Laporan tertulis dikumpulkan kepada guru bahasa Indonesia</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr></tbody></table></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 10</p><p style="text-align: justify; margin: 0px;"><span>Wawancara merupakan salah satu cara efektif untuk mendapatkan informasi langsung dari narasumber terpercaya. Di lingkungan sekolah, kita bisa mewawancarai berbagai tokoh penting seperti kepala sekolah, guru mata pelajaran, pustakawan, hingga petugas kebersihan sekolah. Setiap narasumber memiliki keahlian dan pengalaman berbeda yang sangat bermanfaat untuk memperluas wawasan siswa dalam memahami situasi nyata di sekitar lingkungan sekolah mereka.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">10.</span> <span style="font-weight: normal;"><span>Pilih pernyataan yang BENAR mengenai siapa saja tokoh sekolah yang dapat dijadikan narasumber wawancara! (Lebih dari satu jawaban benar)</span></span></p><div style="margin-left: 20px; margin-top: 4px;"><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>A. <span>Kepala sekolah</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>B. <span>Petugas kebersihan</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>C. <span>Pemain sepak bola asing</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>D. <span>Pustakawan sekolah</span></p></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 11</p><p style="text-align: justify; margin: 0px;"><span>Saat wawancara berlangsung, seorang pewawancara harus aktif mendengarkan jawaban dari narasumber. Budi mencatat poin-poin penting yang disampaikan oleh Bapak Ahmad terkait jadwal kegiatan kerja bakti mingguan. Terkadang, Budi juga mengajukan pertanyaan lanjutan untuk memperjelas informasi yang belum lengkap. Sikap aktif dan antusias ini menunjukkan bahwa pewawancara benar-benar menghargai waktu dan ilmu yang dibagikan oleh narasumber di sekolah.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">11.</span> <span style="font-weight: normal;"><span>Pilih pernyataan yang BENAR mengenai kegiatan yang harus dilakukan saat wawancara berlangsung! (Lebih dari satu jawaban benar)</span></span></p><div style="margin-left: 20px; margin-top: 4px;"><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>A. <span>Mendengarkan jawaban narasumber secara aktif</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>B. <span>Mencatat poin-poin penting informasi</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>C. <span>Mengabaikan penjelasan narasumber sepenuhnya</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>D. <span>Mengajukan pertanyaan lanjutan jika diperlukan</span></p></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 12</p><p style="text-align: justify; margin: 0px;"><span>Wawancara merupakan salah satu cara efektif untuk mendapatkan informasi langsung dari narasumber terpercaya. Di lingkungan sekolah, kita bisa mewawancarai berbagai tokoh penting seperti kepala sekolah, guru mata pelajaran, pustakawan, hingga petugas kebersihan sekolah. Setiap narasumber memiliki keahlian dan pengalaman berbeda yang sangat bermanfaat untuk memperluas wawasan siswa dalam memahami situasi nyata di sekitar lingkungan sekolah mereka.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">12.</span> <span style="font-weight: normal;"><span>Pilih pernyataan yang BENAR mengenai manfaat kegiatan wawancara bagi siswa! (Lebih dari satu jawaban benar)</span></span></p><div style="margin-left: 20px; margin-top: 4px;"><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>A. <span>Memperluas wawasan tentang lingkungan sekolah</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>B. <span>Mendapatkan informasi langsung dari narasumber terpercaya</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>C. <span>Menghindari interaksi dengan semua warga sekolah</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>D. <span>Melatih keterampilan berbicara dan bersikap santun</span></p></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 13</p><p style="text-align: justify; margin: 0px;"><span>Pagi itu, suasana di SD Nusantara terlihat sangat ceria. Siti dan Budi mendapatkan tugas dari guru bahasa Indonesia untuk melakukan wawancara dengan kepala sekolah, Bapak Ahmad. Mereka telah mempersiapkan daftar pertanyaan dengan baik sehari sebelumnya. Siti bertugas membawa buku catatan dan pulpen, sedangkan Budi bertugas mengajukan pertanyaan secara langsung. Topik utama wawancara tersebut adalah pentingnya menjaga kebersihan lingkungan sekolah agar kegiatan belajar menjadi lebih nyaman dan sehat bagi seluruh siswa.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">13.</span> <span style="font-weight: normal;"><span>Jodohkan peran tokoh di kolom kiri dengan tugas atau aktivitasnya di kolom kanan berdasarkan teks!</span></span></p><table style="width: 95%; border-collapse: collapse; margin-left: 20px; margin-top: 6px;"><tbody><tr><td style="width: 50%; vertical-align: top; padding: 4px 8px;"><p style="margin: 0px 0px 4px; font-weight: bold;">Premis</p><ol style="margin: 0px; padding-left: 20px; list-style-type: decimal;"><li style="margin: 2px 0px;"><span>Siti</span></li><li style="margin: 2px 0px;"><span>Budi</span></li><li style="margin: 2px 0px;"><span>Bapak Ahmad</span></li></ol></td><td style="width: 50%; vertical-align: top; padding: 4px 8px;"><p style="margin: 0px 0px 4px; font-weight: bold;">Respon</p><ol style="margin: 0px; padding-left: 20px; list-style-type: upper-alpha;"><li style="margin: 2px 0px;"><span>Mengajukan pertanyaan wawancara</span></li><li style="margin: 2px 0px;"><span>Membawa buku catatan dan pulpen</span></li><li style="margin: 2px 0px;"><span>Menjadi narasumber kepala sekolah</span></li></ol></td></tr></tbody></table></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 14</p><p style="text-align: justify; margin: 0px;"><span>Sebelum memulai wawancara, seorang pewawancara yang baik harus memperhatikan etika dan kesopanan. Dewi dan Siti datang menemui Ibu Dewi selaku pustakawan sekolah dengan mengucapkan salam terlebih dahulu. Mereka mengetuk pintu ruangan dan menunggu izin sebelum masuk. Dewi juga memperkenalkan diri dengan ramah dan menyampaikan maksud kedatangan mereka secara jelas. Sikap santun ini sangat penting agar narasumber merasa dihargai dan wawancara dapat berjalan dengan lancar serta menyenangkan.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">14.</span> <span style="font-weight: normal;"><span>Jodohkan sikap kesopanan di kolom kiri dengan tindakan yang sesuai di kolom kanan!</span></span></p><table style="width: 95%; border-collapse: collapse; margin-left: 20px; margin-top: 6px;"><tbody><tr><td style="width: 50%; vertical-align: top; padding: 4px 8px;"><p style="margin: 0px 0px 4px; font-weight: bold;">Premis</p><ol style="margin: 0px; padding-left: 20px; list-style-type: decimal;"><li style="margin: 2px 0px;"><span>Mengucapkan salam</span></li><li style="margin: 2px 0px;"><span>Mengetuk pintu</span></li><li style="margin: 2px 0px;"><span>Memperkenalkan diri</span></li></ol></td><td style="width: 50%; vertical-align: top; padding: 4px 8px;"><p style="margin: 0px 0px 4px; font-weight: bold;">Respon</p><ol style="margin: 0px; padding-left: 20px; list-style-type: upper-alpha;"><li style="margin: 2px 0px;"><span>Menyapa narasumber dengan sopan saat masuk</span></li><li style="margin: 2px 0px;"><span>Meminta izin sebelum memasuki ruangan</span></li><li style="margin: 2px 0px;"><span>Menyampaikan nama dan maksud kedatangan</span></li></ol></td></tr></tbody></table></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 15</p><p style="text-align: justify; margin: 0px;"><span>Dalam menyusun daftar pertanyaan wawancara, kita harus menggunakan kalimat tanya yang efektif dan sesuai dengan kaidah bahasa. Kata tanya yang sering digunakan meliputi apa, siapa, di mana, kapan, mengapa, dan bagaimana atau yang sering disingkat menjadi adik simba. Ahmad ingin menggali informasi tentang sejarah berdirinya kantin sehat di sekolah. Oleh karena itu, ia merumuskan pertanyaan menggunakan kata tanya bagaimana proses awal mula pendirian kantin tersebut bersama Ibu Siti selaku pengelola.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">15.</span> <span style="font-weight: normal;"><span>Jodohkan kata tanya di kolom kiri dengan jenis informasi yang digali di kolom kanan!</span></span></p><table style="width: 95%; border-collapse: collapse; margin-left: 20px; margin-top: 6px;"><tbody><tr><td style="width: 50%; vertical-align: top; padding: 4px 8px;"><p style="margin: 0px 0px 4px; font-weight: bold;">Premis</p><ol style="margin: 0px; padding-left: 20px; list-style-type: decimal;"><li style="margin: 2px 0px;"><span>Bagaimana</span></li><li style="margin: 2px 0px;"><span>Siapa</span></li><li style="margin: 2px 0px;"><span>Apa</span></li></ol></td><td style="width: 50%; vertical-align: top; padding: 4px 8px;"><p style="margin: 0px 0px 4px; font-weight: bold;">Respon</p><ol style="margin: 0px; padding-left: 20px; list-style-type: upper-alpha;"><li style="margin: 2px 0px;"><span>Proses awal mula pendirian kantin</span></li><li style="margin: 2px 0px;"><span>Pengelola kantin sekolah</span></li><li style="margin: 2px 0px;"><span>Topik atau informasi umum</span></li></ol></td></tr></tbody></table></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 16</p><p style="text-align: justify; margin: 0px;"><span>Setelah proses tanya jawab selesai, rangkaian kegiatan wawancara belum sepenuhnya berakhir. Siti dan Budi mengucapkan terima kasih kepada Bapak Ahmad atas kesediaan waktu dan informasi yang telah diberikan. Keesokan harinya, mereka merapikan catatan hasil wawancara tersebut ke dalam bentuk laporan tertulis yang rapi dan mudah dibaca oleh teman-teman sekelas. Laporan ini kemudian dikumpulkan kepada guru untuk dinilai sebagai bagian dari tugas praktik bahasa Indonesia.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">16.</span> <span style="font-weight: normal;"><span>Jodohkan aktivitas akhir di kolom kiri dengan tujuannya di kolom kanan!</span></span></p><table style="width: 95%; border-collapse: collapse; margin-left: 20px; margin-top: 6px;"><tbody><tr><td style="width: 50%; vertical-align: top; padding: 4px 8px;"><p style="margin: 0px 0px 4px; font-weight: bold;">Premis</p><ol style="margin: 0px; padding-left: 20px; list-style-type: decimal;"><li style="margin: 2px 0px;"><span>Mengucapkan terima kasih</span></li><li style="margin: 2px 0px;"><span>Merapikan catatan</span></li><li style="margin: 2px 0px;"><span>Mengumpulkan laporan</span></li></ol></td><td style="width: 50%; vertical-align: top; padding: 4px 8px;"><p style="margin: 0px 0px 4px; font-weight: bold;">Respon</p><ol style="margin: 0px; padding-left: 20px; list-style-type: upper-alpha;"><li style="margin: 2px 0px;"><span>Menghargai kesediaan waktu narasumber</span></li><li style="margin: 2px 0px;"><span>Menyiapkan data untuk laporan tertulis</span></li><li style="margin: 2px 0px;"><span>Menyelesaikan tugas praktik sekolah</span></li></ol></td></tr></tbody></table></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 17</p><p style="text-align: justify; margin: 0px;"><span>Pagi itu, suasana di SD Nusantara terlihat sangat ceria. Siti dan Budi mendapatkan tugas dari guru bahasa Indonesia untuk melakukan wawancara dengan kepala sekolah, Bapak Ahmad. Mereka telah mempersiapkan daftar pertanyaan dengan baik sehari sebelumnya. Siti bertugas membawa buku catatan dan pulpen, sedangkan Budi bertugas mengajukan pertanyaan secara langsung. Topik utama wawancara tersebut adalah pentingnya menjaga kebersihan lingkungan sekolah agar kegiatan belajar menjadi lebih nyaman dan sehat bagi seluruh siswa.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">17.</span> <span style="font-weight: normal;"><span>Siti bertugas membawa buku catatan dan ______ untuk mencatat informasi penting dari narasumber.</span></span></p><div style="margin-left: 20px;"><table role="presentation" width="100%" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 6px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"><tbody><tr><td style="border-width: medium; border-style: none; border-color: currentcolor; border-image: none; width: 75px; padding: 0px 8px 2px 0px; vertical-align: bottom;">Jawaban:</td><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 22px; line-height: 22px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr></tbody></table></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 18</p><p style="text-align: justify; margin: 0px;"><span>Sebelum memulai wawancara, seorang pewawancara yang baik harus memperhatikan etika dan kesopanan. Dewi dan Siti datang menemui Ibu Dewi selaku pustakawan sekolah dengan mengucapkan salam terlebih dahulu. Mereka mengetuk pintu ruangan dan menunggu izin sebelum masuk. Dewi juga memperkenalkan diri dengan ramah dan menyampaikan maksud kedatangan mereka secara jelas. Sikap santun ini sangat penting agar narasumber merasa dihargai dan wawancara dapat berjalan dengan lancar serta menyenangkan.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">18.</span> <span style="font-weight: normal;"><span>Dewi dan Siti menemui Ibu Dewi selaku ______ sekolah untuk melakukan wawancara.</span></span></p><div style="margin-left: 20px;"><table role="presentation" width="100%" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 6px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"><tbody><tr><td style="border-width: medium; border-style: none; border-color: currentcolor; border-image: none; width: 75px; padding: 0px 8px 2px 0px; vertical-align: bottom;">Jawaban:</td><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 22px; line-height: 22px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr></tbody></table></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 19</p><p style="text-align: justify; margin: 0px;"><span>Dalam menyusun daftar pertanyaan wawancara, kita harus menggunakan kalimat tanya yang efektif dan sesuai dengan kaidah bahasa. Kata tanya yang sering digunakan meliputi apa, siapa, di mana, kapan, mengapa, dan bagaimana atau yang sering disingkat menjadi adik simba. Ahmad ingin menggali informasi tentang sejarah berdirinya kantin sehat di sekolah. Oleh karena itu, ia merumuskan pertanyaan menggunakan kata tanya bagaimana proses awal mula pendirian kantin tersebut bersama Ibu Siti selaku pengelola.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">19.</span> <span style="font-weight: normal;"><span>Singkatan untuk kata tanya apa, siapa, di mana, kapan, mengapa, dan bagaimana sering disebut dengan ______.</span></span></p><div style="margin-left: 20px;"><table role="presentation" width="100%" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 6px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"><tbody><tr><td style="border-width: medium; border-style: none; border-color: currentcolor; border-image: none; width: 75px; padding: 0px 8px 2px 0px; vertical-align: bottom;">Jawaban:</td><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 22px; line-height: 22px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr></tbody></table></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 20</p><p style="text-align: justify; margin: 0px;"><span>Setelah proses tanya jawab selesai, rangkaian kegiatan wawancara belum sepenuhnya berakhir. Siti dan Budi mengucapkan terima kasih kepada Bapak Ahmad atas kesediaan waktu dan informasi yang telah diberikan. Keesokan harinya, mereka merapikan catatan hasil wawancara tersebut ke dalam bentuk laporan tertulis yang rapi dan mudah dibaca oleh teman-teman sekelas. Laporan ini kemudian dikumpulkan kepada guru untuk dinilai sebagai bagian dari tugas praktik bahasa Indonesia.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">20.</span> <span style="font-weight: normal;"><span>Catatan hasil wawancara dirapikan ke dalam bentuk ______ tertulis agar mudah dibaca.</span></span></p><div style="margin-left: 20px;"><table role="presentation" width="100%" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 6px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"><tbody><tr><td style="border-width: medium; border-style: none; border-color: currentcolor; border-image: none; width: 75px; padding: 0px 8px 2px 0px; vertical-align: bottom;">Jawaban:</td><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 22px; line-height: 22px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr></tbody></table></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 21 s.d no. 22</p><p style="text-align: justify; margin: 0px;"><span>Pagi itu, suasana di SD Nusantara terlihat sangat ceria. Siti dan Budi mendapatkan tugas dari guru bahasa Indonesia untuk melakukan wawancara dengan kepala sekolah, Bapak Ahmad. Mereka telah mempersiapkan daftar pertanyaan dengan baik sehari sebelumnya. Siti bertugas membawa buku catatan dan pulpen, sedangkan Budi bertugas mengajukan pertanyaan secara langsung. Topik utama wawancara tersebut adalah pentingnya menjaga kebersihan lingkungan sekolah agar kegiatan belajar menjadi lebih nyaman dan sehat bagi seluruh siswa.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">21.</span> <span style="font-weight: normal;"><span>Jelaskan pembagian tugas antara Siti dan Budi dalam persiapan melakukan wawancara dengan kepala sekolah!</span></span></p><div style="margin-left: 20px;"><table role="presentation" width="100%" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 8px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"><tbody><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr></tbody></table></div></div><div style="margin-bottom: 18px;"><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">22.</span> <span style="font-weight: normal;"><span>Apa topik utama yang dibahas dalam kegiatan wawancara antara siswa dan kepala sekolah?</span></span></p><div style="margin-left: 20px;"><table role="presentation" width="100%" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 8px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"><tbody><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr></tbody></table></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 23</p><p style="text-align: justify; margin: 0px;"><span>Sebelum memulai wawancara, seorang pewawancara yang baik harus memperhatikan etika dan kesopanan. Dewi dan Siti datang menemui Ibu Dewi selaku pustakawan sekolah dengan mengucapkan salam terlebih dahulu. Mereka mengetuk pintu ruangan dan menunggu izin sebelum masuk. Dewi juga memperkenalkan diri dengan ramah dan menyampaikan maksud kedatangan mereka secara jelas. Sikap santun ini sangat penting agar narasumber merasa dihargai dan wawancara dapat berjalan dengan lancar serta menyenangkan.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">23.</span> <span style="font-weight: normal;"><span>Uraikan bentuk etika atau kesopanan yang harus ditunjukkan oleh pewawancara saat pertama kali menemui narasumber di ruangan!</span></span></p><div style="margin-left: 20px;"><table role="presentation" width="100%" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 8px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"><tbody><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr></tbody></table></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 24</p><p style="text-align: justify; margin: 0px;"><span>Saat wawancara berlangsung, seorang pewawancara harus aktif mendengarkan jawaban dari narasumber. Budi mencatat poin-poin penting yang disampaikan oleh Bapak Ahmad terkait jadwal kegiatan kerja bakti mingguan. Terkadang, Budi juga mengajukan pertanyaan lanjutan untuk memperjelas informasi yang belum lengkap. Sikap aktif dan antusias ini menunjukkan bahwa pewawancara benar-benar menghargai waktu dan ilmu yang dibagikan oleh narasumber di sekolah.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">24.</span> <span style="font-weight: normal;"><span>Mengapa seorang pewawancara harus aktif mendengarkan jawaban dan mencatat poin penting dari narasumber?</span></span></p><div style="margin-left: 20px;"><table role="presentation" width="100%" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 8px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"><tbody><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr></tbody></table></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 25</p><p style="text-align: justify; margin: 0px;"><span>Setelah proses tanya jawab selesai, rangkaian kegiatan wawancara belum sepenuhnya berakhir. Siti dan Budi mengucapkan terima kasih kepada Bapak Ahmad atas kesediaan waktu dan informasi yang telah diberikan. Keesokan harinya, mereka merapikan catatan hasil wawancara tersebut ke dalam bentuk laporan tertulis yang rapi dan mudah dibaca oleh teman-teman sekelas. Laporan ini kemudian dikumpulkan kepada guru untuk dinilai sebagai bagian dari tugas praktik bahasa Indonesia.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">25.</span> <span style="font-weight: normal;"><span>Tuliskan langkah-langkah yang harus dilakukan oleh siswa setelah proses tanya jawab dalam wawancara selesai!</span></span></p><div style="margin-left: 20px;"><table role="presentation" width="100%" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 8px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"><tbody><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr></tbody></table></div></div></div><div style=""></div><div data-subsection="soal-kisi" style="margin-top: 24px;"><h2 style="font-weight: bold; font-size: 12pt; text-align: center; margin-bottom: 12px;">KISI-KISI / ANALISIS BUTIR SOAL</h2><table style="width: 100%; border-collapse: collapse; border: 1px solid rgb(0, 0, 0); margin-bottom: 16px;"><thead><tr><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 6%;">No</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left; width: 22%;">Tipe Soal</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left; width: 14%;">Level Kognitif</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left;">Indikator Soal</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 8%;">Skor</th></tr></thead><tbody><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">1</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Pilihan Ganda</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C2 Memahami</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Mengidentifikasi tugas Budi dalam kegiatan wawancara</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">2</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Pilihan Ganda</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C3 Menerapkan</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menentukan sikap awal saat bertamu ke ruang narasumber</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">3</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Pilihan Ganda</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C4 Menganalisis</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menentukan jenis informasi tentang kantin sehat</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">4</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Pilihan Ganda</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C5 Mengevaluasi</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menilai aktivitas Budi saat mendengarkan narasumber</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Pilihan Ganda</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C6 Mencipta</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menentukan tujuan pengumpulan laporan hasil wawancara</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">6</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">PG Kategori Benar/Salah</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C4 Menganalisis</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menganalisis pernyataan benar atau salah tentang persiapan wawancara</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">7</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">PG Kategori Benar/Salah</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C4 Menganalisis</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menganalisis etika sopan santun saat menemui narasumber</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">8</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">PG Kategori Benar/Salah</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C5 Mengevaluasi</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menganalisis fungsi pertanyaan dan kata tanya dalam wawancara</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">9</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">PG Kategori Benar/Salah</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C6 Mencipta</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menganalisis aktivitas akhir dan pelaporan hasil wawancara</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">PG Multiple Choice Multiple Answer</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C4 Menganalisis</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Memilih beberapa karakteristik tokoh sekolah yang dapat diwawancarai</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">11</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">PG Multiple Choice Multiple Answer</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C5 Mengevaluasi</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Memilih aktivitas penting yang dilakukan saat pelaksanaan wawancara</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">12</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">PG Multiple Choice Multiple Answer</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C6 Mencipta</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Memilih manfaat dari kegiatan wawancara bagi siswa di sekolah</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">13</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menjodohkan</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C2 Memahami</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menjodohkan peran tokoh dalam kegiatan wawancara di sekolah</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">14</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menjodohkan</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C3 Menerapkan</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menjodohkan etika wawancara dengan bentuk penerapannya</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">15</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menjodohkan</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C4 Menganalisis</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menjodohkan fungsi kata tanya dengan informasi yang ingin digali</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">16</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menjodohkan</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C5 Mengevaluasi</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menjodohkan tahapan akhir wawancara dengan kegiatannya</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">17</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Isian Singkat</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C1 Mengingat</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Melengkapi kalimat rumpang tentang alat tulis yang dibawa Siti</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">18</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Isian Singkat</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C2 Memahami</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Melengkapi kalimat rumpang tentang narasumber di perpustakaan</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">19</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Isian Singkat</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C3 Menerapkan</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Melengkapi singkatan kata tanya dalam menyusun daftar pertanyaan</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">20</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Isian Singkat</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C4 Menganalisis</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Melengkapi kalimat rumpang tentang bentuk akhir hasil wawancara</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">21</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Uraian</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C2 Memahami</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menjelaskan tugas masing-masing anggota kelompok dalam persiapan wawancara</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">22</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Uraian</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C3 Menerapkan</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menentukan topik utama yang dibahas dalam wawancara</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">23</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Uraian</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C4 Menganalisis</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menganalisis bentuk etika awal saat menemui narasumber</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">24</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Uraian</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C5 Mengevaluasi</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Menilai pentingnya sikap aktif mendengarkan saat wawancara</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">25</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Uraian</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">C6 Mencipta</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;">Merancang langkah akhir setelah wawancara selesai dilaksanakan</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr></tbody></table></div><div data-subsection="soal-guru" style="margin-top: 24px;"><h2 style="font-weight: bold; font-size: 12pt; text-align: center; margin-bottom: 12px;">KUNCI JAWABAN DAN PEMBAHASAN</h2><p style="font-size: 10pt; color: rgb(75, 85, 99); margin: 0px 0px 12px; text-align: center;">(Dokumen ini adalah pegangan guru, tidak untuk dibagikan kepada siswa)</p><div style="margin-bottom: 18px;"><h3 style="font-weight: bold; margin: 0px 0px 6px;">Pilihan Ganda</h3><table style="width: 100%; border-collapse: collapse; border: 1px solid rgb(0, 0, 0); margin-bottom: 16px;"><thead><tr><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 10%;">No</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 20%;">Kunci</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left;">Pembahasan</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 10%;">Skor</th></tr></thead><tbody><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">1</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center; font-weight: bold;">B</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Jawaban B benar karena dalam teks pertama disebutkan Budi bertugas mengajukan pertanyaan secara langsung.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">2</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center; font-weight: bold;">A</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Jawaban A benar karena mereka mengetuk pintu dan menunggu izin sebelum masuk.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">3</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center; font-weight: bold;">A</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Jawaban A benar karena Ahmad ingin menggali informasi tentang sejarah berdirinya kantin sehat.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">4</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center; font-weight: bold;">A</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Jawaban A benar karena Budi mencatat poin-poin penting yang disampaikan narasumber.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center; font-weight: bold;">A</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Jawaban A benar karena laporan dikumpulkan kepada guru untuk dinilai sebagai tugas praktik.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td></tr></tbody></table></div><div style="margin-bottom: 18px;"><h3 style="font-weight: bold; margin: 0px 0px 6px;">Pilihan Ganda Kompleks / Benar-Salah</h3><table style="width: 100%; border-collapse: collapse; border: 1px solid rgb(0, 0, 0); margin-bottom: 16px;"><thead><tr><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 8%;">No</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left; width: 32%;">Kunci / Pernyataan Benar</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left;">Pembahasan Singkat</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 8%;">Skor</th></tr></thead><tbody><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">6</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><ol style="margin: 0px; padding-left: 20px;"><li style="margin: 2px 0px;"><span>Siti dan Budi mendapatkan tugas dari guru bahasa Indonesia</span> — <strong>Benar</strong></li><li style="margin: 2px 0px;"><span>Bapak Ahmad bertindak sebagai siswa kelas empat</span> — <strong>Salah</strong></li><li style="margin: 2px 0px;"><span>Topik wawancara berkaitan dengan kebersihan lingkungan sekolah</span> — <strong>Benar</strong></li></ol></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Pernyataan 1 benar sesuai teks, pernyataan 2 salah karena Bapak Ahmad adalah kepala sekolah, pernyataan 3 benar mengenai kebersihan lingkungan.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">7</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><ol style="margin: 0px; padding-left: 20px;"><li style="margin: 2px 0px;"><span>Dewi dan Siti menemui pustakawan tanpa mengucapkan salam</span> — <strong>Salah</strong></li><li style="margin: 2px 0px;"><span>Pewawancara yang baik harus bersikap santun dan ramah</span> — <strong>Benar</strong></li><li style="margin: 2px 0px;"><span>Tujuan kedatangan harus disampaikan secara jelas</span> — <strong>Benar</strong></li></ol></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Pernyataan 1 salah karena mereka mengucapkan salam, pernyataan 2 dan 3 benar sesuai etika dalam teks.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">8</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><ol style="margin: 0px; padding-left: 20px;"><li style="margin: 2px 0px;"><span>Kata tanya adik simba mencakup apa, siapa, dan bagaimana</span> — <strong>Benar</strong></li><li style="margin: 2px 0px;"><span>Ahmad menanyakan tentang sejarah berdirinya kantin sehat</span> — <strong>Benar</strong></li><li style="margin: 2px 0px;"><span>Pewawancara boleh menggunakan kalimat yang tidak sopan</span> — <strong>Salah</strong></li></ol></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Pernyataan 1 dan 2 benar sesuai teks, pernyataan 3 salah karena pewawancara wajib menjaga kesopanan.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">9</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><ol style="margin: 0px; padding-left: 20px;"><li style="margin: 2px 0px;"><span>Siti dan Budi mengucapkan terima kasih kepada narasumber</span> — <strong>Benar</strong></li><li style="margin: 2px 0px;"><span>Hasil wawancara dibiarkan berserakan tanpa dirapikan</span> — <strong>Salah</strong></li><li style="margin: 2px 0px;"><span>Laporan tertulis dikumpulkan kepada guru bahasa Indonesia</span> — <strong>Benar</strong></li></ol></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Pernyataan 1 dan 3 benar sesuai teks penutup, pernyataan 2 salah karena catatan dirapikan menjadi laporan rapi.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><ul style="margin: 0px; padding-left: 20px;"><li style="margin: 2px 0px;">1</li><li style="margin: 2px 0px;">2</li><li style="margin: 2px 0px;">4</li></ul></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Jawaban 1, 2, dan 4 benar karena mereka adalah tokoh penting di lingkungan sekolah yang disebutkan dalam teks.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">11</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><ul style="margin: 0px; padding-left: 20px;"><li style="margin: 2px 0px;">1</li><li style="margin: 2px 0px;">2</li><li style="margin: 2px 0px;">4</li></ul></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Jawaban 1, 2, dan 4 benar karena mencerminkan sikap aktif dan efektif saat wawancara berlangsung.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">12</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><ul style="margin: 0px; padding-left: 20px;"><li style="margin: 2px 0px;">1</li><li style="margin: 2px 0px;">2</li><li style="margin: 2px 0px;">4</li></ul></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Jawaban 1, 2, dan 4 benar karena wawancara melatih keterampilan sosial dan memperluas wawasan dari narasumber tepercaya.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr></tbody></table></div><div style="margin-bottom: 18px;"><h3 style="font-weight: bold; margin: 0px 0px 6px;">Menjodohkan</h3><table style="width: 100%; border-collapse: collapse; border: 1px solid rgb(0, 0, 0); margin-bottom: 16px;"><thead><tr><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 8%;">No</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left;">Pasangan yang Benar</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 10%;">Skor</th></tr></thead><tbody><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">13</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><ol style="margin: 0px; padding-left: 20px;"><li style="margin: 2px 0px;"><span>Siti</span> <strong>→</strong> <span>Mengajukan pertanyaan wawancara</span></li><li style="margin: 2px 0px;"><span>Budi</span> <strong>→</strong> <span>Membawa buku catatan dan pulpen</span></li><li style="margin: 2px 0px;"><span>Bapak Ahmad</span> <strong>→</strong> <span>Menjadi narasumber kepala sekolah</span></li></ol></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">14</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><ol style="margin: 0px; padding-left: 20px;"><li style="margin: 2px 0px;"><span>Mengucapkan salam</span> <strong>→</strong> <span>Menyapa narasumber dengan sopan saat masuk</span></li><li style="margin: 2px 0px;"><span>Mengetuk pintu</span> <strong>→</strong> <span>Meminta izin sebelum memasuki ruangan</span></li><li style="margin: 2px 0px;"><span>Memperkenalkan diri</span> <strong>→</strong> <span>Menyampaikan nama dan maksud kedatangan</span></li></ol></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">15</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><ol style="margin: 0px; padding-left: 20px;"><li style="margin: 2px 0px;"><span>Bagaimana</span> <strong>→</strong> <span>Proses awal mula pendirian kantin</span></li><li style="margin: 2px 0px;"><span>Siapa</span> <strong>→</strong> <span>Pengelola kantin sekolah</span></li><li style="margin: 2px 0px;"><span>Apa</span> <strong>→</strong> <span>Topik atau informasi umum</span></li></ol></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">16</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><ol style="margin: 0px; padding-left: 20px;"><li style="margin: 2px 0px;"><span>Mengucapkan terima kasih</span> <strong>→</strong> <span>Menghargai kesediaan waktu narasumber</span></li><li style="margin: 2px 0px;"><span>Merapikan catatan</span> <strong>→</strong> <span>Menyiapkan data untuk laporan tertulis</span></li><li style="margin: 2px 0px;"><span>Mengumpulkan laporan</span> <strong>→</strong> <span>Menyelesaikan tugas praktik sekolah</span></li></ol></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">10</td></tr></tbody></table></div><div style="margin-bottom: 18px;"><h3 style="font-weight: bold; margin: 0px 0px 6px;">Isian Singkat</h3><table style="width: 100%; border-collapse: collapse; border: 1px solid rgb(0, 0, 0); margin-bottom: 16px;"><thead><tr><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 8%;">No</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left; width: 30%;">Jawaban yang Diterima</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left;">Pembahasan Singkat</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 8%;">Skor</th></tr></thead><tbody><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">17</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span style="font-weight: bold;"><span>pulpen</span></span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Berdasarkan teks pertama, Siti bertugas membawa buku catatan dan pulpen.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">18</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span style="font-weight: bold;"><span>pustakawan</span></span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Teks kedua menyebutkan bahwa Dewi dan Siti menemui Ibu Dewi selaku pustakawan sekolah.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">19</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span style="font-weight: bold;"><span>adik simba</span></span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Dalam teks ketiga dijelaskan bahwa singkatan kata tanya tersebut adalah adik simba.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">20</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span style="font-weight: bold;"><span>laporan</span></span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Teks kelima menyatakan bahwa catatan dirapikan ke dalam bentuk laporan tertulis.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">5</td></tr></tbody></table></div><div style="margin-bottom: 16px;"><h3 style="font-weight: bold; margin: 0px 0px 8px;">Uraian</h3><div style="margin-bottom: 10px; border: 1px solid rgb(0, 0, 0); padding: 10px 12px;"><p style="margin: 0px 0px 6px; font-weight: bold;">Nomor 21</p><p style="margin: 4px 0px 2px; font-weight: bold;">Jawaban ideal:</p><div style="margin: 0px 0px 6px; white-space: pre-wrap;"><span>Siti bertugas membawa buku catatan dan pulpen untuk mencatat informasi, sedangkan Budi bertugas mengajukan pertanyaan secara langsung kepada narasumber.</span></div><p style="margin: 4px 0px 2px; font-weight: bold;">Pembahasan:</p><div style="margin: 0px 0px 6px;"><span>Dalam teks disebutkan bahwa Siti bertugas membawa buku catatan dan pulpen, sedangkan Budi bertugas mengajukan pertanyaan secara langsung kepada kepala sekolah.</span></div><p style="margin: 4px 0px 0px;"><span style="font-weight: bold;">Skor maksimal:</span> 10</p></div><div style="margin-bottom: 10px; border: 1px solid rgb(0, 0, 0); padding: 10px 12px;"><p style="margin: 0px 0px 6px; font-weight: bold;">Nomor 22</p><p style="margin: 4px 0px 2px; font-weight: bold;">Jawaban ideal:</p><div style="margin: 0px 0px 6px; white-space: pre-wrap;"><span>Topik utama wawancara tersebut adalah pentingnya menjaga kebersihan lingkungan sekolah agar kegiatan belajar menjadi lebih nyaman dan sehat.</span></div><p style="margin: 4px 0px 2px; font-weight: bold;">Pembahasan:</p><div style="margin: 0px 0px 6px;"><span>Berdasarkan teks pertama, topik utama wawancara difokuskan pada pentingnya menjaga kebersihan lingkungan sekolah demi kenyamanan siswa.</span></div><p style="margin: 4px 0px 0px;"><span style="font-weight: bold;">Skor maksimal:</span> 10</p></div><div style="margin-bottom: 10px; border: 1px solid rgb(0, 0, 0); padding: 10px 12px;"><p style="margin: 0px 0px 6px; font-weight: bold;">Nomor 23</p><p style="margin: 4px 0px 2px; font-weight: bold;">Jawaban ideal:</p><div style="margin: 0px 0px 6px; white-space: pre-wrap;"><span>Pewawancara harus mengucapkan salam, mengetuk pintu ruangan, menunggu izin sebelum masuk, serta memperkenalkan diri dengan ramah dan menyampaikan maksud kedatangan.</span></div><p style="margin: 4px 0px 2px; font-weight: bold;">Pembahasan:</p><div style="margin: 0px 0px 6px;"><span>Teks kedua menjelaskan bahwa etika awal meliputi mengucapkan salam, mengetuk pintu, menunggu izin, memperkenalkan diri, dan menyampaikan maksud dengan ramah.</span></div><p style="margin: 4px 0px 0px;"><span style="font-weight: bold;">Skor maksimal:</span> 10</p></div><div style="margin-bottom: 10px; border: 1px solid rgb(0, 0, 0); padding: 10px 12px;"><p style="margin: 0px 0px 6px; font-weight: bold;">Nomor 24</p><p style="margin: 4px 0px 2px; font-weight: bold;">Jawaban ideal:</p><div style="margin: 0px 0px 6px; white-space: pre-wrap;"><span>Pewawancara harus aktif mendengarkan agar tidak kehilangan informasi penting, dapat mengajukan pertanyaan lanjutan, serta menunjukkan penghargaan terhadap waktu narasumber.</span></div><p style="margin: 4px 0px 2px; font-weight: bold;">Pembahasan:</p><div style="margin: 0px 0px 6px;"><span>Mendengarkan secara aktif membantu pencatatan poin penting seperti jadwal kegiatan dan memungkinkan pengajuan pertanyaan lanjutan yang relevan.</span></div><p style="margin: 4px 0px 0px;"><span style="font-weight: bold;">Skor maksimal:</span> 10</p></div><div style="margin-bottom: 10px; border: 1px solid rgb(0, 0, 0); padding: 10px 12px;"><p style="margin: 0px 0px 6px; font-weight: bold;">Nomor 25</p><p style="margin: 4px 0px 2px; font-weight: bold;">Jawaban ideal:</p><div style="margin: 0px 0px 6px; white-space: pre-wrap;"><span>Langkah akhirnya adalah mengucapkan terima kasih kepada narasumber, merapikan catatan hasil wawancara, menyusunnya menjadi laporan tertulis, dan mengumpulkannya kepada guru.</span></div><p style="margin: 4px 0px 2px; font-weight: bold;">Pembahasan:</p><div style="margin: 0px 0px 6px;"><span>Teks kelima menunjukkan tahapan akhir yaitu mengucapkan terima kasih, merapikan catatan menjadi laporan tertulis, dan menyerahkannya kepada guru.</span></div><p style="margin: 4px 0px 0px;"><span style="font-weight: bold;">Skor maksimal:</span> 10</p></div></div></div><div style="margin-top: 20px; padding: 12px; border: 1px solid rgb(0, 0, 0); margin-bottom: 18px;"><h3 style="font-weight: bold; margin: 0px 0px 8px;">Pedoman Penilaian</h3><p style="margin: 2px 0px;"><span style="font-weight: bold;">Skor Maksimal:</span> 200</p><p style="margin: 2px 0px;"><span style="font-weight: bold;">Rumus Nilai:</span> (Skor Perolehan / Skor Maksimal) x 100</p></div></div></div></div><div data-v2-export-item="d89ffb36-3eb1-4f40-ae43-f9708d7ae418:materi" data-v2-export-jenis="materi" data-v2-export-pertemuan="31" class="page-break-before" style="break-before: page;"><div data-v2-export-marker="true" style="font-size: 10pt; font-weight: 700; margin-bottom: 8px;">Pertemuan 31 — Materi</div><div class="document-preview bg-white mx-auto p-6 md:p-12 text-black" style="width: 100%; max-width: 210mm;"><div data-section="modul" style="display: none;"><div style="text-align: center; margin-bottom: 20px; border-bottom: 3px solid black; padding-bottom: 10px;"><h1 style="font-size: 16pt; font-weight: bold; margin: 0px; text-transform: uppercase;">MODUL AJAR: BAHASA INDONESIA</h1><p class="italic">Materi: Materi - Kelas Kelas</p></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">I. IDENTIFIKASI DASAR</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Identitas Umum</td><td style="border: 1px solid black; padding: 6px; vertical-align: top;"><div><strong>Nama Penyusun:</strong> Guru</div><div><strong>Sekolah:</strong> Sekolah</div><div><strong>Mata Pelajaran:</strong> Bahasa Indonesia</div><div><strong>Materi:</strong> Materi </div><div><strong>Kelas/Fase:</strong> Kelas / Fase</div><div><strong>Semester:</strong> 1</div><div><strong>Jumlah Pertemuan:</strong> 32 (0 Menit)</div></td></tr><tr style="background-color: rgb(219, 234, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">II. IDENTIFIKASI MURID</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Pengetahuan Awal</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Minat</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Latar Belakang</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Kebutuhan Belajar</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(209, 250, 229);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">III. JENIS PENGETAHUAN MATERI</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Faktual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Konseptual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Prosedural</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metakognitif</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Kaitan dengan Kehidupan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(254, 243, 199);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IV. INTEGRASI NILAI &amp; KARAKTER</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Nilai Karakter</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(224, 231, 255);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">V. DIMENSI PROFIL LULUSAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">DPL yang Dikembangkan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr></tbody></table><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VI. DESAIN PEMBELAJARAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Capaian Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Tujuan Pembelajaran</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Pemahaman Bermakna</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Model Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metode Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(240, 253, 244);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VII. LINTAS DISIPLIN ILMU</td></tr><tr style="background-color: rgb(252, 231, 243);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VIII. KEMITRAAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(207, 250, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IX. LINGKUNGAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(237, 233, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">X. PEMANFAATAN DIGITAL</td></tr></tbody></table><div style="margin-bottom: 30px;"><div style="background-color: rgb(226, 232, 240); padding: 8px; font-weight: bold; margin-bottom: 16px; border: 1px solid black;">XI. PENGALAMAN BELAJAR (LANGKAH PEMBELAJARAN)</div><div style="padding: 20px; text-align: center; color: rgb(107, 114, 128); border: 1px solid black;">Langkah pembelajaran akan muncul setelah generate modul</div></div><table style="width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin-top: 50px;"><tbody><tr><td style="width: 50%; text-align: center; vertical-align: top;">Mengetahui,<br>Kepala Sekolah<br><br><br><br><strong>...........................</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td><td style="width: 50%; text-align: center; vertical-align: top;">Guru Mata Pelajaran<br><br><br><br><br><strong>Guru</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td></tr></tbody></table></div><div data-section="materi" style="display: block; margin-top: 40px;"><div style=""></div><h2 style="text-align: center; font-weight: bold; font-size: 18pt; color: rgb(204, 85, 38); text-transform: uppercase; margin-bottom: 24px;">📚 Petualangan Seru Menjadi Wartawan Cilik: Wawancara Tokoh Sekolah! 🎤🌟</h2><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><h3 style="font-weight: bold; font-size: 14pt; margin-bottom: 8px;">📖 Pendahuluan</h3><p style="text-align: left; line-height: 1.8; margin-bottom: 24px;"><span>Halo adik-adik kelas 4 yang hebat dan penuh semangat! 🤩 Hari ini kita akan memulai petualangan baru yang sangat seru dan keren banget, yaitu menjadi seorang wartawan cilik yang handal! 📝✨ Apakah kalian pernah melihat reporter berita di televisi yang asyik bertanya kepada narasumber? Nah, sekarang giliran kalian untuk mencobanya sendiri di lingkungan sekolah kita tercinta! Materi ini sangat penting dipelajari karena dapat melatih rasa percaya diri kita, cara berbicara yang sopan, serta bagaimana cara mendengarkan informasi penting dari orang lain. 💡 Di kehidupan sehari-hari, keterampilan ini akan membantu kalian saat mengobrol dengan guru, kepala sekolah, penjaga kantin, atau bahkan saat kalian ingin tahu rahasia di balik tanaman subur di kebun sekolah. 🌿 Ayo, kita siapkan buku catatan dan alat tulis kita untuk berpetualang mencari berita bersama-sama! 🚀🎉</span></p></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="border: 1px solid rgb(229, 231, 235); border-radius: 8px; padding: 16px; margin-bottom: 20px;"><div style="margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid rgb(204, 85, 38); display: flex;"><span style="display: inline-block; background-color: rgb(204, 85, 38); color: white; width: 24px; height: 24px; border-radius: 4px; text-align: center; line-height: 24px; font-size: 12px; font-weight: bold; margin-right: 8px;">1</span><span style="color: rgb(204, 85, 38); font-weight: bold; font-size: 13pt;">1. Apa Itu Wawancara dan Siapa Tokoh di Sekolah? 🏫🔍</span></div><div style="border-left: 4px solid rgb(204, 85, 38); background-color: rgb(255, 247, 237); padding: 12px 14px; margin-bottom: 12px; border-radius: 0px 6px 6px 0px;"><span style="font-weight: 600; font-size: 11pt;">🎯 <span>Wawancara adalah kegiatan tanya jawab untuk mencari informasi penting dari seorang narasumber. 🎯</span></span></div><div style="text-align: left; line-height: 1.8; margin-bottom: 12px;">Halo petualang cilik! 🌟 Tahukah kalian apa itu wawancara? Wawancara itu mirip seperti saat kita mengobrol dengan teman, tetapi tujuannya adalah untuk mencari tahu suatu informasi atau rahasia menarik dari seseorang yang kita sebut sebagai narasumber. 🕵️‍♂️ Di sekolah kita, ada banyak sekali loh tokoh hebat yang bisa kita ajak ngobrol! Mulai dari Bapak/Ibu Guru yang sabar mengajar di kelas, Bapak Kepala Sekolah yang memimpin sekolah kita, Ibu Pustakawan yang menjaga sejuta buku cerita, sampai Pak Kebun yang merawat tanaman bunga agar tetap cantik. 🌻 Mengapa kita harus mewawancarai mereka? Karena mereka punya banyak cerita seru dan pengalaman hebat yang belum kita ketahui! Melalui petualangan wawancara ini, kita belajar untuk berani bertanya dengan sopan dan mendengarkan jawaban dengan seksama. 👂💬</div><div style="background-color: rgb(243, 244, 246); padding: 12px 14px; margin-bottom: 8px; border-radius: 6px;"><div style="font-weight: 600; margin-bottom: 6px;">📝 Bedah Contoh:</div><div style="line-height: 1.7;">Bayangkan kalian ingin tahu kenapa kantin sekolah selalu punya es teh manis yang paling enak di dunia! 🧋 Nah, kalian bisa menjadikan Bibi Penjaga Kantin sebagai narasumber. Contoh pertanyaannya: <ul><li>'Halo Bibi, sejak kapan Bibi mulai berjualan di sekolah ini?'</li><li>'Apa resep membuat es teh manis yang rasanya sangat segar?'</li></ul></div></div><div style="margin-top: 8px;"><span style="display: inline-block; background-color: rgb(254, 252, 232); padding: 4px 10px; border-radius: 12px; font-size: 10pt; font-weight: 600;">🔑 Narasumber</span></div><div style="clear: both;"></div></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="border: 1px solid rgb(229, 231, 235); border-radius: 8px; padding: 16px; margin-bottom: 20px;"><div style="margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid rgb(204, 85, 38); display: flex;"><span style="display: inline-block; background-color: rgb(204, 85, 38); color: white; width: 24px; height: 24px; border-radius: 4px; text-align: center; line-height: 24px; font-size: 12px; font-weight: bold; margin-right: 8px;">2</span><span style="color: rgb(204, 85, 38); font-weight: bold; font-size: 13pt;">2. Menyiapkan Daftar Pertanyaan Hebat (5W+1H) 📋✍️</span></div><div style="border-left: 4px solid rgb(204, 85, 38); background-color: rgb(255, 247, 237); padding: 12px 14px; margin-bottom: 12px; border-radius: 0px 6px 6px 0px;"><span style="font-weight: 600; font-size: 11pt;">🎯 <span>Pertanyaan hebat dibuat menggunakan kata tanya Apa, Siapa, Di mana, Kapan, Mengapa, dan Bagaimana. 💡</span></span></div><div style="text-align: left; line-height: 1.8; margin-bottom: 12px;">Sebelum kita berangkat menemui narasumber, seorang wartawan cilik yang profesional harus menyiapkan amunisi terlebih dahulu! 🎒 Amunisi kita bukanlah batu atau kelereng, melainkan daftar pertanyaan yang keren dan tersusun rapi. Ingat rumus ajaib wartawan, yaitu 5W+1H atau dalam bahasa kita disebut 'Adik Simbah' (Apa, Di mana, Kapan, Siapa, Mengapa, Bagaimana). 🪄 Dengan menggunakan kata tanya ini, kita tidak akan kehabisan bahan obrolan! Misalnya, kita bisa bertanya tentang kegiatan sehari-hari narasumber, hobi mereka, atau pesan-pesan bijak untuk kita sebagai murid. Menulis pertanyaan di buku catatan sebelum wawancara sangat penting agar saat berhadapan langsung dengan narasumber, kita tidak merasa gugup atau lupa mau tanya apa. 📝 Yuk, kita buat daftar pertanyaan terbaik kita sekarang!</div><div style="background-color: rgb(243, 244, 246); padding: 12px 14px; margin-bottom: 8px; border-radius: 6px;"><div style="font-weight: 600; margin-bottom: 6px;">📝 Bedah Contoh:</div><div style="line-height: 1.7;">Misalnya kalian ingin mewawancarai Ibu Guru Pustakawan di perpustakaan sekolah 📚: <ul><li><b>Apa</b> buku cerita yang paling banyak dipinjam anak-anak?</li><li><b>Siapa</b> penulis buku cerita favorit di perpustakaan ini?</li><li><b>Bagaimana</b> cara merawat buku agar tidak mudah rusak?</li></ul></div></div><div style="margin-top: 8px;"><span style="display: inline-block; background-color: rgb(254, 252, 232); padding: 4px 10px; border-radius: 12px; font-size: 10pt; font-weight: 600;">🔑 Daftar Pertanyaan</span></div><div style="clear: both;"></div></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="border: 1px solid rgb(229, 231, 235); border-radius: 8px; padding: 16px; margin-bottom: 20px;"><div style="margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid rgb(204, 85, 38); display: flex;"><span style="display: inline-block; background-color: rgb(204, 85, 38); color: white; width: 24px; height: 24px; border-radius: 4px; text-align: center; line-height: 24px; font-size: 12px; font-weight: bold; margin-right: 8px;">3</span><span style="color: rgb(204, 85, 38); font-weight: bold; font-size: 13pt;">3. Model Teks: Percakapan Seru dengan Pak Guru Penjas ⚽🗣️</span></div><div style="border-left: 4px solid rgb(204, 85, 38); background-color: rgb(255, 247, 237); padding: 12px 14px; margin-bottom: 12px; border-radius: 0px 6px 6px 0px;"><span style="font-weight: 600; font-size: 11pt;">🎯 <span>Mari kita baca contoh teks percakapan wawancara berikut untuk memahami cara bertanya dan menjawab yang baik. 📖</span></span></div><div style="text-align: left; line-height: 1.8; margin-bottom: 12px;">Budi (Wartawan Cilik): 'Selamat pagi, Pak Joko! Bolehkan Budi bertanya sedikit tentang kegiatan olahraga di sekolah kita? ⚽' <br><br>Pak Joko (Guru Penjas): 'Selamat pagi juga, Budi! Tentu saja boleh. Silakan duduk, apa yang ingin kamu ketahui?' <br><br>Budi: 'Begini Pak, mengapa pelajaran olahraga sangat penting untuk kesehatan tubuh kita? 🤔' <br><br>Pak Joko: 'Pertanyaan yang bagus sekali, Budi! Olahraga itu penting agar otot-otot tubuh kita tidak kaku, jantung kita sehat, dan pikiran kita menjadi lebih segar setelah seharian belajar di kelas. 🏃‍♂️✨' <br><br>Budi: 'Wah, begitu ya, Pak! Lalu, permainan apa yang paling disukai oleh anak-anak kelas 4 saat jam olahraga? 🏀' <br><br>Pak Joko: 'Biasanya anak-anak sangat suka bermain sepak bola di lapangan rumput dan permainan bola basket di halaman sekolah. Selain seru, permainan itu melatih kerja sama tim! 🤝' <br><br>Budi: 'Terima kasih banyak atas informasinya, Pak Joko! Penjelasan Bapak sangat membantu tugas laporan saya. 🌟' <br><br>Pak Joko: 'Sama-sama, Budi! Semangat terus ya belajarnya!'</div><div style="background-color: rgb(243, 244, 246); padding: 12px 14px; margin-bottom: 8px; border-radius: 6px;"><div style="font-weight: 600; margin-bottom: 6px;">🔍 Analisis Struktur:</div><div style="line-height: 1.7;">Mari kita bedah struktur teks wawancara di atas bersama-sama! 🔍 <ul><li><b>Bagian Pembuka (Salam &amp; Sapaan):</b> 'Selamat pagi, Pak Joko! Bolehkan Budi bertanya sedikit...' menunjukkan sikap sopan santun sebelum memulai wawancara. 👋</li><li><b>Bagian Inti (Tanya Jawab):</b> Pertanyaan Budi tentang 'mengapa pelajaran olahraga penting' dan 'permainan apa yang disukai' adalah contoh penggunaan kata tanya untuk menggali informasi penting. 🎯</li><li><b>Bagian Penutup (Ucapan Terima Kasih):</b> 'Terima kasih banyak atas informasinya, Pak Joko!' adalah tanda hormat dan apresiasi kepada narasumber setelah selesai berbicara. 🙏</li></ul></div></div><div style="margin-top: 8px;"><span style="display: inline-block; background-color: rgb(254, 252, 232); padding: 4px 10px; border-radius: 12px; font-size: 10pt; font-weight: 600;">🔑 Teks Wawancara</span></div><div style="clear: both;"></div></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="border: 1px solid rgb(229, 231, 235); border-radius: 8px; padding: 16px; margin-bottom: 20px;"><div style="margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid rgb(204, 85, 38); display: flex;"><span style="display: inline-block; background-color: rgb(204, 85, 38); color: white; width: 24px; height: 24px; border-radius: 4px; text-align: center; line-height: 24px; font-size: 12px; font-weight: bold; margin-right: 8px;">4</span><span style="color: rgb(204, 85, 38); font-weight: bold; font-size: 13pt;">4. Sikap Sopan dan Cara Berbicara Saat Wawancara 😊🎤</span></div><div style="border-left: 4px solid rgb(204, 85, 38); background-color: rgb(255, 247, 237); padding: 12px 14px; margin-bottom: 12px; border-radius: 0px 6px 6px 0px;"><span style="font-weight: 600; font-size: 11pt;">🎯 <span>Sikap yang sopan, senyuman ramah, dan suara yang jelas adalah kunci sukses seorang wartawan cilik. ⭐</span></span></div><div style="text-align: left; line-height: 1.8; margin-bottom: 12px;">Adik-adik, hebat saja dalam merangkai pertanyaan belum cukup untuk membuat wawancara kita sukses besar! 🏆 Kita juga harus memperhatikan sikap tubuh dan cara kita berbicara kepada narasumber yang usianya lebih dewasa. Saat bertemu, jangan lupa mengetuk pintu (jika di dalam ruangan), mengucapkan salam dengan ceria, dan tersenyum manis 😊. Saat berbicara, gunakan nada suara yang ramah, tidak terlalu berteriak, dan ucapkan kata 'tolong' jika meminta bantuan serta 'terima kasih' sesudahnya. 🤝 Selain itu, ketika narasumber sedang berbicara menjelaskan sesuatu, kita harus mendengarkannya dengan penuh perhatian tanpa memotong pembicaraan mereka di tengah jalan. 👀 Catat poin-poin penting jawabannya di buku tulis dengan rapi agar tidak lupa!</div><div style="background-color: rgb(243, 244, 246); padding: 12px 14px; margin-bottom: 8px; border-radius: 6px;"><div style="font-weight: 600; margin-bottom: 6px;">📝 Bedah Contoh:</div><div style="line-height: 1.7;">Bayangkan kalian sedang berbicara dengan Ibu Kepala Sekolah di ruangannya 🏫: <ul><li>Jangan memotong pembicaraan saat Ibu Kepala Sekolah sedang menjelaskan prestasi sekolah. 🤫</li><li>Tatap matanya dengan ramah dan sesekali mengangguk tanda kalian mengerti. 🧒👧</li><li>Gunakan bahasa Indonesia yang baik dan santun, tidak menggunakan bahasa sehari-hari yang terlalu bebas. 🇮🇩</li></ul></div></div><div style="margin-top: 8px;"><span style="display: inline-block; background-color: rgb(254, 252, 232); padding: 4px 10px; border-radius: 12px; font-size: 10pt; font-weight: 600;">🔑 Sikap Santun</span></div><div style="clear: both;"></div></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="border: 1px solid rgb(229, 231, 235); border-radius: 8px; padding: 16px; margin-bottom: 20px;"><div style="margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid rgb(204, 85, 38); display: flex;"><span style="display: inline-block; background-color: rgb(204, 85, 38); color: white; width: 24px; height: 24px; border-radius: 4px; text-align: center; line-height: 24px; font-size: 12px; font-weight: bold; margin-right: 8px;">5</span><span style="color: rgb(204, 85, 38); font-weight: bold; font-size: 13pt;">5. Mempraktikkan Wawancara dan Menyajikan Hasilnya 🎉📝</span></div><div style="border-left: 4px solid rgb(204, 85, 38); background-color: rgb(255, 247, 237); padding: 12px 14px; margin-bottom: 12px; border-radius: 0px 6px 6px 0px;"><span style="font-weight: 600; font-size: 11pt;">🎯 <span>Setelah wawancara selesai, saatnya kita menyusun catatan informasi menjadi laporan yang menarik untuk dibagikan. 📢</span></span></div><div style="text-align: left; line-height: 1.8; margin-bottom: 12px;">Yey! Ini adalah bagian paling seru dari petualangan kita hari ini! 🚀 Setelah kita sukses bertanya dan mencatat semua jawaban dari narasumber di sekolah, sekarang tugas kita adalah merangkumnya menjadi sebuah laporan cerita yang singkat dan jelas. 📝 Ceritakan kembali kepada teman-teman di kelas tentang siapa narasumber yang kalian temui, apa saja informasi seru yang mereka berikan, dan kesan kalian selama melakukan wawancara. 🏫 Saat mempresentasikannya di depan kelas, berdirilah dengan tegak, suara yang lantang, dan senyuman ceria agar teman-teman lain ikut merasa senang mendengarkan cerita petualangan kalian! 🌟 Bertepuk tanganlah untuk diri kalian sendiri karena sudah berhasil menjadi wartawan cilik yang hebat! 👏🎉</div><div style="background-color: rgb(243, 244, 246); padding: 12px 14px; margin-bottom: 8px; border-radius: 6px;"><div style="font-weight: 600; margin-bottom: 6px;">📝 Bedah Contoh:</div><div style="line-height: 1.7;">Contoh cara melaporkan hasil wawancara di depan kelas 🎤: <ul><li>'Halo teman-teman! Kemarin aku mewawancarai Pak Kebun sekolah. Beliau bilang merawat bunga mawar itu harus disiram setiap pagi agar tidak layu! 🌹'</li><li>'Aku merasa sangat senang dan bangga bisa berbicara langsung dengan narasumber hebat di sekolah kita! ✨'</li></ul></div></div><div style="margin-top: 8px;"><span style="display: inline-block; background-color: rgb(254, 252, 232); padding: 4px 10px; border-radius: 12px; font-size: 10pt; font-weight: 600;">🔑 Laporan Wawancara</span></div><div style="clear: both;"></div></div></div><div style="margin-top: 24px;"><h3 style="font-weight: bold; font-size: 14pt; margin-bottom: 8px;">💡 Tahukah Kamu?</h3><p style="text-align: left; line-height: 1.8; background-color: rgb(254, 252, 232); padding: 12px;"><span>💡 1. Wartawan profesional di televisi ternyata selalu membuat daftar pertanyaan (catatan kecil) sebelum mereka mulai meliput berita di luar lapangan loh! <br><br>🌟 2. Di sekolah-sekolah hebat seluruh dunia, anak-anak seusia kalian sudah biasa dilatih menjadi jurnalis cilik untuk membuat majalah dinding sekolah sendiri setiap bulan!</span></p></div><div style="margin-top: 24px;"><h3 style="font-weight: bold; font-size: 14pt; margin-bottom: 12px;">📖 Glosarium</h3><table style="width: 100%; border-collapse: collapse; border: 1px solid rgb(229, 231, 235);"><thead><tr style="background-color: rgb(243, 244, 246);"><th style="border: 1px solid rgb(229, 231, 235); padding: 8px; text-align: left; width: 30%;">Istilah</th><th style="border: 1px solid rgb(229, 231, 235); padding: 8px; text-align: left;">Definisi</th></tr></thead><tbody><tr><td style="border: 1px solid rgb(229, 231, 235); padding: 8px; font-weight: bold;">Wawancara</td><td style="border: 1px solid rgb(229, 231, 235); padding: 8px;">Kegiatan tanya jawab antara pewawancara dan narasumber untuk mencari dan mengumpulkan informasi penting.</td></tr><tr><td style="border: 1px solid rgb(229, 231, 235); padding: 8px; font-weight: bold;">Narasumber</td><td style="border: 1px solid rgb(229, 231, 235); padding: 8px;">Orang yang menjadi sumber informasi atau tempat kita bertanya untuk mendapatkan keterangan fakta.</td></tr><tr><td style="border: 1px solid rgb(229, 231, 235); padding: 8px; font-weight: bold;">Pewawancara</td><td style="border: 1px solid rgb(229, 231, 235); padding: 8px;">Orang yang memberikan pertanyaan kepada narasumber (dalam hal ini adalah kalian, sang wartawan cilik!).</td></tr><tr><td style="border: 1px solid rgb(229, 231, 235); padding: 8px; font-weight: bold;">Laporan</td><td style="border: 1px solid rgb(229, 231, 235); padding: 8px;">Hasil akhir berupa ringkasan informasi yang telah dikumpulkan setelah melakukan suatu kegiatan.</td></tr></tbody></table></div><div style="margin-top: 24px;"><h3 style="font-weight: bold; font-size: 11pt; margin-bottom: 8px;">📚 Referensi</h3><ul style="margin: 0px; padding-left: 20px; font-size: 10pt;"><li>Buku Tematik Terpadu Kurikulum Merdeka Kelas 4 SD Mata Pelajaran Bahasa Indonesia</li><li>Modul Belajar Literasi dan Jurnalis Cilik Tingkat Sekolah Dasar</li><li>Kamus Besar Bahasa Indonesia (KBBI) Edisi V</li></ul></div></div></div></div><div data-v2-export-item="d89ffb36-3eb1-4f40-ae43-f9708d7ae418:refleksi" data-v2-export-jenis="refleksi" data-v2-export-pertemuan="31" class="page-break-before" style="break-before: page;"><div data-v2-export-marker="true" style="font-size: 10pt; font-weight: 700; margin-bottom: 8px;">Pertemuan 31 — Refleksi</div><div class="document-preview bg-white mx-auto p-6 md:p-12 text-black" style="width: 100%; max-width: 210mm;"><div data-section="modul" style="display: none;"><div style="text-align: center; margin-bottom: 20px; border-bottom: 3px solid black; padding-bottom: 10px;"><h1 style="font-size: 16pt; font-weight: bold; margin: 0px; text-transform: uppercase;">MODUL AJAR: BAHASA INDONESIA</h1><p class="italic">Materi: Materi - Kelas Kelas</p></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">I. IDENTIFIKASI DASAR</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Identitas Umum</td><td style="border: 1px solid black; padding: 6px; vertical-align: top;"><div><strong>Nama Penyusun:</strong> Guru</div><div><strong>Sekolah:</strong> Sekolah</div><div><strong>Mata Pelajaran:</strong> Bahasa Indonesia</div><div><strong>Materi:</strong> Materi </div><div><strong>Kelas/Fase:</strong> Kelas / Fase</div><div><strong>Semester:</strong> 1</div><div><strong>Jumlah Pertemuan:</strong> 32 (0 Menit)</div></td></tr><tr style="background-color: rgb(219, 234, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">II. IDENTIFIKASI MURID</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Pengetahuan Awal</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Minat</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Latar Belakang</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Kebutuhan Belajar</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(209, 250, 229);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">III. JENIS PENGETAHUAN MATERI</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Faktual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Konseptual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Prosedural</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metakognitif</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Kaitan dengan Kehidupan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(254, 243, 199);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IV. INTEGRASI NILAI &amp; KARAKTER</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Nilai Karakter</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(224, 231, 255);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">V. DIMENSI PROFIL LULUSAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">DPL yang Dikembangkan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr></tbody></table><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VI. DESAIN PEMBELAJARAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Capaian Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Tujuan Pembelajaran</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Pemahaman Bermakna</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Model Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metode Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(240, 253, 244);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VII. LINTAS DISIPLIN ILMU</td></tr><tr style="background-color: rgb(252, 231, 243);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VIII. KEMITRAAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(207, 250, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IX. LINGKUNGAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(237, 233, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">X. PEMANFAATAN DIGITAL</td></tr></tbody></table><div style="margin-bottom: 30px;"><div style="background-color: rgb(226, 232, 240); padding: 8px; font-weight: bold; margin-bottom: 16px; border: 1px solid black;">XI. PENGALAMAN BELAJAR (LANGKAH PEMBELAJARAN)</div><div style="padding: 20px; text-align: center; color: rgb(107, 114, 128); border: 1px solid black;">Langkah pembelajaran akan muncul setelah generate modul</div></div><table style="width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin-top: 50px;"><tbody><tr><td style="width: 50%; text-align: center; vertical-align: top;">Mengetahui,<br>Kepala Sekolah<br><br><br><br><strong>...........................</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td><td style="width: 50%; text-align: center; vertical-align: top;">Guru Mata Pelajaran<br><br><br><br><br><strong>Guru</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td></tr></tbody></table></div><div data-section="tindakLanjut" style="display: block; margin-top: 40px;"><h2 style="text-align: center; font-weight: bold; font-size: 14pt; margin-bottom: 20px; text-transform: uppercase;">Refleksi &amp; Tindak Lanjut</h2><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 16px;"><thead><tr style="background-color: rgb(254, 202, 202);"><th style="border: 1px solid black; padding: 12px;">Remedial</th></tr></thead><tbody><tr><td style="border: 1px solid black; padding: 16px; vertical-align: top;"><span><p style="margin:6px 0">Berdasarkan hasil asesmen praktik wawancara pada pertemuan kedua ini, peserta didik yang belum mencapai tujuan pembelajaran akan diidentifikasi melalui analisis aspek kelancaran berbicara, intonasi, dan kesesuaian pertanyaan. Diagnosis awal menunjukkan hambatan utama terletak pada rasa percaya diri saat berhadapan langsung dengan narasumber serta kemampuan melakukan konfirmasi di luar daftar pertanyaan tertulis.</p><p style="margin:6px 0">Strategi remedial yang diterapkan adalah bimbingan sejawat (peer coaching) dan simulasi ulang berpasangan dengan durasi yang lebih singkat. Guru akan memberikan lembar kerja pemantik khusus yang merinci teknik mencairkan suasana (ice breaking) sebelum wawancara dimulai agar ketegangan siswa dapat berkurang secara signifikan.</p><p style="margin:6px 0">Contoh kegiatan konkretnya adalah siswa melakukan praktik wawancara ulang dengan guru sebagai narasumber pengganti menggunakan format tanya-jawab terpimpin. Setelah kegiatan tersebut, siswa diintegrasikan dengan program tutor sebaya di sekolah di mana mereka mendampingi siswa lain yang sudah mahir untuk mempraktikkan ulang wawancara singkat di perpustakaan sekolah.</p></span></td></tr></tbody></table></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black;"><thead><tr style="background-color: rgb(209, 250, 229);"><th style="border: 1px solid black; padding: 12px;">Pengayaan</th></tr></thead><tbody><tr><td style="border: 1px solid black; padding: 16px; vertical-align: top;"><span><p style="margin:6px 0">Peserta didik yang telah melampaui ketuntasan belajar pada pertemuan praktik wawancara ini akan diidentifikasi berdasarkan kemampuan improvisasi, kedalaman informasi yang diperoleh, dan sikap santun yang ditunjukkan. Analisis menunjukkan kelompok ini siap untuk mengeksplorasi teknik peliputan yang lebih kompleks di luar lingkungan sekolah dasar.</p><p style="margin:6px 0">Strategi pengayaan difokuskan pada peningkatan level kognitif melalui teknik reportase jurnalistik tingkat lanjut, seperti teknik menggali data terbuka (open-ended probing questions) dan teknik merangkum hasil wawancara secara langsung secara lisan maupun tertulis.</p><p style="margin:6px 0">Contoh kegiatan yang diberikan adalah menugaskan siswa menyusun draf artikel berita singkat atau siniar (podcast) mini berdurasi dua menit berdasarkan transkrip wawancara yang baru saja mereka lakukan. Kegiatan ini diintegrasikan langsung dengan program majalah dinding sekolah atau publikasi digital sekolah sebagai wadah apresiasi hasil karya peserta didik yang bersangkutan.</p></span></td></tr></tbody></table></div></div></div></div></div></body></html>