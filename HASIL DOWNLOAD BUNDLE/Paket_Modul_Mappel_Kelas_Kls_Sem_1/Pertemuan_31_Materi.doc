<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns:m='http://schemas.openxmlformats.org/officeDocument/2006/math' xmlns='http://www.w3.org/TR/REC-html40'><head><meta charset='utf-8'><title>Pertemuan 31 — </title><style>
/* Reset dasar */
*{box-sizing:border-box;margin:0;padding:0;min-height:0!important;max-height:none!important;
  height:auto!important;flex:none!important;overflow:visible!important;
  position:static!important;float:none!important}
/* Typography */
body{font-family:'Arial',sans-serif;font-size:11pt;line-height:1.5;color:#000;background:#fff}
/* Tables */
table{width:100%!important;border-collapse:collapse!important;margin-bottom:12px;
  display:table!important;table-layout:fixed!important}
tr{display:table-row!important}
td,th{border:1px solid #000;padding:6px 8px;vertical-align:top;
  display:table-cell!important;word-wrap:break-word;overflow-wrap:break-word}
/* Headings */
h1{font-size:16pt;font-weight:bold;margin:12px 0 6px}
h2{font-size:14pt;font-weight:bold;margin:10px 0 5px}
h3{font-size:12pt;font-weight:bold;margin:8px 0 4px}
h4,h5,h6{font-size:11pt;font-weight:bold;margin:6px 0 3px}
/* Paragraphs & lists */
p{margin:4px 0;line-height:1.5}
ul,ol{margin:6px 0;padding-left:20px}
li{margin:2px 0}
/* Inline */
sup{vertical-align:super;font-size:0.75em}
sub{vertical-align:sub;font-size:0.75em}
b,strong{font-weight:bold}
i,em{font-style:italic}
u{text-decoration:underline}
/* Images */
img{max-width:100%;display:block}
/* Page breaks (dikendalikan pruneV2ExportSections) */
.page-break-before{page-break-before:always!important;break-before:page!important}
/* Section wrappers */
[data-v2-export-item]{display:block!important}
/* Div/span umum */
div,span,section,article,main,header,footer,nav,aside{display:block}
</style></head><body><div data-v2-export-root="true"><div data-v2-export-item="d89ffb36-3eb1-4f40-ae43-f9708d7ae418:modul" data-v2-export-jenis="modul" data-v2-export-pertemuan="31"><div data-v2-export-marker="true" style="font-size: 10pt; font-weight: 700; margin-bottom: 8px;">Pertemuan 31 — Modul</div><div class="document-preview bg-white mx-auto p-6 md:p-12 text-black" style="width: 100%; max-width: 210mm;"><div data-section="modul" style="display: block;"><div style="text-align: center; margin-bottom: 20px; border-bottom: 3px solid black; padding-bottom: 10px;"><h1 style="font-size: 16pt; font-weight: bold; margin: 0px; text-transform: uppercase;">MODUL AJAR: BAHASA INDONESIA</h1><p class="italic">Materi: Materi - Kelas Kelas</p></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">I. IDENTIFIKASI DASAR</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Identitas Umum</td><td style="border: 1px solid black; padding: 6px; vertical-align: top;"><div><strong>Nama Penyusun:</strong> Guru</div><div><strong>Sekolah:</strong> Sekolah</div><div><strong>Mata Pelajaran:</strong> Bahasa Indonesia</div><div><strong>Materi:</strong> Materi </div><div><strong>Kelas/Fase:</strong> Kelas / Fase</div><div><strong>Semester:</strong> 1</div><div><strong>Jumlah Pertemuan:</strong> 32 (0 Menit)</div></td></tr><tr style="background-color: rgb(219, 234, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">II. IDENTIFIKASI MURID</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Pengetahuan Awal</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Minat</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Latar Belakang</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Kebutuhan Belajar</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(209, 250, 229);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">III. JENIS PENGETAHUAN MATERI</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Faktual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Konseptual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Prosedural</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metakognitif</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Kaitan dengan Kehidupan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(254, 243, 199);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IV. INTEGRASI NILAI &amp; KARAKTER</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Nilai Karakter</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(224, 231, 255);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">V. DIMENSI PROFIL LULUSAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">DPL yang Dikembangkan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr></tbody></table><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VI. DESAIN PEMBELAJARAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Capaian Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Tujuan Pembelajaran</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Pemahaman Bermakna</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Model Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metode Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(240, 253, 244);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VII. LINTAS DISIPLIN ILMU</td></tr><tr style="background-color: rgb(252, 231, 243);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VIII. KEMITRAAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(207, 250, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IX. LINGKUNGAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(237, 233, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">X. PEMANFAATAN DIGITAL</td></tr></tbody></table><div style="margin-bottom: 30px;"><div style="background-color: rgb(226, 232, 240); padding: 8px; font-weight: bold; margin-bottom: 16px; border: 1px solid black;">XI. PENGALAMAN BELAJAR (LANGKAH PEMBELAJARAN)</div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black; table-layout: fixed;"><colgroup><col style="width: 18%;"><col style="width: 67%;"><col style="width: 15%;"></colgroup><tbody><tr style="background-color: rgb(241, 245, 249); text-align: center;"><th style="border: 1px solid black; padding: 6px;">TAHAP</th><th style="border: 1px solid black; padding: 6px;">KEGIATAN &amp; PRINSIP</th><th style="border: 1px solid black; padding: 6px;">DURASI</th></tr><tr style="background-color: rgb(199, 210, 254);"><td colspan="3" style="border: 1px solid black; padding: 8px; font-weight: bold; text-align: center;">PERTEMUAN 2 (70 Menit)</td></tr><tr><td rowspan="3" style="border: 1px solid black; padding: 8px; font-weight: bold; text-align: center; vertical-align: top; background-color: rgb(219, 234, 254);">Pendahuluan</td><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Orientasi</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Salam, Doa, dan Tujuan (4 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru mengucapkan salam dan meminta ketua kelas memimpin doa.</span></li><li style="font-size: 0.9em;"><span>Murid berdoa bersama dengan khidmat.</span></li><li style="font-size: 0.9em;"><span>Guru menyampaikan tujuan pembelajaran hari ini yaitu mempraktikkan wawancara sederhana dengan tokoh di sekolah.</span></li><li style="font-size: 0.9em;"><span>Murid menyimak dan menyadari pentingnya menguasai keterampilan komunikasi ini.</span></li></ul><div style="margin-left: 12px; background-color: rgb(254, 243, 199); padding: 6px 8px; border-radius: 4px; margin-top: 4px;"><span style="font-weight: 500; color: rgb(217, 119, 6); font-size: 0.85em;">💡 Pertanyaan Pemantik:</span><ul style="margin-left: 16px; margin-top: 2px; list-style-type: none; margin-bottom: 0px;"><li style="font-size: 0.85em; font-style: italic;">"<span>Apa yang ingin kalian ketahui dari seorang tokoh di sekolah kita?</span>"</li></ul></div></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Membangun kesadaran (Mindful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">4 menit</td></tr><tr><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Apersepsi</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Kaitan Pengalaman Sehari-hari (3 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru bertanya kepada murid apakah mereka pernah bertanya kepada guru atau petugas sekolah tentang sesuatu.</span></li><li style="font-size: 0.9em;"><span>Murid berbagi pengalaman saat bertanya kepada orang lain di lingkungan sekolah.</span></li></ul><div style="margin-left: 12px; background-color: rgb(254, 243, 199); padding: 6px 8px; border-radius: 4px; margin-top: 4px;"><span style="font-weight: 500; color: rgb(217, 119, 6); font-size: 0.85em;">💡 Pertanyaan Pemantik:</span><ul style="margin-left: 16px; margin-top: 2px; list-style-type: none; margin-bottom: 0px;"><li style="font-size: 0.85em; font-style: italic;">"<span>Pernahkah kalian mewawancarai seseorang atau melihat di televisi? Bagaimana caranya?</span>"</li></ul></div></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Bermakna (Meaningful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">3 menit</td></tr><tr><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Motivasi</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Ice Breaking Wartawan Cilik (3 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru mengajak murid memperagakan gaya seorang wartawan TV membawa mikrofon mainan secara serentak.</span></li><li style="font-size: 0.9em;"><span>Murid berpartisipasi dengan antusias sambil tertawa gembira.</span></li></ul></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Menggembirakan (Joyful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">3 menit</td></tr><tr style="background-color: rgb(209, 250, 229);"><td colspan="3" style="border: 1px solid black; padding: 8px; font-weight: bold; text-align: center;">TAHAP INTI - INTI<div style="font-size: 0.85em; font-weight: normal; margin-top: 4px;">Durasi Total: 50 menit | Bermakna, Membangun kesadaran, Menggembirakan</div></td></tr><tr style="background-color: rgb(241, 245, 249);"><th style="border: 1px solid black; padding: 6px; width: 15%;">FASE</th><th style="border: 1px solid black; padding: 6px;">KEGIATAN &amp; PRINSIP</th><th style="border: 1px solid black; padding: 6px; width: 10%;">DURASI</th></tr><tr><td rowspan="3" style="border: 1px solid black; padding: 8px; font-weight: bold; text-align: center; vertical-align: top; background-color: rgb(209, 250, 229); width: 15%;"><div style="font-size: 1.1em;">🔍 MEMAHAMI</div><div style="font-size: 0.85em; font-weight: normal; margin-top: 4px; font-style: italic;">(15 menit)</div><div style="font-size: 0.8em; font-weight: normal; margin-top: 4px; color: rgb(5, 150, 105);">★ Bermakna, Membangun kesadaran (Meaningful, Mindful)</div></td><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Konstruktivisme</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Eksplorasi Konsep Wawancara (5 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru memfasilitasi murid menghubungkan pengetahuan kalimat tanya yang sudah dimiliki dengan konsep wawancara.</span></li><li style="font-size: 0.9em;"><span>Murid menyimpulkan bahwa wawancara adalah kegiatan tanya jawab untuk mencari informasi.</span></li></ul></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Bermakna (Meaningful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">5 menit</td></tr><tr><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Menemukan</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Menemukan Unsur Wawancara (5 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru menyajikan teks percakapan wawancara sederhana.</span></li><li style="font-size: 0.9em;"><span>Murid mengamati dan menemukan unsur-unsur penting seperti pewawancara, narasumber, dan daftar pertanyaan.</span></li></ul></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Bermakna (Meaningful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">5 menit</td></tr><tr><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Bertanya</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Menyusun Daftar Pertanyaan (5 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru membimbing murid merumuskan pertanyaan wawancara yang baik.</span></li><li style="font-size: 0.9em;"><span>Murid mengajukan pertanyaan terkait cara membuat pertanyaan yang sopan.</span></li></ul><div style="margin-left: 12px; background-color: rgb(254, 243, 199); padding: 6px 8px; border-radius: 4px; margin-top: 4px;"><span style="font-weight: 500; color: rgb(217, 119, 6); font-size: 0.85em;">💡 Pertanyaan Pemantik:</span><ul style="margin-left: 16px; margin-top: 2px; list-style-type: none; margin-bottom: 0px;"><li style="font-size: 0.85em; font-style: italic;">"<span>Bagaimana cara bertanya agar narasumber merasa nyaman?</span>"</li><li style="font-size: 0.85em; font-style: italic;">"<span>Kata tanya apa saja yang paling efektif digunakan?</span>"</li></ul></div></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Membangun kesadaran (Mindful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">5 menit</td></tr><tr><td rowspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold; text-align: center; vertical-align: top; background-color: rgb(254, 243, 199); width: 15%;"><div style="font-size: 1.1em;">🛠️ MENGAPLIKASI</div><div style="font-size: 0.85em; font-weight: normal; margin-top: 4px; font-style: italic;">(25 menit)</div><div style="font-size: 0.8em; font-weight: normal; margin-top: 4px; color: rgb(217, 119, 6);">★ Menggembirakan (Joyful)</div></td><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Pemodelan</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Simulasi Guru dan Murid (10 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru memperagakan contoh wawancara yang benar dan salah di depan kelas bersama salah satu murid.</span></li><li style="font-size: 0.9em;"><span>Murid mengamati gestur tubuh, intonasi, dan kesantunan berbahasa yang dicontohkan.</span></li><li style="font-size: 0.9em;"><span>Murid memberikan tanggapan terhadap pemodelan yang dilakukan.</span></li></ul></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Menggembirakan (Joyful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">10 menit</td></tr><tr><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Masyarakat Belajar</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Praktik Wawancara Kelompok (15 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru membagi murid ke dalam kelompok kecil untuk melakukan simulasi (role-playing) wawancara antar teman sebaya.</span></li><li style="font-size: 0.9em;"><span>Murid bergiliran berperan sebagai pewawancara dan tokoh sekolah (misalnya penjaga kantin atau pustakawan).</span></li><li style="font-size: 0.9em;"><span>Guru berkeliling membimbing jalannya simulasi dan memberikan umpan balik.</span></li></ul></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Menggembirakan (Joyful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">15 menit</td></tr><tr><td rowspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold; text-align: center; vertical-align: top; background-color: rgb(219, 234, 254); width: 15%;"><div style="font-size: 1.1em;">💭 MEREFLEKSI</div><div style="font-size: 0.85em; font-weight: normal; margin-top: 4px; font-style: italic;">(10 menit)</div><div style="font-size: 0.8em; font-weight: normal; margin-top: 4px; color: rgb(37, 99, 235);">★ Membangun kesadaran (Mindful)</div></td><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Penilaian Autentik</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Penilaian Kinerja Simulasi (5 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru menilai keterampilan praktik wawancara murid menggunakan rubrik sederhana.</span></li><li style="font-size: 0.9em;"><span>Murid mengumpulkan hasil catatan wawancara latihan mereka.</span></li></ul></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Membangun kesadaran (Mindful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">5 menit</td></tr><tr><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Refleksi</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Refleksi Pengalaman Praktik (5 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru memandu murid mendiskusikan kendala yang dialami saat simulasi.</span></li><li style="font-size: 0.9em;"><span>Murid mengungkapkan perasaan dan pengalaman mereka saat mempraktikkan wawancara.</span></li></ul><div style="margin-left: 12px; background-color: rgb(254, 243, 199); padding: 6px 8px; border-radius: 4px; margin-top: 4px;"><span style="font-weight: 500; color: rgb(217, 119, 6); font-size: 0.85em;">💡 Pertanyaan Pemantik:</span><ul style="margin-left: 16px; margin-top: 2px; list-style-type: none; margin-bottom: 0px;"><li style="font-size: 0.85em; font-style: italic;">"<span>Bagian mana yang paling menantang saat melakukan wawancara tadi?</span>"</li><li style="font-size: 0.85em; font-style: italic;">"<span>Bagaimana cara kita memperbaikinya pada pertemuan berikutnya?</span>"</li></ul></div></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Membangun kesadaran (Mindful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">5 menit</td></tr><tr><td rowspan="3" style="border: 1px solid black; padding: 8px; font-weight: bold; text-align: center; vertical-align: top; background-color: rgb(254, 243, 199);">Penutup</td><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Refleksi Individu &amp; Kelompok</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Kesimpulan Singkat (4 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru meminta murid menuliskan satu hal baru yang dipelajari hari ini.</span></li><li style="font-size: 0.9em;"><span>Murid berbagi catatan singkat dengan teman sebangku.</span></li></ul></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Membangun kesadaran (Mindful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">4 menit</td></tr><tr><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Kesimpulan Bersama</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Penguatan Konsep (3 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru bersama murid menyimpulkan bahwa wawancara membutuhkan persiapan matang dan kesantunan.</span></li><li style="font-size: 0.9em;"><span>Murid mencatat poin penting kesimpulan.</span></li></ul></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Bermakna (Meaningful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">3 menit</td></tr><tr><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Pesan Inspiratif &amp; Apresiasi</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Apresiasi dan Doa (3 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru memberikan pujian atas keaktifan seluruh murid dalam simulasi.</span></li><li style="font-size: 0.9em;"><span>Guru memimpin doa penutup dan mengucapkan salam.</span></li></ul></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Menggembirakan (Joyful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">3 menit</td></tr></tbody></table></div></div><table style="width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin-top: 50px;"><tbody><tr><td style="width: 50%; text-align: center; vertical-align: top;">Mengetahui,<br>Kepala Sekolah<br><br><br><br><strong>...........................</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td><td style="width: 50%; text-align: center; vertical-align: top;">Guru Mata Pelajaran<br><br><br><br><br><strong>Guru</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td></tr></tbody></table></div></div></div><div data-v2-export-item="d89ffb36-3eb1-4f40-ae43-f9708d7ae418:lkpd" data-v2-export-jenis="lkpd" data-v2-export-pertemuan="31" class="page-break-before" style="break-before: page;"><div data-v2-export-marker="true" style="font-size: 10pt; font-weight: 700; margin-bottom: 8px;">Pertemuan 31 — LKPD</div><div class="document-preview bg-white mx-auto p-6 md:p-12 text-black" style="width: 100%; max-width: 210mm;"><div data-section="modul" style="display: none;"><div style="text-align: center; margin-bottom: 20px; border-bottom: 3px solid black; padding-bottom: 10px;"><h1 style="font-size: 16pt; font-weight: bold; margin: 0px; text-transform: uppercase;">MODUL AJAR: BAHASA INDONESIA</h1><p class="italic">Materi: Materi - Kelas Kelas</p></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">I. IDENTIFIKASI DASAR</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Identitas Umum</td><td style="border: 1px solid black; padding: 6px; vertical-align: top;"><div><st