black; padding: 6px; font-weight: bold; vertical-align: top;">DPL yang Dikembangkan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr></tbody></table><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VI. DESAIN PEMBELAJARAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Capaian Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Tujuan Pembelajaran</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Pemahaman Bermakna</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Model Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metode Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(240, 253, 244);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VII. LINTAS DISIPLIN ILMU</td></tr><tr style="background-color: rgb(252, 231, 243);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VIII. KEMITRAAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(207, 250, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IX. LINGKUNGAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(237, 233, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">X. PEMANFAATAN DIGITAL</td></tr></tbody></table><div style="margin-bottom: 30px;"><div style="background-color: rgb(226, 232, 240); padding: 8px; font-weight: bold; margin-bottom: 16px; border: 1px solid black;">XI. PENGALAMAN BELAJAR (LANGKAH PEMBELAJARAN)</div><div style="padding: 20px; text-align: center; color: rgb(107, 114, 128); border: 1px solid black;">Langkah pembelajaran akan muncul setelah generate modul</div></div><table style="width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin-top: 50px;"><tbody><tr><td style="width: 50%; text-align: center; vertical-align: top;">Mengetahui,<br>Kepala Sekolah<br><br><br><br><strong>...........................</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td><td style="width: 50%; text-align: center; vertical-align: top;">Guru Mata Pelajaran<br><br><br><br><br><strong>Guru</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td></tr></tbody></table></div><div data-section="lkpd" style="display: block; margin-top: 40px;"><div style=""></div><h2 style="text-align: center; font-weight: bold; font-size: 14pt; margin-bottom: 4px;">LEMBAR KERJA PESERTA DIDIK</h2><p style="text-align: center; font-size: 10pt; margin-bottom: 24px;">Model: Deep Learning 2026</p><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-bottom: 24px;"><h3 style="font-weight: bold; font-size: 12pt; margin-bottom: 12px;">Menganalisis Dua Karakter Buku</h3><div style="background-color: rgb(249, 250, 251); padding: 12px; margin-bottom: 12px;"><strong style="font-size: 10pt; color: rgb(75, 85, 99);">📖 Bacaan:</strong><p style="text-align: justify; white-space: pre-line; margin-top: 8px; margin-bottom: 0px;"><span>Berikut adalah profil dari dua buku yang ditemukan di perpustakaan sekolah:<br><br><table border="1" style="border-collapse:collapse;width:100%"><thead><tr style="background-color:#f2f2f2;"><th>Aspek Pengamatan</th><th>Buku A</th><th>Buku B</th></tr></thead><tbody><tr><td><b>Judul Buku</b></td><td>Kancil dan Sahabat Rimba</td><td>Mengenal Hewan Mamalia</td></tr><tr><td><b>Gambar Sampul</b></td><td>Ilustrasi kartun kancil memakai kacamata dan tersenyum ramah.</td><td>Foto asli hewan lumba-lumba dan kucing di habitat aslinya.</td></tr><tr><td><b>Daftar Isi</b></td><td>Bab 1: Pesta di Bawah Pohon Beringin<br>Bab 2: Siasat Cerdik Menyeberang Sungai<br>Bab 3: Persahabatan yang Abadi</td><td>Bab 1: Pengertian Hewan Mamalia<br>Bab 2: Ciri-Ciri Fisik Mamalia<br>Bab 3: Contoh Hewan Mamalia di Sekitar Kita</td></tr><tr><td><b>Cuplikan Isi Buku</b></td><td>'Jangan takut, sahabatku!' seru Kancil dengan nada riang. Ia melompat lincah di atas punggung buaya yang berbaris rapi di sungai bagaikan jembatan kayu.</td><td>Mamalia adalah kelas hewan menyusui yang sebagian besar melahirkan keturunannya. Mereka bernapas menggunakan paru-paru dan memiliki rambut di tubuhnya.</td></tr></tbody></table></span></p></div><p style="margin-bottom: 12px;"><span>Amatilah tabel profil Buku A dan Buku B di atas dengan cermat. Analisis perbedaan ciri fisik (sampul, daftar isi) serta isi bahasanya, kemudian jawablah pertanyaan kunci di bawah ini.</span></p><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Berdasarkan gambar sampul dan daftar isinya, apa perbedaan utama yang paling mencolok antara Buku A dan Buku B?</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Buku mana yang isinya berupa khayalan/rekaan penulis, dan buku mana yang berisi fakta ilmiah? Jelaskan alasanmu berdasarkan cuplikan isi buku!</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Simpulkan, mana yang termasuk buku fiksi dan mana yang termasuk buku nonfiksi!</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-bottom: 24px;"><h3 style="font-weight: bold; font-size: 12pt; margin-bottom: 12px;">Diskusi Detektif Buku</h3><div style="background-color: rgb(249, 250, 251); padding: 12px; margin-bottom: 12px;"><strong style="font-size: 10pt; color: rgb(75, 85, 99);">📖 Bacaan:</strong><p style="text-align: justify; white-space: pre-line; margin-top: 8px; margin-bottom: 0px;"><span>Bayangkan kalian sedang berada di perpustakaan sekolah yang besar. Di hadapan kalian terdapat rak buku acak yang belum dirapikan. Kalian diminta oleh pustakawan untuk memisahkan buku fiksi dan nonfiksi dengan cepat tanpa harus membaca seluruh halaman buku dari awal sampai akhir.</span></p></div><p style="margin-bottom: 12px;"><span>Diskusikan bersama teman sebangkumu (2 orang). Tentukan langkah-langkah cepat atau 'tips detektif' untuk membedakan buku fiksi dan nonfiksi hanya dalam waktu singkat dengan mengamati bagian luar dan bagian awal buku!</span></p><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Tuliskan 3 ciri fisik luar (eksterior) buku yang paling cepat membantu kalian membedakan buku fiksi dan nonfiksi!</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Mengapa bagian 'Daftar Isi' sangat penting dalam membantu membedakan kedua jenis buku tersebut?</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div></div></div></div></div></div><div data-v2-export-item="05e8ba7a-c6e3-4fc2-a285-a22c7e25d870:asesmen" data-v2-export-jenis="asesmen" data-v2-export-pertemuan="8" class="page-break-before" style="break-before: page;"><div data-v2-export-marker="true" style="font-size: 10pt; font-weight: 700; margin-bottom: 8px;">Pertemuan 8 — Asesmen</div><div class="document-preview bg-white mx-auto p-6 md:p-12 text-black" style="width: 100%; max-width: 210mm;"><div data-section="modul" style="display: none;"><div style="text-align: center; margin-bottom: 20px; border-bottom: 3px solid black; padding-bottom: 10px;"><h1 style="font-size: 16pt; font-weight: bold; margin: 0px; text-transform: uppercase;">MODUL AJAR: BAHASA INDONESIA</h1><p class="italic">Materi: Materi - Kelas Kelas</p></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">I. IDENTIFIKASI DASAR</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Identitas Umum</td><td style="border: 1px solid black; padding: 6px; vertical-align: top;"><div><strong>Nama Penyusun:</strong> Guru</div><div><strong>Sekolah:</strong> Sekolah</div><div><strong>Mata Pelajaran:</strong> Bahasa Indonesia</div><div><strong>Materi:</strong> Materi </div><div><strong>Kelas/Fase:</strong> Kelas / Fase</div><div><strong>Semester:</strong> 1</div><div><strong>Jumlah Pertemuan:</strong> 32 (0 Menit)</div></td></tr><tr style="background-color: rgb(219, 234, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">II. IDENTIFIKASI MURID</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Pengetahuan Awal</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Minat</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Latar Belakang</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Kebutuhan Belajar</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(209, 250, 229);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">III. JENIS PENGETAHUAN MATERI</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Faktual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Konseptual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Prosedural</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metakognitif</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Kaitan dengan Kehidupan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(254, 243, 199);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IV. INTEGRASI NILAI &amp; KARAKTER</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Nilai Karakter</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(224, 231, 255);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">V. DIMENSI PROFIL LULUSAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">DPL yang Dikembangkan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr></tbody></table><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VI. DESAIN PEMBELAJARAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Capaian Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Tujuan Pembelajaran</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Pemahaman Bermakna</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Model Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metode Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(240, 253, 244);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VII. LINTAS DISIPLIN ILMU</td></tr><tr style="background-color: rgb(252, 231, 243);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VIII. KEMITRAAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(207, 250, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IX. LINGKUNGAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(237, 233, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">X. PEMANFAATAN DIGITAL</td></tr></tbody></table><div style="margin-bottom: 30px;"><div style="background-color: rgb(226, 232, 240); padding: 8px; font-weight: bold; margin-bottom: 16px; border: 1px solid black;">XI. PENGALAMAN BELAJAR (LANGKAH PEMBELAJARAN)</div><div style="padding: 20px; text-align: center; color: rgb(107, 114, 128); border: 1px solid black;">Langkah pembelajaran akan muncul setelah generate modul</div></div><table style="width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin-top: 50px;"><tbody><tr><td style="width: 50%; text-align: center; vertical-align: top;">Mengetahui,<br>Kepala Sekolah<br><br><br><br><strong>...........................</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td><td style="width: 50%; text-align: center; vertical-align: top;">Guru Mata Pelajaran<br><br><br><br><br><strong>Guru</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td></tr></tbody></table></div><div data-section="asesmen" style="display: block; margin-top: 40px;"><div style=""></div><h2 style="text-align: center; font-weight: bold; font-size: 14pt; text-transform: uppercase; margin-bottom: 24px;">Instrumen Asesmen Pembelajaran</h2><div style="margin-bottom: 24px;"><h3 style="font-weight: bold; font-size: 12pt; margin-bottom: 8px;">A. ASESMEN AWAL PEMBELAJARAN (Diagnostik)</h3><p style="font-style: italic; font-size: 10pt; margin-bottom: 8px;">Mengidentifikasi pemahaman awal siswa mengenai perbedaan dasar antara buku fiksi dan nonfiksi berdasarkan pengalaman membaca mereka sehari-hari sebelum masuk ke analisis mendalam.</p><p style="margin-bottom: 12px;"><strong>Metode:</strong> Pertanyaan Lisan</p><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black;"><thead><tr style="background-color: rgb(241, 245, 249);"><th style="border: 1px solid black; padding: 8px; width: 5%;">No</th><th style="border: 1px solid black; padding: 8px; width: 55%;">Pertanyaan Pemantik</th><th style="border: 1px solid black; padding: 8px; width: 40%;">Tujuan</th></tr></thead><tbody><tr><td style="border: 1px solid black; padding: 8px; text-align: center;">1</td><td style="border: 1px solid black; padding: 8px;"><span>Pernahkah kamu membaca buku tentang dongeng hewan yang bisa berbicara dan buku tentang cara merawat tanaman? Apa perbedaan utama dari isi kedua buku tersebut?</span></td><td style="border: 1px solid black; padding: 8px;"><span>Mengidentifikasi kemampuan awal siswa dalam membedakan sifat isi buku (khayalan vs fakta).</span></td></tr><tr><td style="border: 1px solid black; padding: 8px; text-align: center;">2</td><td style="border: 1px solid black; padding: 8px;"><span>Jika kamu melihat sampul buku yang menggunakan foto asli pemandangan alam dan satu lagi menggunakan gambar kartun monster, mana yang menurutmu merupakan buku nonfiksi?</span></td><td style="border: 1px solid black; padding: 8px;"><span>Mengukur kepekaan visual awal siswa terhadap ciri fisik sampul buku fiksi dan nonfiksi.</span></td></tr></tbody></table></div></div><div style="margin-bottom: 24px;"><h3 style="font-weight: bold; font-size: 12pt; margin-bottom: 8px;">B. ASESMEN PROSES PEMBELAJARAN (Formatif)</h3><p style="font-style: italic; font-size: 10pt; margin-bottom: 8px;">Asesmen formatif yang dilakukan selama proses diskusi kelompok untuk memantau keterampilan sosial, kolaborasi, dan kemampuan analitis siswa saat membandingkan dua buku secara langsung.</p><p style="margin-bottom: 16px;"><strong>Metode:</strong> Observasi dan Diskusi Kelompok</p><div style="margin-bottom: 16px;"><h4 style="font-weight: bold; margin-bottom: 8px;">Aktivitas 1: Detektif Buku: Membedakan Fisik dan Isi Buku</h4><p style="margin-bottom: 8px;"><strong>Instruksi:</strong> <span>Bekerjalah dalam kelompok yang terdiri dari 4 orang. Amati dua buku contoh yang disediakan guru (satu buku cerita rakyat dan satu buku pengetahuan populer). Diskusikan perbedaan visual, bahasa, dan struktur penyajian di dalamnya, lalu catat hasil temuan kelompokmu.</span></p><div style="margin-bottom: 8px;"><strong>Pertanyaan Diskusi:</strong><ul style="margin-left: 20px; margin-top: 4px; list-style-type: disc;"><li><span>Bagaimana perbedaan tampilan gambar/ilustrasi pada sampul dan bagian dalam kedua buku tersebut?</span></li><li><span>Apakah buku yang satu memiliki daftar isi atau indeks yang berbeda dengan buku yang lainnya? Jelaskan mengapa fitur tersebut ada!</span></li></ul></div><div><strong>Kunci Jawaban:</strong><ul style="margin-left: 20px; margin-top: 4px; list-style-type: disc;"><li><span>Buku fiksi menggunakan ilustrasi imajinatif/gambaran tangan kartun, sedangkan buku nonfiksi cenderung menggunakan foto asli, diagram, atau ilustrasi ilmiah. Buku nonfiksi memiliki daftar isi yang sistematis dan terkadang indeks untuk mempermudah pencarian informasi faktual, sedangkan buku fiksi berfokus pada alur cerita kronologis.</span></li></ul></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-top: 16px;"><h4 style="font-weight: bold; margin-bottom: 8px;">Rubrik Penilaian Proses</h4><table style="width: 100%; border-collapse: collapse; border: 1px solid black;"><thead><tr style="background-color: rgb(241, 245, 249);"><th style="border: 1px solid black; padding: 8px;">Aspek</th><th style="border: 1px solid black; padding: 8px;">Sangat Baik (4)</th><th style="border: 1px solid black; padding: 8px;">Baik (3)</th><th style="border: 1px solid black; padding: 8px;">Cukup (2)</th><th style="border: 1px solid black; padding: 8px;">Kurang (1)</th></tr></thead><tbody><tr><td style="border: 1px solid black; padding: 8px; font-weight: bold;">Kemampuan Mengidentifikasi Ciri Fisik Buku</td><td style="border: 1px solid black; padding: 8px;"><span>Mampu mengidentifikasi minimal 4 perbedaan ciri fisik (sampul, ilustrasi, tata letak, fitur buku) secara tepat, rinci, dan mandiri.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Mampu mengidentifikasi 3 perbedaan ciri fisik buku dengan tepat dan runtut.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Mampu mengidentifikasi 2 perbedaan ciri fisik buku dengan bantuan atau arahan guru.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Hanya mampu mengidentifikasi 1 perbedaan ciri fisik atau kurang tepat dalam membedakannya.</span></td></tr><tr><td style="border: 1px solid black; padding: 8px; font-weight: bold;">Kemampuan Menganalisis Sifat Isi Buku</td><td style="border: 1px solid black; padding: 8px;"><span>Sangat tajam dalam membedakan isi buku (fakta vs imajinasi) disertai dengan bukti kalimat pendukung dari dalam buku contoh secara akurat.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Mampu membedakan isi buku berdasarkan fakta dan imajinasi dengan penjelasan yang logis namun tanpa contoh spesifik.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Mampu membedakan isi buku tetapi penjelasannya masih sederhana dan perlu sering dipandu.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Belum mampu membedakan sifat isi buku fiksi dan nonfiksi secara tepat.</span></td></tr></tbody></table></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-top: 16px;"><p style="font-weight: bold; margin-bottom: 4px;">📝 Penilaian Diri:</p><ul style="margin-left: 20px; list-style-type: disc;"><li><span>Saya dapat membedakan buku fiksi dan nonfiksi hanya dengan melihat sampul dan daftar isinya.</span></li><li><span>Saya aktif menyumbang ide dan mendengarkan pendapat teman saat berdiskusi dalam kelompok.</span></li></ul></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-top: 12px;"><p style="font-weight: bold; margin-bottom: 4px;">👥 Penilaian Sejawat:</p><ul style="margin-left: 20px; list-style-type: disc;"><li><span>Teman saya menghargai perbedaan pendapat saat menentukan jenis buku fiksi atau nonfiksi.</span></li><li><span>Teman saya fokus bekerja sama menyelesaikan lembar kerja analisis buku tepat waktu.</span></li></ul></div></div></div><div style="margin-bottom: 24px;"><h3 style="font-weight: bold; font-size: 12pt; margin-bottom: 8px;">C. ASESMEN AKHIR PEMBELAJARAN (Sumatif)</h3><p style="font-style: italic; font-size: 10pt; margin-bottom: 8px;">Asesmen sumatif akhir pertemuan berbentuk tes tertulis uraian untuk mengukur pemahaman mendalam siswa mengenai perbedaan buku fiksi dan nonfiksi secara individu.</p><p style="margin-bottom: 12px;"><strong>Metode:</strong> Tes Tertulis Uraian</p><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-bottom: 16px;"><h4 style="font-weight: bold; margin-bottom: 8px;">Soal Uraian</h4><table style="width: 100%; border-collapse: collapse; border: 1px solid black;"><thead><tr style="background-color: rgb(241, 245, 249);"><th style="border: 1px solid black; padding: 8px; width: 5%;">No</th><th style="border: 1px solid black; padding: 8px; width: 45%;">Pertanyaan</th><th style="border: 1px solid black; padding: 8px; width: 40%;">Kunci Jawaban</th><th style="border: 1px solid black; padding: 8px; width: 10%;">Skor</th></tr></thead><tbody><tr><td style="border: 1px solid black; padding: 8px; text-align: center;">1</td><td style="border: 1px solid black; padding: 8px;"><span>Tuliskan 3 perbedaan ciri fisik yang paling mencolok pada sampul depan buku fiksi dan buku nonfiksi!</span></td><td style="border: 1px solid black; padding: 8px;"><span>1) Ilustrasi sampul: Buku fiksi memakai gambar ilustrasi/kartun imajinatif, sedangkan nonfiksi memakai foto asli atau gambar ilmiah/faktual. 2) Judul buku: Buku fiksi menggunakan judul yang ekspresif/puitis (misal: 'Kancil yang Cerdik'), sedangkan nonfiksi menggunakan judul yang informatif/ilmiah (misal: 'Kehidupan Hewan Mamalia'). 3) Informasi tambahan: Sampul nonfiksi sering memuat subjudul penjelasan ilmiah atau nama lembaga kredibel, sedangkan fiksi biasanya hanya nama penulis dan penerbit saja.</span></td><td style="border: 1px solid black; padding: 8px; text-align: center;">30</td></tr><tr><td style="border: 1px solid black; padding: 8px; text-align: center;">2</td><td style="border: 1px solid black; padding: 8px;"><span>Mengapa sebuah buku ensiklopedia tentang luar angkasa dikategorikan sebagai buku nonfiksi, sedangkan cerita petualangan anak ke planet Mars dikategorikan sebagai buku fiksi? Jelaskan berdasarkan isi bukunya!</span></td><td style="border: 1px solid black; padding: 8px;"><span>Ensiklopedia luar angkasa dikategorikan sebagai nonfiksi karena isinya memuat data ilmiah, fakta nyata, dan informasi tepercaya hasil penelitian tentang tata surya. Sementara cerita petualangan ke Mars dikategorikan fiksi karena alur ceritanya, tokoh-tokohnya, dan kejadian di dalamnya merupakan hasil khayalan atau imajinasi kreatif penulis, bukan kejadian nyata yang bisa dibuktikan secara ilmiah.</span></td><td style="border: 1px solid black; padding: 8px; text-align: center;">40</td></tr><tr><td style="border: 1px solid black; padding: 8px; text-align: center;">3</td><td style="border: 1px solid black; padding: 8px;"><span>Jika kamu membuka sebuah buku dan menemukan halaman glosarium (daftar istilah penting) serta daftar pustaka di bagian belakang, buku jenis apakah itu? Berikan alasanmu!</span></td><td style="border: 1px solid black; padding: 8px;"><span>Buku tersebut adalah buku nonfiksi. Alasannya, glosarium berfungsi untuk menjelaskan arti istilah-istilah ilmiah/khusus yang ada dalam buku pengetahuan, dan daftar pustaka berfungsi untuk menunjukkan sumber referensi ilmiah tepercaya yang digunakan penulis untuk menyusun data. Kedua fitur ini hanya diperlukan dalam buku ilmiah/faktual (nonfiksi) dan tidak lazim ada pada buku cerita (fiksi).</span></td><td style="border: 1px solid black; padding: 8px; text-align: center;">30</td></tr></tbody></table></div></div><div style="margin-top: 16px;"><h4 style="font-weight: bold; margin-bottom: 8px;">Rubrik Penilaian Akhir</h4><table style="width: 100%; border-collapse: collapse; border: 1px solid black;"><thead><tr style="background-color: rgb(241, 245, 249);"><th style="border: 1px solid black; padding: 8px;">Aspek</th><th style="border: 1px solid black; padding: 8px;">Sangat Baik (4)</th><th style="border: 1px solid black; padding: 8px;">Baik (3)</th><th style="border: 1px solid black; padding: 8px;">Cukup (2)</th><th style="border: 1px solid black; padding: 8px;">Kurang (1)</th></tr></thead><tbody><tr><td style="border: 1px solid black; padding: 8px; font-weight: bold;">Ketepatan Argumen dan Pemahaman Konsep</td><td style="border: 1px solid black; padding: 8px;"><span>Jawaban sangat akurat, argumen didukung dengan alasan ilmiah/logis yang kuat, serta menggunakan kosakata bahasa Indonesia yang baku dan tepat.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Jawaban akurat dan argumen logis, namun penyampaian bahasanya masih sedikit sederhana.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Jawaban cukup tepat, namun alasan pendukung yang dituliskan kurang lengkap atau kurang mendalam.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Jawaban salah atau tidak sesuai dengan konsep dasar perbedaan fiksi dan nonfiksi.</span></td></tr></tbody></table></div><div style="margin-top: 16px;"><p><strong>Pedoman Penskoran:</strong></p><p>Skor Total: 100</p><p>Rumus Nilai: (Skor Perolehan / Skor Maksimal) x 100</p></div></div></div></div></div><div data-v2-export-item="05e8ba7a-c6e3-4fc2-a285-a22c7e25d870:materi" data-v2-export-jenis="materi" data-v2-export-pertemuan="8" class="page-break-before" style="break-before: page;"><div data-v2-export-marker="true" style="font-size: 10pt; font-weight: 700; margin-bottom: 8px;">Pertemuan 8 — Materi</div><div class="document-preview bg-white mx-auto p-6 md:p-12 text-black" style="width: 100%; max-width: 210mm;"><div data-section="modul" style="display: none;"><div style="text-align: center; margin-bottom: 20px; border-bottom: 3px solid black; padding-bottom: 10px;"><h1 style="font-size: 16pt; font-weight: bold; margin: 0px; text-transform: uppercase;">MODUL AJAR: BAHASA INDONESIA</h1><p class="italic">Materi: Materi - Kelas Kelas</p></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">I. IDENTIFIKASI DASAR</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Identitas Umum</td><td style="border: 1px solid black; padding: 6px; vertical-align: top;"><div><strong>Nama Penyusun:</strong> Guru</div><div><strong>Sekolah:</strong> Sekolah</div><div><strong>Mata Pelajaran:</strong> Bahasa Indonesia</div><div><strong>Materi:</strong> Materi </div><div><strong>Kelas/Fase:</strong> Kelas / Fase</div><div><strong>Semester:</strong> 1</div><div><strong>Jumlah Pertemuan:</strong> 32 (0 Menit)</div></td></tr><tr style="background-color: rgb(219, 234, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">II. IDENTIFIKASI MURID</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Pengetahuan Awal</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Minat</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Latar Belakang</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Kebutuhan Belajar</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(209, 250, 229);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">III. JENIS PENGETAHUAN MATERI</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Faktual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Konseptual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Prosedural</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metakognitif</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Kaitan dengan Kehidupan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(254, 243, 199);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IV. INTEGRASI NILAI &amp; KARAKTER</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Nilai Karakter</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(224, 231, 255);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">V. DIMENSI PROFIL LULUSAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">DPL yang Dikembangkan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr></tbody></table><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VI. DESAIN PEMBELAJARAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Capaian Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Tujuan Pembelajaran</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Pemahaman Bermakna</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Model Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metode Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(240, 253, 244);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VII. LINTAS DISIPLIN ILMU</td></tr><tr style="background-color: rgb(252, 231, 243);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VIII. KEMITRAAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(207, 250, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IX. LINGKUNGAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(237, 233, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">X. PEMANFAATAN DIGITAL</td></tr></tbody></table><div style="margin-bottom: 30px;"><div style="background-color: rgb(226, 232, 240); padding: 8px; font-weight: bold; margin-bottom: 16px; border: 1px solid black;">XI. PENGALAMAN BELAJAR (LANGKAH PEMBELAJARAN)</div><div style="padding: 20px; text-align: center; color: rgb(107, 114, 128); border: 1px solid black;">Langkah pembelajaran akan muncul setelah generate modul</div></div><table style="width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin-top: 50px;"><tbody><tr><td style="width: 50%; text-align: center; vertical-align: top;">Mengetahui,<br>Kepala Sekolah<br><br><br><br><strong>...........................</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td><td style="width: 50%; text-align: center; vertical-align: top;">Guru Mata Pelajaran<br><br><br><br><br><strong>Guru</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td></tr></tbody></table></div><div data-section="materi" style="display: block; margin-top: 40px;"><div style=""></div><h2 style="text-align: center; font-weight: bold; font-size: 18pt; color: rgb(204, 85, 38); text-transform: uppercase; margin-bottom: 24px;">📚 Petualangan Seru di Dunia Buku: Mengenal Buku Fiksi dan Nonfiksi! 📚✨</h2><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><h3 style="font-weight: bold; font-size: 14pt; margin-bottom: 8px;">📖 Pendahuluan</h3><p style="text-align: left; line-height: 1.8; margin-bottom: 24px;"><span>Halo adik-adik pintar yang hebat! 👋 Selamat datang di petualangan membaca yang super seru! 🌟 Pernahkah kalian pergi ke perpustakaan sekolah atau toko buku? Di sana, kita akan melihat ribuan buku yang berjejer rapi di rak. Wah, rasanya seperti masuk ke pulau harta karun ya! 🤩 Ada buku yang bercerita tentang petualangan kelinci ajaib yang bisa terbang, dan ada juga buku yang menjelaskan mengapa dinosaurus punah jutaan tahun lalu. Nah, tahukah kalian bahwa buku-buku itu dibagi menjadi dua kelompok besar? Betul sekali! Namanya adalah buku fiksi dan buku nonfiksi. Mempelajari perbedaan kedua jenis buku ini sangat penting, lho! 🎯 Dengan memahaminya, kita bisa dengan mudah memilih buku yang kita butuhkan, apakah kita ingin menghibur diri dengan cerita seru atau ingin belajar fakta ilmiah yang keren untuk tugas sekolah kita. Yuk, kita mulai petualangan seru ini! 🚀</span></p></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="border: 1px solid rgb(229, 231, 235); border-radius: 8px; padding: 16px; margin-bottom: 20px;"><div style="margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid rgb(204, 85, 38); display: flex;"><span style="display: inline-block; background-color: rgb(204, 85, 38); color: white; width: 24px; height: 24px; border-radius: 4px; text-align: center; line-height: 24px; font-size: 12px; font-weight: bold; margin-right: 8px;">1</span><span style="color: rgb(204, 85, 38); font-weight: bold; font-size: 13pt;">Apa Itu Buku Fiksi?</span></div><div style="border-left: 4px solid rgb(204, 85, 38); background-color: rgb(255, 247, 237); padding: 12px 14px; margin-bottom: 12px; border-radius: 0px 6px 6px 0px;"><span style="font-weight: 600; font-size: 11pt;">🎯 <span>Buku fiksi adalah buku berisi cerita khayalan atau tidak nyata dari imajinasi penulis. 🧚‍♀️</span></span></div><div style="text-align: left; line-height: 1.8; margin-bottom: 12px;">Bayangkan sebuah dunia di mana boneka kesayanganmu bisa berbicara saat kamu tidur, atau kucing peliharaanmu bisa memakai jubah pahlawan super! 🐱✨ Nah, semua keajaiban itu bisa kita temukan di dalam buku fiksi. Buku fiksi adalah buku yang ditulis berdasarkan imajinasi atau khayalan kreatif dari penulisnya. Jadi, cerita di dalamnya tidak benar-benar terjadi di dunia nyata ya, adik-adik! Tujuan utama dari buku fiksi adalah untuk menghibur kita dan membawa kita berpetualang ke dunia mimpi yang indah. Penulis buku fiksi biasanya menggunakan bahasa yang indah, kiasan, dan penuh perasaan agar kita bisa ikut merasakan kesedihan, kegembiraan, dan ketegangan yang dialami oleh tokoh-tokohnya. Seru sekali, kan? 🌟</div><div style="background-color: rgb(243, 244, 246); padding: 12px 14px; margin-bottom: 8px; border-radius: 6px;"><div style="font-weight: 600; margin-bottom: 6px;">📝 Bedah Contoh:</div><div style="line-height: 1.7;">Berikut adalah contoh-contoh buku fiksi yang sering kita temui sehari-hari: <ul><li>Buku cerita dongeng seperti 'Kancil dan Buaya' atau 'Cinderella' 🦊</li><li>Buku cerita komik pahlawan super kesayanganmu 🦸‍♂️</li><li>Novel anak tentang petualangan mencari harta karun di pulau misterius 🏴‍☠️</li></ul></div></div><div style="clear: both;"></div></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="border: 1px solid rgb(229, 231, 235); border-radius: 8px; padding: 16px; margin-bottom: 20px;"><div style="margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid rgb(204, 85, 38); display: flex;"><span style="display: inline-block; background-color: rgb(204, 85, 38); color: white; width: 24px; height: 24px; border-radius: 4px; text-align: center; line-height: 24px; font-size: 12px; font-weight: bold; margin-right: 8px;">2</span><span style="color: rgb(204, 85, 38); font-weight: bold; font-size: 13pt;">Apa Itu Buku Nonfiksi?</span></div><div style="border-left: 4px solid rgb(204, 85, 38); background-color: rgb(255, 247, 237); padding: 12px 14px; margin-bottom: 12px; border-radius: 0px 6px 6px 0px;"><span style="font-weight: 600; font-size: 11pt;">🎯 <span>Buku nonfiksi adalah buku berisi informasi asli, nyata, dan berdasarkan fakta ilmiah. 🗺️</span></span></div><div style="text-align: left; line-height: 1.8; margin-bottom: 12px;">Jika buku fiksi membawa kita terbang ke dunia khayalan, maka buku nonfiksi mengajak kita menjelajahi dunia nyata yang penuh dengan ilmu pengetahuan luar biasa! 🌍💡 Buku nonfiksi adalah buku yang ditulis berdasarkan fakta, kenyataan, dan data ilmiah yang benar-benar ada. Penulis tidak boleh mengarang cerita di dalam buku ini, melainkan harus melakukan penelitian atau pengamatan terlebih dahulu. Bahasa yang digunakan dalam buku nonfiksi sangat jelas, jujur, dan langsung pada intinya agar kita mudah memahami informasi yang disampaikan. Buku ini sangat berguna saat kita ingin belajar tentang cara kerja alam semesta, sejarah perjuangan bangsa Indonesia, atau cara merawat hewan peliharaan kita di rumah. Sungguh bermanfaat! 📝</div><div style="background-color: rgb(243, 244, 246); padding: 12px 14px; margin-bottom: 8px; border-radius: 6px;"><div style="font-weight: 600; margin-bottom: 6px;">📝 Bedah Contoh:</div><div style="line-height: 1.7;">Berikut adalah contoh buku nonfiksi yang bisa membantu kita belajar: <ul><li>Buku pelajaran Bahasa Indonesia kelas IV yang kita gunakan saat ini 📘</li><li>Ensiklopedia bergambar tentang kehidupan hewan di bawah laut 🦈</li><li>Buku panduan cara menanam bunga mawar di halaman rumah 🌹</li></ul></div></div><div style="clear: both;"></div></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="border: 1px solid rgb(229, 231, 235); border-radius: 8px; padding: 16px; margin-bottom: 20px;"><div style="margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid rgb(204, 85, 38); display: flex;"><span style="display: inline-block; background-color: rgb(204, 85, 38); color: white; width: 24px; height: 24px; border-radius: 4px; text-align: center; line-height: 24px; font-size: 12px; font-weight: bold; margin-right: 8px;">3</span><span style="color: rgb(204, 85, 38); font-weight: bold; font-size: 13pt;">Model Teks: Petualangan Kiko si Kelinci dan Wortel Raksasa</span></div><div style="border-left: 4px solid rgb(204, 85, 38); background-color: rgb(255, 247, 237); padding: 12px 14px; margin-bottom: 12px; border-radius: 0px 6px 6px 0px;"><span style="font-weight: 600; font-size: 11pt;">🎯 <span>Mari kita baca contoh teks fiksi berikut untuk memahami strukturnya. 📖</span></span></div><div style="text-align: left; line-height: 1.8; margin-bottom: 12px;">Di sebuah hutan hijau yang sangat indah bernama Hutan Rimba, hiduplah seekor kelinci kecil bernama Kiko. Kiko memiliki bulu putih selembut kapas dan telinga panjang yang selalu bergerak-gerak lucu. Suatu pagi yang cerah, Kiko berjalan-jalan mencari makan di dekat sungai yang airnya jernih sekali. Tiba-tiba, matanya terbelalak melihat sebuah wortel emas berukuran raksasa tertanam di balik semak-semak yang rimbun. 'Wah, besar sekali wortel ini! Aku pasti kenyang seminggu!' teriak Kiko gembira. Namun, Kiko teringat pesan ibunya untuk selalu berbagi dengan teman. Kiko tidak memakan wortel itu sendirian. Ia langsung berlari memanggil sahabat karibnya, Tupi si tupai, untuk mencabut wortel itu bersama-sama. Mereka berdua bekerja keras menarik wortel itu bersama: tarik → tarik → cabut! Akhirnya, dengan sekali hentakan kuat, wortel raksasa itu berhasil tercabut dari tanah. Kiko membagi wortel raksasa itu menjadi dua bagian yang sama besar untuknya dan Tupi. Mereka berdua memakan wortel itu bersama-sama dengan hati yang sangat gembira di bawah pohon yang rindang.</div><div style="background-color: rgb(243, 244, 246); padding: 12px 14px; margin-bottom: 8px; border-radius: 6px;"><div style="font-weight: 600; margin-bottom: 6px;">🔍 Analisis Struktur:</div><div style="line-height: 1.7;">Ayo kita bedah struktur cerita Kiko di atas agar kita semakin paham: <ul><li><b>Bagian Awal (Orientasi):</b> Paragraf 1 memperkenalkan tokoh utama yaitu Kiko si kelinci yang lucu dan latar tempatnya di Hutan Rimba.</li><li><b>Bagian Tengah (Komplikasi):</b> Paragraf 2 menceritakan kejadian menarik saat Kiko menemukan wortel emas raksasa dan usahanya mengajak Tupi bekerja keras mencabutnya.</li><li><b>Bagian Akhir (Resolusi):</b> Paragraf 3 menceritakan penyelesaian cerita di mana Kiko berbagi wortel secara adil dan mereka makan bersama dengan gembira.</li></ul> Kosakata penting yang kita temukan: <ul><li><b>Terbelalak:</b> Membuka mata lebar-lebar karena sangat terkejut atau heran.</li><li><b>Raksasa:</b> Ukuran atau bentuk yang luar biasa besar, jauh melebihi ukuran normal.</li></ul></div></div><div style="clear: both;"></div></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="border: 1px solid rgb(229, 231, 235); border-radius: 8px; padding: 16px; margin-bottom: 20px;"><div style="margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid rgb(204, 85, 38); display: flex;"><span style="display: inline-block; background-color: rgb(204, 85, 38); color: white; width: 24px; height: 24px; border-radius: 4px; text-align: center; line-height: 24px; font-size: 12px; font-weight: bold; margin-right: 8px;">4</span><span style="color: rgb(204, 85, 38); font-weight: bold; font-size: 13pt;">Ciri-Ciri Fisik: Cara Membedakan Buku dari Luar</span></div><div style="border-left: 4px solid rgb(204, 85, 38); background-color: rgb(255, 247, 237); padding: 12px 14px; margin-bottom: 12px; border-radius: 0px 6px 6px 0px;"><span style="font-weight: 600; font-size: 11pt;">🎯 <span>Kita bisa membedakan buku fiksi dan nonfiksi dari sampul, gambar, dan tata letaknya. 🎨</span></span></div><div style="text-align: left; line-height: 1.8; margin-bottom: 12px;">Adik-adik, tahukah kalian bahwa kita bisa menebak apakah sebuah buku itu fiksi atau nonfiksi hanya dengan melihat bagian luarnya saja? 🕵️‍♂️ Wah, hebat sekali kan! Ini disebut dengan mengamati ciri fisik buku. Buku fiksi biasanya memiliki sampul (cover) yang sangat ceria, penuh warna, dan menggunakan gambar ilustrasi kartun atau lukisan indah yang memancing imajinasi kita. Judulnya pun sering kali unik dan puitis. Sebaliknya, buku nonfiksi cenderung menampilkan foto asli atau gambar diagram yang nyata pada sampulnya. Judul buku nonfiksi biasanya sangat jelas dan langsung menunjukkan isi buku, seperti 'Kamus Pintar Bahasa Indonesia' atau 'Mengenal Tata Surya'. Jadi, sebelum membaca isinya, mata kreatif kita sudah bisa menebak jenis bukunya! 👁️✨</div><div style="background-color: rgb(243, 244, 246); padding: 12px 14px; margin-bottom: 8px; border-radius: 6px;"><div style="font-weight: 600; margin-bottom: 6px;">📝 Bedah Contoh:</div><div style="line-height: 1.7;">Mari kita bandingkan dua buku di meja belajar: <ul><li><b>Buku A:</b> Memiliki sampul gambar naga terbang berwarna ungu dengan judul berwarna emas berkilau. Ini adalah ciri fisik <b>buku fiksi</b>! 🐉</li><li><b>Buku B:</b> Memiliki sampul foto asli planet Bumi dari luar angkasa dengan tulisan tebal berwarna putih. Ini adalah ciri fisik <b>buku nonfiksi</b>! 🌍</li></ul></div></div><div style="clear: both;"></div></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="border: 1px solid rgb(229, 231, 235); border-radius: 8px; padding: 16px; margin-bottom: 20px;"><div style="margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid rgb(204, 85, 38); display: flex;"><span style="display: inline-block; background-color: rgb(204, 85, 38); color: white; width: 24px; height: 24px; border-radius: 4px; text-align: center; line-height: 24px; font-size: 12px; font-weight: bold; margin-right: 8px;">5</span><span style="color: rgb(204, 85, 38); font-weight: bold; font-size: 13pt;">Detektif Buku: Membandingkan Isi Buku</span></div><div style="border-left: 4px solid rgb(204, 85, 38); background-color: rgb(255, 247, 237); padding: 12px 14px; margin-bottom: 12px; border-radius: 0px 6px 6px 0px;"><span style="font-weight: 600; font-size: 11pt;">🎯 <span>Buku fiksi memakai bahasa kiasan, sedangkan buku nonfiksi memakai bahasa lugas dan nyata. 🔍</span></span></div><div style="text-align: left; line-height: 1.8; margin-bottom: 12px;">Sekarang, mari kita buka lembaran di dalam buku dan menjadi detektif kata! 🕵️‍♀️ Isi di dalam buku fiksi dan nonfiksi sangat berbeda, lho. Di dalam buku fiksi, kita akan menemukan unsur cerita seperti tokoh (pemeran cerita), watak (sifat tokoh), alur (jalan cerita dari awal hingga akhir), dan amanat (pesan moral). Bahasanya sering menggunakan perumpamaan yang indah. Sedangkan di dalam buku nonfiksi, kita tidak akan menemukan tokoh khayalan. Isinya berupa bab-bab penjelasan yang disertai data ilmiah, grafik, tabel, atau foto pendukung. Buku nonfiksi juga biasanya dilengkapi dengan daftar pustaka (sumber penulisan) dan indeks (daftar kata penting di bagian belakang buku) untuk memudahkan pembaca mencari informasi secara cepat. Hebat sekali perbedaan mereka, ya! 📚</div><div style="background-color: rgb(243, 244, 246); padding: 12px 14px; margin-bottom: 8px; border-radius: 6px;"><div style="font-weight: 600; margin-bottom: 6px;">📝 Bedah Contoh:</div><div style="line-height: 1.7;">Mari kita perhatikan perbedaan kalimat dari kedua jenis buku ini: <ul><li><b>Kalimat Fiksi:</b> 'Sang rembulan tersenyum ramah menyapa malam yang dingin.' (Menggunakan bahasa kiasan seolah bulan bisa tersenyum). 🌙</li><li><b>Kalimat Nonfiksi:</b> 'Bulan adalah satelit alami Bumi yang tidak memancarkan cahayanya sendiri.' (Menggunakan bahasa lugas berdasarkan fakta ilmiah). ☄️</li></ul></div></div><div style="clear: both;"></div></div></div><div style="margin-top: 24px;"><h3 style="font-weight: bold; font-size: 14pt; margin-bottom: 8px;">💡 Tahukah Kamu?</h3><p style="text-align: left; line-height: 1.8; background-color: rgb(254, 252, 232); padding: 12px;"><span><ul><li>Membaca buku fiksi ternyata bisa melatih rasa empati kita, lho! Kita jadi lebih mudah menyayangi teman karena terbiasa merasakan perasaan tokoh di dalam cerita. ❤️</li><li>Buku fiksi terlaris sepanjang masa adalah seri novel petualangan penyihir cilik Harry Potter, sedangkan buku nonfiksi yang paling banyak dicetak di dunia adalah kitab suci dan kamus! 🌍📖</li></ul></span></p></div><div style="margin-top: 24px;"><h3 style="font-weight: bold; font-size: 14pt; margin-bottom: 12px;">📖 Glosarium</h3><table style="width: 100%; border-collapse: collapse; border: 1px solid rgb(229, 231, 235);"><thead><tr style="background-color: rgb(243, 244, 246);"><th style="border: 1px solid rgb(229, 231, 235); padding: 8px; text-align: left; width: 30%;">Istilah</th><th style="border: 1px solid rgb(229, 231, 235); padding: 8px; text-align: left;">Definisi</th></tr></thead><tbody><tr><td style="border: 1px solid rgb(229, 231, 235); padding: 8px; font-weight: bold;">Fiksi</td><td style="border: 1px solid rgb(229, 231, 235); padding: 8px;">Karya sastra yang berisi cerita rekaan atau khayalan penulis dan tidak berdasarkan kenyataan nyata.</td></tr><tr><td style="border: 1px solid rgb(229, 231, 235); padding: 8px; font-weight: bold;">Nonfiksi</td><td style="border: 1px solid rgb(229, 231, 235); padding: 8px;">Karya tulis yang menyajikan informasi, data, atau peristiwa nyata berdasarkan fakta ilmiah.</td></tr><tr><td style="border: 1px solid rgb(229, 231, 235); padding: 8px; font-weight: bold;">Imajinasi</td><td style="border: 1px solid rgb(229, 231, 235); padding: 8px;">Kemampuan berpikir untuk menciptakan khayalan atau gambaran kejadian di dalam pikiran.</td></tr><tr><td style="border: 1px solid rgb(229, 231, 235); padding: 8px; font-weight: bold;">Fakta</td><td style="border: 1px solid rgb(229, 231, 235); padding: 8px;">Keadaan atau peristiwa yang benar-benar ada dan terjadi di dunia nyata.</td></tr></tbody></table></div><div style="margin-top: 24px;"><h3 style="font-weight: bold; font-size: 11pt; margin-bottom: 8px;">📚 Referensi</h3><ul style="margin: 0px; padding-left: 20px; font-size: 10pt;"><li>Buku Panduan Guru Bahasa Indonesia: Lihat Sekitar untuk SD Kelas IV, Kementerian Pendidikan, Kebudayaan, Riset, dan Teknologi Republik Indonesia, 2021.</li><li>Buku Siswa Bahasa Indonesia: Lihat Sekitar untuk SD Kelas IV, Kementerian Pendidikan, Kebudayaan, Riset, dan Teknologi Republik Indonesia, 2021.</li><li>Pusat Pembinaan Bahasa dan Sastra, Badan Pengembangan dan Pembinaan Bahasa, Kementerian Pendidikan dan Kebudayaan.</li></ul></div></div></div></div><div data-v2-export-item="05e8ba7a-c6e3-4fc2-a285-a22c7e25d870:refleksi" data-v2-export-jenis="refleksi" data-v2-export-pertemuan="8" class="page-break-before" style="break-before: page;"><div data-v2-export-marker="true" style="font-size: 10pt; font-weight: 700; margin-bottom: 8px;">Pertemuan 8 — Refleksi</div><div class="document-preview bg-white mx-auto p-6 md:p-12 text-black" style="width: 100%; max-width: 210mm;"><div data-section="modul" style="display: none;"><div style="text-align: center; margin-bottom: 20px; border-bottom: 3px solid black; padding-bottom: 10px;"><h1 style="font-size: 16pt; font-weight: bold; margin: 0px; text-transform: uppercase;">MODUL AJAR: BAHASA INDONESIA</h1><p class="italic">Materi: Materi - Kelas Kelas</p></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">I. IDENTIFIKASI DASAR</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Identitas Umum</td><td style="border: 1px solid black; padding: 6px; vertical-align: top;"><div><strong>Nama Penyusun:</strong> Guru</div><div><strong>Sekolah:</strong> Sekolah</div><div><strong>Mata Pelajaran:</strong> Bahasa Indonesia</div><div><strong>Materi:</strong> Materi </div><div><strong>Kelas/Fase:</strong> Kelas / Fase</div><div><strong>Semester:</strong> 1</div><div><strong>Jumlah Pertemuan:</strong> 32 (0 Menit)</div></td></tr><tr style="background-color: rgb(219, 234, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">II. IDENTIFIKASI MURID</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Pengetahuan Awal</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Minat</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Latar Belakang</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Kebutuhan Belajar</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(209, 250, 229);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">III. JENIS PENGETAHUAN MATERI</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Faktual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Konseptual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Prosedural</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metakognitif</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Kaitan dengan Kehidupan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(254, 243, 199);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IV. INTEGRASI NILAI &amp; KARAKTER</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Nilai Karakter</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(224, 231, 255);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">V. DIMENSI PROFIL LULUSAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">DPL yang Dikembangkan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr></tbody></table><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VI. DESAIN PEMBELAJARAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Capaian Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Tujuan Pembelajaran</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Pemahaman Bermakna</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Model Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metode Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(240, 253, 244);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VII. LINTAS DISIPLIN ILMU</td></tr><tr style="background-color: rgb(252, 231, 243);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VIII. KEMITRAAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(207, 250, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IX. LINGKUNGAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(237, 233, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">X. PEMANFAATAN DIGITAL</td></tr></tbody></table><div style="margin-bottom: 30px;"><div style="background-color: rgb(226, 232, 240); padding: 8px; font-weight: bold; margin-bottom: 16px; border: 1px solid black;">XI. PENGALAMAN BELAJAR (LANGKAH PEMBELAJARAN)</div><div style="padding: 20px; text-align: center; color: rgb(107, 114, 128); border: 1px solid black;">Langkah pembelajaran akan muncul setelah generate modul</div></div><table style="width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin-top: 50px;"><tbody><tr><td style="width: 50%; text-align: center; vertical-align: top;">Mengetahui,<br>Kepala Sekolah<br><br><br><br><strong>...........................</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td><td style="width: 50%; text-align: center; vertical-align: top;">Guru Mata Pelajaran<br><br><br><br><br><strong>Guru</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td></tr></tbody></table></div><div data-section="tindakLanjut" style="display: block; margin-top: 40px;"><h2 style="text-align: center; font-weight: bold; font-size: 14pt; margin-bottom: 20px; text-transform: uppercase;">Refleksi &amp; Tindak Lanjut</h2><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 16px;"><thead><tr style="background-color: rgb(254, 202, 202);"><th style="border: 1px solid black; padding: 12px;">Remedial</th></tr></thead><tbody><tr><td style="border: 1px solid black; padding: 16px; vertical-align: top;"><span><p style="margin:6px 0">Diagnosis kesulitan menunjukkan bahwa beberapa peserta didik masih keliru membedakan sistematika isi spesifik, seperti keberadaan indeks, glosarium, dan daftar pustaka yang hanya ada pada buku nonfiksi. Strategi remedial difokuskan pada pendekatan klinis melalui bimbingan kelompok kecil (scaffolding) dengan menyajikan objek nyata secara langsung untuk mengurangi abstraksi berpikir.</p><p style="margin:6px 0">Kegiatan inti remedial dilakukan melalui metode 'Tunjuk Fitur' selama 15 menit. Guru memberikan satu buku fiksi dan satu buku nonfiksi konkret kepada siswa, lalu meminta mereka menempelkan sticky notes berwarna pada bagian-bagian khas seperti daftar isi, glosarium, atau halaman hak cipta, dilanjutkan dengan mengisi tabel komparasi sederhana.</p><p style="margin:6px 0">Program remedial ini diintegrasikan dengan kegiatan kunjungan perpustakaan mingguan. Perkembangan siswa akan dipantau melalui kartu kendali membaca, di mana mereka diminta menuliskan satu ciri fisik pembeda dari buku yang mereka pinjam sebelum divalidasi oleh guru atau pustakawan.</p></span></td></tr></tbody></table></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black;"><thead><tr style="background-color: rgb(209, 250, 229);"><th style="border: 1px solid black; padding: 12px;">Pengayaan</th></tr></thead><tbody><tr><td style="border: 1px solid black; padding: 16px; vertical-align: top;"><span><p style="margin:6px 0">Program pengayaan dirancang untuk peserta didik yang telah mencapai ketuntasan cepat dalam membedakan buku fiksi dan nonfiksi. Strategi yang digunakan adalah perluasan pemahaman melalui analisis kritis terhadap aspek kebahasaan (gaya bahasa figuratif vs. denotatif) dan tujuan komunikatif dari kedua jenis buku tersebut.</p><p style="margin:6px 0">Siswa diberikan aktivitas mandiri berupa 'Analisis Komparatif Resensi'. Mereka diminta membaca dua buah sinopsis atau resensi buku (fiksi dan nonfiksi), kemudian menyusun sebuah infografis atau peta konsep digital yang membandingkan bagaimana fakta dan imajinasi disajikan oleh masing-masing penulis.</p><p style="margin:6px 0">Hasil karya infografis siswa akan diintegrasikan sebagai materi pajangan pada mading kelas atau diunggah di platform belajar digital sekolah. Hal ini bertujuan untuk memberikan apresiasi sekaligus menjadi sumber belajar tambahan bagi rekan sejawat dalam memahami perbedaan buku fiksi dan nonfiksi secara visual.</p></span></td></tr></tbody></table></div></div></div></div></div></body></html>