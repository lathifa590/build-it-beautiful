<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns:m='http://schemas.openxmlformats.org/officeDocument/2006/math' xmlns='http://www.w3.org/TR/REC-html40'><head><meta charset='utf-8'><title>Pertemuan 9 — </title><style>
/* Reset dasar */
*{box-sizing:border-box;margin:0;padding:0;min-height:0!important;max-height:none!important;
  height:auto!important;flex:none!important;overflow:visible!important;
  position:static!important;float:none!important}
/* Typography */
body{font-family:'Arial',sans-serif;font-size:11pt;line-height:1.5;color:#000;background:#fff}
/* Tables */
table{width:100%!important;border-collapse:collapse!important;margin-bottom:12px;
  display:table!important;table-layout:fixed!important}
tr{display:table-row!important}
td,th{border:1px solid #000;padding:6px 8px;vertical-align:top;
  display:table-cell!important;word-wrap:break-word;overflow-wrap:break-word}
/* Headings */
h1{font-size:16pt;font-weight:bold;margin:12px 0 6px}
h2{font-size:14pt;font-weight:bold;margin:10px 0 5px}
h3{font-size:12pt;font-weight:bold;margin:8px 0 4px}
h4,h5,h6{font-size:11pt;font-weight:bold;margin:6px 0 3px}
/* Paragraphs & lists */
p{margin:4px 0;line-height:1.5}
ul,ol{margin:6px 0;padding-left:20px}
li{margin:2px 0}
/* Inline */
sup{vertical-align:super;font-size:0.75em}
sub{vertical-align:sub;font-size:0.75em}
b,strong{font-weight:bold}
i,em{font-style:italic}
u{text-decoration:underline}
/* Images */
img{max-width:100%;display:block}
/* Page breaks (dikendalikan pruneV2ExportSections) */
.page-break-before{page-break-before:always!important;break-before:page!important}
/* Section wrappers */
[data-v2-export-item]{display:block!important}
/* Div/span umum */
div,span,section,article,main,header,footer,nav,aside{display:block}
</style></head><body><div data-v2-export-root="true"><div data-v2-export-item="ff56b58c-7106-4836-a426-1a001be63173:modul" data-v2-export-jenis="modul" data-v2-export-pertemuan="9"><div data-v2-export-marker="true" style="font-size: 10pt; font-weight: 700; margin-bottom: 8px;">Pertemuan 9 — Modul</div><div class="document-preview bg-white mx-auto p-6 md:p-12 text-black" style="width: 100%; max-width: 210mm;"><div data-section="modul" style="display: block;"><div style="text-align: center; margin-bottom: 20px; border-bottom: 3px solid black; padding-bottom: 10px;"><h1 style="font-size: 16pt; font-weight: bold; margin: 0px; text-transform: uppercase;">MODUL AJAR: BAHASA INDONESIA</h1><p class="italic">Materi: Materi - Kelas Kelas</p></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">I. IDENTIFIKASI DASAR</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Identitas Umum</td><td style="border: 1px solid black; padding: 6px; vertical-align: top;"><div><strong>Nama Penyusun:</strong> Guru</div><div><strong>Sekolah:</strong> Sekolah</div><div><strong>Mata Pelajaran:</strong> Bahasa Indonesia</div><div><strong>Materi:</strong> Materi </div><div><strong>Kelas/Fase:</strong> Kelas / Fase</div><div><strong>Semester:</strong> 1</div><div><strong>Jumlah Pertemuan:</strong> 32 (0 Menit)</div></td></tr><tr style="background-color: rgb(219, 234, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">II. IDENTIFIKASI MURID</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Pengetahuan Awal</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Minat</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Latar Belakang</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Kebutuhan Belajar</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(209, 250, 229);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">III. JENIS PENGETAHUAN MATERI</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Faktual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Konseptual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Prosedural</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metakognitif</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Kaitan dengan Kehidupan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(254, 243, 199);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IV. INTEGRASI NILAI &amp; KARAKTER</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Nilai Karakter</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(224, 231, 255);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">V. DIMENSI PROFIL LULUSAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">DPL yang Dikembangkan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr></tbody></table><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VI. DESAIN PEMBELAJARAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Capaian Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Tujuan Pembelajaran</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Pemahaman Bermakna</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Model Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metode Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(240, 253, 244);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VII. LINTAS DISIPLIN ILMU</td></tr><tr style="background-color: rgb(252, 231, 243);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VIII. KEMITRAAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(207, 250, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IX. LINGKUNGAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(237, 233, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">X. PEMANFAATAN DIGITAL</td></tr></tbody></table><div style="margin-bottom: 30px;"><div style="background-color: rgb(226, 232, 240); padding: 8px; font-weight: bold; margin-bottom: 16px; border: 1px solid black;">XI. PENGALAMAN BELAJAR (LANGKAH PEMBELAJARAN)</div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black; table-layout: fixed;"><colgroup><col style="width: 18%;"><col style="width: 67%;"><col style="width: 15%;"></colgroup><tbody><tr style="background-color: rgb(241, 245, 249); text-align: center;"><th style="border: 1px solid black; padding: 6px;">TAHAP</th><th style="border: 1px solid black; padding: 6px;">KEGIATAN &amp; PRINSIP</th><th style="border: 1px solid black; padding: 6px;">DURASI</th></tr><tr style="background-color: rgb(199, 210, 254);"><td colspan="3" style="border: 1px solid black; padding: 8px; font-weight: bold; text-align: center;">PERTEMUAN 1 (70 Menit)</td></tr><tr><td rowspan="3" style="border: 1px solid black; padding: 8px; font-weight: bold; text-align: center; vertical-align: top; background-color: rgb(219, 234, 254);">Pendahuluan</td><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Orientasi</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Salam dan Doa (2 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru mengucapkan salam pembuka yang ceria.</span></li><li style="font-size: 0.9em;"><span>Guru mengajak seluruh murid untuk memanjatkan doa bersama sebagai bentuk rasa syukur dan memohon kelancaran pembelajaran.</span></li><li style="font-size: 0.9em;"><span>Salah satu murid secara bergantian memimpin doa penutup.</span></li></ul></div><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Penyampaian Tujuan Pembelajaran (3 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru menanyakan apa yang sudah diketahui murid tentang cerita.</span></li><li style="font-size: 0.9em;"><span>Murid berbagi pengetahuan awal mereka tentang elemen-elemen dalam cerita.</span></li><li style="font-size: 0.9em;"><span>Guru menyampaikan tujuan pembelajaran hari ini secara jelas: 'Hari ini kita akan belajar menemukan siapa saja tokoh dalam cerita, di mana latar cerita terjadi, dan bagaimana alur ceritanya berkembang hanya dengan mendengarkan.'</span></li><li style="font-size: 0.9em;"><span>Guru menekankan bahwa pemahaman ini akan membuat mereka menjadi pendengar cerita yang lebih baik.</span></li></ul></div><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Pengenalan Topik dengan Media (2 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru memperdengarkan cuplikan pendek dari sebuah cerita audio yang menarik.</span></li><li style="font-size: 0.9em;"><span>Murid mendengarkan dengan seksama cuplikan cerita tersebut.</span></li><li style="font-size: 0.9em;"><span>Guru mengajukan pertanyaan pemantik untuk memicu rasa ingin tahu murid.</span></li><li style="font-size: 0.9em;"><span>Murid memberikan respon awal mereka.</span></li></ul><div style="margin-left: 12px; background-color: rgb(254, 243, 199); padding: 6px 8px; border-radius: 4px; margin-top: 4px;"><span style="font-weight: 500; color: rgb(217, 119, 6); font-size: 0.85em;">💡 Pertanyaan Pemantik:</span><ul style="margin-left: 16px; margin-top: 2px; list-style-type: none; margin-bottom: 0px;"><li style="font-size: 0.85em; font-style: italic;">"<span>Siapa saja yang kalian dengar dalam cerita tadi?</span>"</li><li style="font-size: 0.85em; font-style: italic;">"<span>Di mana kira-kira cerita itu terjadi?</span>"</li></ul></div></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Membangun kesadaran (Mindful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">7 menit</td></tr><tr><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Apersepsi</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Mengaitkan dengan Pengalaman Sehari-hari (5 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru bertanya kepada murid, 'Kapan terakhir kali kalian mendengarkan cerita? Cerita apa itu?'</span></li><li style="font-size: 0.9em;"><span>Murid diminta berbagi pengalaman mereka mendengarkan atau bercerita.</span></li><li style="font-size: 0.9em;"><span>Guru mengaitkan pengalaman murid dengan pentingnya memahami unsur-unsur cerita agar cerita lebih mudah dipahami dan dinikmati.</span></li></ul><div style="margin-left: 12px; background-color: rgb(254, 243, 199); padding: 6px 8px; border-radius: 4px; margin-top: 4px;"><span style="font-weight: 500; color: rgb(217, 119, 6); font-size: 0.85em;">💡 Pertanyaan Pemantik:</span><ul style="margin-left: 16px; margin-top: 2px; list-style-type: none; margin-bottom: 0px;"><li style="font-size: 0.85em; font-style: italic;">"<span>Apakah kalian suka mendengarkan cerita? Cerita seperti apa yang kalian sukai?</span>"</li><li style="font-size: 0.85em; font-style: italic;">"<span>Menurut kalian, mengapa penting untuk mengetahui siapa saja yang ada dalam cerita dan di mana cerita itu terjadi?</span>"</li></ul></div></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Bermakna (Meaningful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">5 menit</td></tr><tr><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Motivasi</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Perkenalan Tokoh Lucu (3 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru menampilkan gambar atau boneka dari tokoh cerita yang akan diperdengarkan.</span></li><li style="font-size: 0.9em;"><span>Guru memeragakan suara atau tingkah lucu dari salah satu tokoh.</span></li><li style="font-size: 0.9em;"><span>Murid tertawa dan menunjukkan antusiasme untuk mendengar cerita lengkapnya.</span></li></ul></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Menggembirakan (Joyful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">3 menit</td></tr><tr style="background-color: rgb(209, 250, 229);"><td colspan="3" style="border: 1px solid black; padding: 8px; font-weight: bold; text-align: center;">TAHAP INTI - INTI<div style="font-size: 0.85em; font-weight: normal; margin-top: 4px;">Durasi Total: 45 menit | Bermakna, Membangun kesadaran, Menggembirakan</div></td></tr><tr style="background-color: rgb(241, 245, 249);"><th style="border: 1px solid black; padding: 6px; width: 15%;">FASE</th><th style="border: 1px solid black; padding: 6px;">KEGIATAN &amp; PRINSIP</th><th style="border: 1px solid black; padding: 6px; width: 10%;">DURASI</th></tr><tr><td rowspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold; text-align: center; vertical-align: top; background-color: rgb(209, 250, 229); width: 15%;"><div style="font-size: 1.1em;">🔍 MEMAHAMI</div><div style="font-size: 0.85em; font-weight: normal; margin-top: 4px; font-style: italic;">(20 menit)</div><div style="font-size: 0.8em; font-weight: normal; margin-top: 4px; color: rgb(5, 150, 105);">★ Bermakna, Membangun kesadaran (Meaningful, Mindful)</div></td><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Stimulasi (Pemberian Rangsangan)</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Mendengarkan Cerita Utuh (10 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru memperdengarkan seluruh cerita audio secara utuh dengan intonasi yang menarik.</span></li><li style="font-size: 0.9em;"><span>Murid mendengarkan dengan penuh perhatian, membayangkan tokoh dan latarnya.</span></li><li style="font-size: 0.9em;"><span>Guru memberikan isyarat kepada murid untuk mencatat hal-hal yang menarik perhatian mereka selama mendengarkan.</span></li></ul></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Bermakna (Meaningful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">10 menit</td></tr><tr><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Identifikasi Masalah (Problem Statement)</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Diskusi Awal dan Pertanyaan Pemantik (10 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru memulai diskusi dengan bertanya, 'Siapa saja yang kalian ingat ada dalam cerita tadi?'</span></li><li style="font-size: 0.9em;"><span>Murid mencoba mengingat dan menyebutkan nama-nama tokoh.</span></li><li style="font-size: 0.9em;"><span>Guru lalu bertanya, 'Di mana saja cerita itu terjadi? Apakah ada tempat lain yang disebutkan?'</span></li><li style="font-size: 0.9em;"><span>Murid berusaha mengidentifikasi latar tempat yang ada dalam cerita.</span></li><li style="font-size: 0.9em;"><span>Guru kemudian memancing pemikiran tentang alur: 'Bagaimana cerita itu dimulai? Apa yang terjadi selanjutnya?'</span></li><li style="font-size: 0.9em;"><span>Murid mencoba menceritakan kembali urutan kejadian secara singkat.</span></li></ul><div style="margin-left: 12px; background-color: rgb(254, 243, 199); padding: 6px 8px; border-radius: 4px; margin-top: 4px;"><span style="font-weight: 500; color: rgb(217, 119, 6); font-size: 0.85em;">💡 Pertanyaan Pemantik:</span><ul style="margin-left: 16px; margin-top: 2px; list-style-type: none; margin-bottom: 0px;"><li style="font-size: 0.85em; font-style: italic;">"<span>Siapa saja tokoh utama dan pendukung dalam cerita ini?</span>"</li><li style="font-size: 0.85em; font-style: italic;">"<span>Di mana saja latar cerita ini terjadi (tempat)? Kapan cerita ini terjadi (waktu)?</span>"</li><li style="font-size: 0.85em; font-style: italic;">"<span>Bagaimana urutan kejadian dalam cerita ini dari awal sampai akhir?</span>"</li></ul></div></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Membangun kesadaran (Mindful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">10 menit</td></tr><tr><td rowspan="3" style="border: 1px solid black; padding: 8px; font-weight: bold; text-align: center; vertical-align: top; background-color: rgb(254, 243, 199); width: 15%;"><div style="font-size: 1.1em;">🛠️ MENGAPLIKASI</div><div style="font-size: 0.85em; font-weight: normal; margin-top: 4px; font-style: italic;">(15 menit)</div><div style="font-size: 0.8em; font-weight: normal; margin-top: 4px; color: rgb(217, 119, 6);">★ Menggembirakan (Joyful)</div></td><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Pengumpulan Data (Data Collection)</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Mengisi Lembar Kerja Sederhana (5 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru membagikan lembar kerja sederhana yang berisi tabel untuk mengisi tokoh, latar, dan alur cerita.</span></li><li style="font-size: 0.9em;"><span>Murid secara individu atau berpasangan mulai mengisi lembar kerja berdasarkan pemahaman mereka setelah diskusi.</span></li><li style="font-size: 0.9em;"><span>Guru berkeliling memberikan bantuan jika ada murid yang kesulitan.</span></li></ul></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Menggembirakan (Joyful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">5 menit</td></tr><tr><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Pengolahan Data (Data Processing)</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Diskusi Kelompok Kecil (5 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Murid berdiskusi dalam kelompok kecil (3-4 orang) untuk membandingkan jawaban mereka di lembar kerja.</span></li><li style="font-size: 0.9em;"><span>Mereka saling bertanya dan memberikan masukan untuk melengkapi informasi yang kurang.</span></li><li style="font-size: 0.9em;"><span>Guru memfasilitasi diskusi agar berjalan kondusif.</span></li></ul></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Menggembirakan (Joyful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">5 menit</td></tr><tr><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Pembuktian (Verification)</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Presentasi Singkat Hasil Kelompok (5 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Setiap kelompok diminta mempresentasikan secara singkat hasil temuan mereka untuk satu unsur (misal: satu kelompok fokus pada tokoh, kelompok lain pada latar).</span></li><li style="font-size: 0.9em;"><span>Murid lain mendengarkan presentasi kelompok lain.</span></li></ul></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Menggembirakan (Joyful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">5 menit</td></tr><tr><td rowspan="1" style="border: 1px solid black; padding: 8px; font-weight: bold; text-align: center; vertical-align: top; background-color: rgb(219, 234, 254); width: 15%;"><div style="font-size: 1.1em;">💭 MEREFLEKSI</div><div style="font-size: 0.85em; font-weight: normal; margin-top: 4px; font-style: italic;">(10 menit)</div><div style="font-size: 0.8em; font-weight: normal; margin-top: 4px; color: rgb(37, 99, 235);">★ Membangun kesadaran (Mindful)</div></td><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Menarik Kesimpulan (Generalization)</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Diskusi Klasikal dan Penarikan Kesimpulan (7 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru mengumpulkan hasil dari setiap kelompok dan memfasilitasi diskusi kelas.</span></li><li style="font-size: 0.9em;"><span>Guru memberikan klarifikasi dan penguatan terhadap jawaban murid.</span></li><li style="font-size: 0.9em;"><span>Bersama-sama, guru dan murid merumuskan kesimpulan tentang unsur-unsur intrinsik cerita (tokoh, latar, alur).</span></li><li style="font-size: 0.9em;"><span>Guru menekankan kembali bahwa unsur-unsur ini penting untuk dipahami agar cerita lebih bermakna.</span></li></ul><div style="margin-left: 12px; background-color: rgb(254, 243, 199); padding: 6px 8px; border-radius: 4px; margin-top: 4px;"><span style="font-weight: 500; color: rgb(217, 119, 6); font-size: 0.85em;">💡 Pertanyaan Pemantik:</span><ul style="margin-left: 16px; margin-top: 2px; list-style-type: none; margin-bottom: 0px;"><li style="font-size: 0.85em; font-style: italic;">"<span>Dari diskusi tadi, apa saja yang termasuk tokoh dalam sebuah cerita?</span>"</li><li style="font-size: 0.85em; font-style: italic;">"<span>Apa yang dimaksud dengan latar cerita?</span>"</li><li style="font-size: 0.85em; font-style: italic;">"<span>Bagaimana kita bisa mengetahui urutan alur cerita?</span>"</li></ul></div></div><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Tantangan Berikutnya (3 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru memberikan gambaran singkat tentang tantangan selanjutnya, misalnya menemukan unsur intrinsik pada teks visual atau tertulis.</span></li><li style="font-size: 0.9em;"><span>Murid menunjukkan antusiasme untuk tantangan selanjutnya.</span></li></ul></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Membangun kesadaran (Mindful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">10 menit</td></tr><tr><td rowspan="3" style="border: 1px solid black; padding: 8px; font-weight: bold; text-align: center; vertical-align: top; background-color: rgb(254, 243, 199);">Penutup</td><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Refleksi Individu &amp; Kelompok</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Refleksi Pembelajaran Singkat (5 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru meminta murid untuk memikirkan dan menuliskan dalam buku catatan mereka satu hal baru yang dipelajari tentang unsur cerita hari ini.</span></li><li style="font-size: 0.9em;"><span>Murid menulis refleksi singkat.</span></li><li style="font-size: 0.9em;"><span>Beberapa murid diminta berbagi secara sukarela apa yang mereka tulis.</span></li></ul></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Membangun kesadaran (Mindful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">5 menit</td></tr><tr><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Kesimpulan Bersama</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Penguatan Konsep Utama (3 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru secara singkat mengingatkan kembali definisi tokoh, latar, dan alur.</span></li><li style="font-size: 0.9em;"><span>Guru menekankan kembali pentingnya memahami unsur-unsur ini untuk menikmati cerita.</span></li><li style="font-size: 0.9em;"><span>Murid mengangguk atau memberikan respon verbal singkat sebagai tanda pemahaman.</span></li></ul></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Bermakna (Meaningful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">3 menit</td></tr><tr><td style="border: 1px solid black; padding: 8px; vertical-align: top;"><div style="margin-bottom: 6px;"><strong>Pesan Inspiratif &amp; Apresiasi</strong></div><div style="margin-left: 8px;"><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Apresiasi dan Motivasi Penutup (1 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru memberikan apresiasi kepada seluruh murid atas partisipasi dan usaha mereka.</span></li><li style="font-size: 0.9em;"><span>Guru memberikan motivasi untuk terus berlatih mendengarkan dan mengidentifikasi unsur cerita dalam kehidupan sehari-hari.</span></li></ul></div><div style="margin-bottom: 10px; padding-left: 8px;"><div style="font-weight: 500; margin-bottom: 4px;">• Doa dan Salam Penutup (1 menit)</div><ul style="margin-left: 12px; margin-top: 2px; list-style-type: disc; margin-bottom: 4px;"><li style="font-size: 0.9em;"><span>Guru mengajak murid untuk mengakhiri pembelajaran dengan doa penutup.</span></li><li style="font-size: 0.9em;"><span>Murid memimpin doa penutup.</span></li><li style="font-size: 0.9em;"><span>Guru mengucapkan salam penutup dengan semangat.</span></li></ul></div></div><div style="color: rgb(107, 114, 128); background-color: rgb(243, 244, 246); font-size: 0.85em; margin-top: 8px; padding: 2px 8px; border-radius: 4px; display: inline-block; font-weight: 500;">★ Menggembirakan (Joyful)</div></td><td style="border: 1px solid black; padding: 8px; text-align: center; vertical-align: top;">2 menit</td></tr></tbody></table></div></div><table style="width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin-top: 50px;"><tbody><tr><td style="width: 50%; text-align: center; vertical-align: top;">Mengetahui,<br>Kepala Sekolah<br><br><br><br><strong>...........................</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td><td style="width: 50%; text-align: center; vertical-align: top;">Guru Mata Pelajaran<br><br><br><br><br><strong>Guru</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td></tr></tbody></table></div></div></div><div data-v2-export-item="ff56b58c-7106-4836-a426-1a001be63173:lkpd" data-v2-export-jenis="lkpd" data-v2-export-pertemuan="9" class="page-break-before" style="break-before: page;"><div data-v2-export-marker="true" style="font-size: 10pt; font-weight: 700; margin-bottom: 8px;">Pertemuan 9 — LKPD</div><div class="document-preview bg-white mx-auto p-6 md:p-12 text-black" style="width: 100%; max-width: 210mm;"><div data-section="modul" style="display: none;"><div style="text-align: center; margin-bottom: 20px; border-bottom: 3px solid black; padding-bottom: 10px;"><h1 style="font-size: 16pt; font-weight: bold; margin: 0px; text-transform: uppercase;">MODUL AJAR: BAHASA INDONESIA</h1><p class="italic">Materi: Materi - Kelas Kelas</p></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">I. IDENTIFIKASI DASAR</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Identitas Umum</td><td style="border: 1px solid black; padding: 6px; vertical-align: top;"><div><strong>Nama Penyusun:</strong> Guru</div><div><strong>Sekolah:</strong> Sekolah</div><div><strong>Mata Pelajaran:</strong> Bahasa Indonesia</div><div><strong>Materi:</strong> Materi </div><div><strong>Kelas/Fase:</strong> Kelas / Fase</div><div><strong>Semester:</strong> 1</div><div><strong>Jumlah Pertemuan:</strong> 32 (0 Menit)</div></td></tr><tr style="background-color: rgb(219, 234, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">II. IDENTIFIKASI MURID</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Pengetahuan Awal</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Minat</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Latar Belakang</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Kebutuhan Belajar</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(209, 250, 229);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">III. JENIS PENGETAHUAN MATERI</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Faktual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Konseptual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Prosedural</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metakognitif</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Kaitan dengan Kehidupan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(254, 243, 199);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IV. INTEGRASI NILAI &amp; KARAKTER</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Nilai Karakter</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(224, 231, 255);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">V. DIMENSI PROFIL LULUSAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">DPL yang Dikembangkan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr></tbody></table><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VI. DESAIN PEMBELAJARAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Capaian Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Tujuan Pembelajaran</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Pemahaman Bermakna</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Model Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metode Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(240, 253, 244);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VII. LINTAS DISIPLIN ILMU</td></tr><tr style="background-color: rgb(252, 231, 243);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VIII. KEMITRAAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(207, 250, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IX. LINGKUNGAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(237, 233, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">X. PEMANFAATAN DIGITAL</td></tr></tbody></table><div style="margin-bottom: 30px;"><div style="background-color: rgb(226, 232, 240); padding: 8px; font-weight: bold; margin-bottom: 16px; border: 1px solid black;">XI. PENGALAMAN BELAJAR (LANGKAH PEMBELAJARAN)</div><div style="padding: 20px; text-align: center; color: rgb(107, 114, 128); border: 1px solid black;">Langkah pembelajaran akan muncul setelah generate modul</div></div><table style="width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin-top: 50px;"><tbody><tr><td style="width: 50%; text-align: center; vertical-align: top;">Mengetahui,<br>Kepala Sekolah<br><br><br><br><strong>...........................</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td><td style="width: 50%; text-align: center; vertical-align: top;">Guru Mata Pelajaran<br><br><br><br><br><strong>Guru</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td></tr></tbody></table></div><div data-section="lkpd" style="display: block; margin-top: 40px;"><div style=""></div><h2 style="text-align: center; font-weight: bold; font-size: 14pt; margin-bottom: 4px;">LEMBAR KERJA PESERTA DIDIK</h2><p style="text-align: center; font-size: 10pt; margin-bottom: 24px;">Model: Deep Learning 2026</p><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-bottom: 24px;"><h3 style="font-weight: bold; font-size: 12pt; margin-bottom: 12px;">Mendengarkan dan Mengidentifikasi Unsur Intrinsik</h3><div style="background-color: rgb(249, 250, 251); padding: 12px; margin-bottom: 12px;"><strong style="font-size: 10pt; color: rgb(75, 85, 99);">📖 Bacaan:</strong><p style="text-align: justify; white-space: pre-line; margin-top: 8px; margin-bottom: 0px;"><span>Suatu hari, di sebuah desa kecil yang dikelilingi hutan lebat, hiduplah seorang anak bernama Budi. Budi adalah anak yang rajin dan suka membantu ibunya. Suatu pagi, saat Budi sedang membantu ibunya di kebun, ia melihat seekor kelinci kecil yang kakinya terluka. Budi merasa kasihan, lalu ia membawa kelinci itu pulang dan merawatnya dengan hati-hati. Ia membuatkan kandang yang nyaman dan memberinya makan wortel segar. Beberapa hari kemudian, kelinci itu sembuh dan Budi melepaskannya kembali ke hutan. Budi merasa senang karena telah menolong makhluk lain.</span></p></div><p style="margin-bottom: 12px;"><span>Dengarkanlah teks cerita 'Budi dan Kelinci Ajaib' yang akan dibacakan oleh gurumu. Sambil mendengarkan, catatlah informasi tentang tokoh, latar, dan alur cerita pada tabel yang tersedia.</span></p><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Siapakah tokoh utama dalam cerita tersebut?</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Siapa saja tokoh lain yang ada dalam cerita?</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Di mana latar tempat cerita ini terjadi?</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Kapan latar waktu cerita ini terjadi?</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Bagaimana suasana latar cerita ini?</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Bagaimana alur cerita dari awal hingga akhir? (Peristiwa apa saja yang terjadi secara berurutan?)</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-bottom: 24px;"><h3 style="font-weight: bold; font-size: 12pt; margin-bottom: 12px;">Diskusi Kelompok</h3><p style="margin-bottom: 12px;"><span>Bentuklah kelompok yang terdiri dari 3-4 orang. Diskusikan hasil identifikasi unsur intrinsik yang telah kalian catat. Pastikan setiap anggota kelompok memahami peran tokoh, detail latar, dan urutan kejadian dalam cerita.</span></p><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Apakah ada perbedaan dalam mengidentifikasi tokoh, latar, atau alur antar anggota kelompok?</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Bagaimana kalian menyimpulkan alur cerita berdasarkan peristiwa yang didengar?</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Apa pesan moral yang bisa diambil dari cerita tersebut?</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-bottom: 24px;"><h3 style="font-weight: bold; font-size: 12pt; margin-bottom: 12px;">Menceritakan Kembali Cerita</h3><p style="margin-bottom: 12px;"><span>Secara bergiliran, ceritakan kembali isi cerita 'Budi dan Kelinci Ajaib' kepada kelompokmu dengan menggunakan unsur-unsur intrinsik yang telah kalian identifikasi. Fokuslah pada kejelasan tokoh, penggambaran latar, dan runtutan alur cerita.</span></p><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Apakah ceritamu mudah dipahami oleh teman sekelompok?</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div><div style="margin-bottom: 16px;"><p style="font-weight: bold; margin-bottom: 8px;"><span>Apakah kamu berhasil menyampaikan detail tokoh, latar, dan alur dengan baik?</span></p><table style="width: 100%; border-collapse: collapse; margin-top: 8px;"><tbody><tr><td style="border: 1px solid rgb(156, 163, 175); height: 80px; padding: 8px; vertical-align: top; background-color: rgb(250, 250, 250);"><span style="color: rgb(156, 163, 175); font-size: 9pt;">Jawaban:</span><br><br><br><br></td></tr></tbody></table></div></div></div></div></div></div><div data-v2-export-item="ff56b58c-7106-4836-a426-1a001be63173:asesmen" data-v2-export-jenis="asesmen" data-v2-export-pertemuan="9" class="page-break-before" style="break-before: page;"><div data-v2-export-marker="true" style="font-size: 10pt; font-weight: 700; margin-bottom: 8px;">Pertemuan 9 — Asesmen</div><div class="document-preview bg-white mx-auto p-6 md:p-12 text-black" style="width: 100%; max-width: 210mm;"><div data-section="modul" style="display: none;"><div style="text-align: center; margin-bottom: 20px; border-bottom: 3px solid black; padding-bottom: 10px;"><h1 style="font-size: 16pt; font-weight: bold; margin: 0px; text-transform: uppercase;">MODUL AJAR: BAHASA INDONESIA</h1><p class="italic">Materi: Materi - Kelas Kelas</p></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">I. IDENTIFIKASI DASAR</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Identitas Umum</td><td style="border: 1px solid black; padding: 6px; vertical-align: top;"><div><strong>Nama Penyusun:</strong> Guru</div><div><strong>Sekolah:</strong> Sekolah</div><div><strong>Mata Pelajaran:</strong> Bahasa Indonesia</div><div><strong>Materi:</strong> Materi </div><div><strong>Kelas/Fase:</strong> Kelas / Fase</div><div><strong>Semester:</strong> 1</div><div><strong>Jumlah Pertemuan:</strong> 32 (0 Menit)</div></td></tr><tr style="background-color: rgb(219, 234, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">II. IDENTIFIKASI MURID</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Pengetahuan Awal</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Minat</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Latar Belakang</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Kebutuhan Belajar</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(209, 250, 229);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">III. JENIS PENGETAHUAN MATERI</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Faktual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Konseptual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Prosedural</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metakognitif</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Kaitan dengan Kehidupan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(254, 243, 199);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IV. INTEGRASI NILAI &amp; KARAKTER</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Nilai Karakter</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(224, 231, 255);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">V. DIMENSI PROFIL LULUSAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">DPL yang Dikembangkan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr></tbody></table><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VI. DESAIN PEMBELAJARAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Capaian Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Tujuan Pembelajaran</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Pemahaman Bermakna</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Model Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metode Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(240, 253, 244);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VII. LINTAS DISIPLIN ILMU</td></tr><tr style="background-color: rgb(252, 231, 243);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VIII. KEMITRAAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(207, 250, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IX. LINGKUNGAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(237, 233, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">X. PEMANFAATAN DIGITAL</td></tr></tbody></table><div style="margin-bottom: 30px;"><div style="background-color: rgb(226, 232, 240); padding: 8px; font-weight: bold; margin-bottom: 16px; border: 1px solid black;">XI. PENGALAMAN BELAJAR (LANGKAH PEMBELAJARAN)</div><div style="padding: 20px; text-align: center; color: rgb(107, 114, 128); border: 1px solid black;">Langkah pembelajaran akan muncul setelah generate modul</div></div><table style="width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin-top: 50px;"><tbody><tr><td style="width: 50%; text-align: center; vertical-align: top;">Mengetahui,<br>Kepala Sekolah<br><br><br><br><strong>...........................</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td><td style="width: 50%; text-align: center; vertical-align: top;">Guru Mata Pelajaran<br><br><br><br><br><strong>Guru</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td></tr></tbody></table></div><div data-section="asesmen" style="display: block; margin-top: 40px;"><div style=""></div><h2 style="text-align: center; font-weight: bold; font-size: 14pt; text-transform: uppercase; margin-bottom: 24px;">Instrumen Asesmen Pembelajaran</h2><div style="margin-bottom: 24px;"><h3 style="font-weight: bold; font-size: 12pt; margin-bottom: 8px;">A. ASESMEN AWAL PEMBELAJARAN (Diagnostik)</h3><p style="font-style: italic; font-size: 10pt; margin-bottom: 8px;">Mengidentifikasi pengetahuan awal peserta didik mengenai unsur-unsur pembentuk cerita (tokoh, latar) dan kesiapan menyimak teks lisan sebelum pembelajaran dimulai.</p><p style="margin-bottom: 12px;"><strong>Metode:</strong> Pertanyaan Lisan</p><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black;"><thead><tr style="background-color: rgb(241, 245, 249);"><th style="border: 1px solid black; padding: 8px; width: 5%;">No</th><th style="border: 1px solid black; padding: 8px; width: 55%;">Pertanyaan Pemantik</th><th style="border: 1px solid black; padding: 8px; width: 40%;">Tujuan</th></tr></thead><tbody><tr><td style="border: 1px solid black; padding: 8px; text-align: center;">1</td><td style="border: 1px solid black; padding: 8px;"><span>Saat kalian mendengarkan dongeng atau cerita yang dibacakan, apa saja yang biasanya kalian ingat dari cerita tersebut?</span></td><td style="border: 1px solid black; padding: 8px;"><span>Mengetahui fokus perhatian siswa saat menyimak cerita lisan.</span></td></tr><tr><td style="border: 1px solid black; padding: 8px; text-align: center;">2</td><td style="border: 1px solid black; padding: 8px;"><span>Siapa yang tahu apa yang dimaksud dengan 'tokoh' dan 'latar' dalam sebuah cerita? Bisakah kalian memberikan contohnya?</span></td><td style="border: 1px solid black; padding: 8px;"><span>Mengukur pemahaman awal siswa mengenai definisi tokoh dan latar cerita.</span></td></tr><tr><td style="border: 1px solid black; padding: 8px; text-align: center;">3</td><td style="border: 1px solid black; padding: 8px;"><span>Bagaimana cara kita mengetahui tempat terjadinya cerita jika kita hanya mendengarkan ceritanya tanpa melihat gambar?</span></td><td style="border: 1px solid black; padding: 8px;"><span>Mengidentifikasi kemampuan siswa dalam menangkap informasi lisan (kemampuan menyimak).</span></td></tr></tbody></table></div></div><div style="margin-bottom: 24px;"><h3 style="font-weight: bold; font-size: 12pt; margin-bottom: 8px;">B. ASESMEN PROSES PEMBELAJARAN (Formatif)</h3><p style="font-style: italic; font-size: 10pt; margin-bottom: 8px;">Mengamati proses belajar, keaktifan menyimak, dan kemampuan kolaborasi peserta didik dalam menganalisis unsur intrinsik cerita melalui diskusi kelompok.</p><p style="margin-bottom: 16px;"><strong>Metode:</strong> Penilaian Kinerja dan Lembar Kerja Diskusi Kelompok</p><div style="margin-bottom: 16px;"><h4 style="font-weight: bold; margin-bottom: 8px;">Aktivitas 1: Analisis Peta Pikiran Dongeng 'Misteri Sepeda Merah'</h4><p style="margin-bottom: 8px;"><strong>Instruksi:</strong> <span>Simaklah dengan saksama cerita fiksi 'Misteri Sepeda Merah di Kampung Harapan' yang akan dibacakan oleh guru. Setelah selesai menyimak, berkumpullah bersama kelompokmu (terdiri dari 4 orang) untuk mendiskusikan dan mengisi peta pikiran cerita (unsur tokoh, latar, dan alur) pada lembar kerja yang disediakan.</span></p><div style="margin-bottom: 8px;"><strong>Pertanyaan Diskusi:</strong><ul style="margin-left: 20px; margin-top: 4px; list-style-type: disc;"><li><span>Siapa saja tokoh yang ada dalam cerita tersebut dan bagaimana sifat mereka?</span></li><li><span>Di mana dan kapan peristiwa dalam cerita itu terjadi?</span></li><li><span>Apa masalah utama yang dihadapi tokoh dan bagaimana akhir dari cerita tersebut?</span></li></ul></div><div><strong>Kunci Jawaban:</strong><ul style="margin-left: 20px; margin-top: 4px; list-style-type: disc;"><li><span>Tokoh utama: Boni (anak yang jujur dan bertanggung jawab), Tokoh pendukung: Pak RT (bijaksana) dan Aldi (pemilik sepeda).</span></li><li><span>Latar tempat: Kampung Harapan (di depan pos ronda dan lapangan sepak bola). Latar waktu: Sore hari.</span></li><li><span>Alur awal: Boni menemukan sepeda merah tak bertuan di lapangan. Alur tengah: Boni mengamankan sepeda tersebut dan melaporkannya kepada Pak RT. Alur akhir: Sepeda berhasil dikembalikan kepada Aldi, pemiliknya yang sah, dan Boni mendapatkan pujian atas kejujurannya.</span></li></ul></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-top: 16px;"><h4 style="font-weight: bold; margin-bottom: 8px;">Rubrik Penilaian Proses</h4><table style="width: 100%; border-collapse: collapse; border: 1px solid black;"><thead><tr style="background-color: rgb(241, 245, 249);"><th style="border: 1px solid black; padding: 8px;">Aspek</th><th style="border: 1px solid black; padding: 8px;">Sangat Baik (4)</th><th style="border: 1px solid black; padding: 8px;">Baik (3)</th><th style="border: 1px solid black; padding: 8px;">Cukup (2)</th><th style="border: 1px solid black; padding: 8px;">Kurang (1)</th></tr></thead><tbody><tr><td style="border: 1px solid black; padding: 8px; font-weight: bold;">Kemampuan Menyimak (Aural)</td><td style="border: 1px solid black; padding: 8px;"><span>Sangat fokus saat menyimak, mampu mencatat/mengingat detail informasi penting dari cerita tanpa ada yang terlewat.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Fokus saat menyimak, mampu mengingat sebagian besar informasi penting dari cerita dengan sedikit bantuan.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Cukup fokus, namun sering terdistraksi dan hanya mampu mengingat informasi umum atau permukaan saja.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Kesulitan fokus saat menyimak, tidak mampu mengingat informasi penting dari cerita lisan.</span></td></tr><tr><td style="border: 1px solid black; padding: 8px; font-weight: bold;">Analisis Tokoh dan Latar</td><td style="border: 1px solid black; padding: 8px;"><span>Mengidentifikasi seluruh tokoh (utama &amp; pendukung) beserta wataknya, serta latar tempat &amp; waktu dengan sangat tepat disertai bukti cerita.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Mengidentifikasi tokoh utama, sebagian tokoh pendukung, serta latar tempat &amp; waktu dengan tepat.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Hanya mengidentifikasi tokoh utama dan latar tempat saja, latar waktu dan watak tokoh kurang tepat.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Salah mengidentifikasi tokoh dan latar cerita yang didengarkan.</span></td></tr><tr><td style="border: 1px solid black; padding: 8px; font-weight: bold;">Analisis Alur Cerita</td><td style="border: 1px solid black; padding: 8px;"><span>Menjelaskan alur cerita secara runtut dan logis mulai dari awal (pengenalan), tengah (konflik), hingga akhir (penyelesaian) dengan sangat jelas.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Menjelaskan alur cerita dengan runtut (awal, tengah, akhir) namun penjelasannya kurang detail di bagian konflik.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Menjelaskan alur cerita secara acak atau melompati salah satu bagian alur (misal: langsung dari awal ke akhir).</span></td><td style="border: 1px solid black; padding: 8px;"><span>Tidak mampu menceritakan kembali urutan kejadian atau alur cerita yang didengar.</span></td></tr><tr><td style="border: 1px solid black; padding: 8px; font-weight: bold;">Kolaborasi Kelompok</td><td style="border: 1px solid black; padding: 8px;"><span>Sangat aktif memberikan ide, mendengarkan pendapat teman dengan menghargai, dan berkontribusi penuh dalam menyelesaikan tugas kelompok.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Aktif bekerja sama dalam kelompok dan sesekali memberikan masukan atau argumen.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Kurang aktif, hanya bersedia bekerja jika diminta atau ditunjuk oleh teman sekelompoknya.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Pasif, tidak memberikan kontribusi, atau justru mengganggu jalannya diskusi kelompok.</span></td></tr></tbody></table></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-top: 16px;"><p style="font-weight: bold; margin-bottom: 4px;">📝 Penilaian Diri:</p><ul style="margin-left: 20px; list-style-type: disc;"><li><span>Apakah aku menyimak cerita yang dibacakan oleh guru dengan sungguh-sungguh?</span></li><li><span>Apakah aku membantu kelompokku menemukan tokoh, latar, dan alur dalam cerita tadi?</span></li><li><span>Bagian mana yang menurutku paling sulit saat mencoba memahami cerita lisan?</span></li></ul></div></div><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-top: 12px;"><p style="font-weight: bold; margin-bottom: 4px;">👥 Penilaian Sejawat:</p><ul style="margin-left: 20px; list-style-type: disc;"><li><span>Temanku mendengarkan pendapat anggota kelompok lain dengan sopan saat berdiskusi.</span></li><li><span>Temanku ikut memberikan ide atau jawaban saat kami mengisi lembar kerja kelompok.</span></li><li><span>Temanku fokus bekerja dan tidak melakukan hal lain di luar tugas kelompok.</span></li></ul></div></div></div><div style="margin-bottom: 24px;"><h3 style="font-weight: bold; font-size: 12pt; margin-bottom: 8px;">C. ASESMEN AKHIR PEMBELAJARAN (Sumatif)</h3><p style="font-style: italic; font-size: 10pt; margin-bottom: 8px;">Asesmen sumatif individu berupa tes tertulis uraian untuk mengukur pencapaian peserta didik dalam mengidentifikasi unsur intrinsik (tokoh, latar, alur) berdasarkan teks fiksi baru yang dibacakan.</p><p style="margin-bottom: 12px;"><strong>Metode:</strong> Tes Tertulis Uraian (Menyimak Cerita Lisan)</p><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div><div style="margin-bottom: 16px;"><h4 style="font-weight: bold; margin-bottom: 8px;">Soal Uraian</h4><table style="width: 100%; border-collapse: collapse; border: 1px solid black;"><thead><tr style="background-color: rgb(241, 245, 249);"><th style="border: 1px solid black; padding: 8px; width: 5%;">No</th><th style="border: 1px solid black; padding: 8px; width: 45%;">Pertanyaan</th><th style="border: 1px solid black; padding: 8px; width: 40%;">Kunci Jawaban</th><th style="border: 1px solid black; padding: 8px; width: 10%;">Skor</th></tr></thead><tbody><tr><td style="border: 1px solid black; padding: 8px; text-align: center;">1</td><td style="border: 1px solid black; padding: 8px;"><span>Setelah menyimak cerita 'Pahlawan Cilik Penyelamat Sungai' yang dibacakan guru, sebutkan siapa tokoh utama dalam cerita tersebut dan jelaskan bagaimana watak/karakternya berdasarkan perilakunya dalam cerita!</span></td><td style="border: 1px solid black; padding: 8px;"><span>Tokoh utama adalah Dito. Watak/karakternya adalah peduli lingkungan, rajin, dan berani mengajak orang lain berbuat baik. Buktinya, Dito tidak tega melihat sungai kotor dan berinisiatif mengajak teman-temannya membersihkan sampah plastik di sungai.</span></td><td style="border: 1px solid black; padding: 8px; text-align: center;">30</td></tr><tr><td style="border: 1px solid black; padding: 8px; text-align: center;">2</td><td style="border: 1px solid black; padding: 8px;"><span>Tuliskan latar tempat dan latar waktu terjadinya peristiwa dalam cerita tersebut! Berikan bukti kata atau kalimat yang menunjukkan latar tersebut!</span></td><td style="border: 1px solid black; padding: 8px;"><span>Latar tempat: Di tepi Sungai Desa Makmur (buktinya: 'Dito berdiri di tepi Sungai Desa Makmur yang penuh sampah'). Latar waktu: Pagi hari yang cerah (buktinya: 'Sinar matahari pagi mulai menyinari desa...').</span></td><td style="border: 1px solid black; padding: 8px; text-align: center;">30</td></tr><tr><td style="border: 1px solid black; padding: 8px; text-align: center;">3</td><td style="border: 1px solid black; padding: 8px;"><span>Jelaskan bagaimana urutan alur cerita tersebut dari awal kejadian, munculnya masalah (konflik), hingga bagaimana masalah tersebut diselesaikan (akhir cerita)!</span></td><td style="border: 1px solid black; padding: 8px;"><span>Alur Awal: Dito berjalan ke sungai di pagi hari dan sedih melihat tumpukan sampah plastik yang menyumbat aliran air. Alur Tengah (Masalah): Sungai mulai meluap karena tersumbat sampah saat hujan gerimis mulai turun, Dito khawatir desa akan banjir. Alur Akhir (Penyelesaian): Dito memanggil teman-temannya dan warga sekitar untuk bergotong-royong membersihkan sampah. Sungai kembali bersih dan air mengalir dengan lancar sehingga banjir dapat dicegah.</span></td><td style="border: 1px solid black; padding: 8px; text-align: center;">40</td></tr></tbody></table></div></div><div style="margin-top: 16px;"><h4 style="font-weight: bold; margin-bottom: 8px;">Rubrik Penilaian Akhir</h4><table style="width: 100%; border-collapse: collapse; border: 1px solid black;"><thead><tr style="background-color: rgb(241, 245, 249);"><th style="border: 1px solid black; padding: 8px;">Aspek</th><th style="border: 1px solid black; padding: 8px;">Sangat Baik (4)</th><th style="border: 1px solid black; padding: 8px;">Baik (3)</th><th style="border: 1px solid black; padding: 8px;">Cukup (2)</th><th style="border: 1px solid black; padding: 8px;">Kurang (1)</th></tr></thead><tbody><tr><td style="border: 1px solid black; padding: 8px; font-weight: bold;">Analisis Tokoh (Soal 1)</td><td style="border: 1px solid black; padding: 8px;"><span>Menyebutkan nama tokoh utama dengan benar dan menjelaskan wataknya secara detail disertai bukti konkret dalam cerita.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Menyebutkan nama tokoh utama dengan benar dan menjelaskan wataknya, namun bukti dari cerita kurang lengkap.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Hanya menyebutkan nama tokoh utama saja tanpa menjelaskan watak atau karakter tokoh tersebut.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Jawaban salah atau tidak menyebutkan nama tokoh utama.</span></td></tr><tr><td style="border: 1px solid black; padding: 8px; font-weight: bold;">Analisis Latar (Soal 2)</td><td style="border: 1px solid black; padding: 8px;"><span>Menyebutkan latar tempat dan waktu dengan sangat tepat serta menyertakan bukti tekstual yang didengar dengan akurat.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Menyebutkan latar tempat dan waktu dengan tepat, namun bukti tekstual kurang lengkap atau kurang akurat.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Hanya menyebutkan salah satu latar saja (tempat saja atau waktu saja) dengan benar.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Jawaban salah atau tidak menyebutkan latar tempat maupun waktu.</span></td></tr><tr><td style="border: 1px solid black; padding: 8px; font-weight: bold;">Analisis Alur (Soal 3)</td><td style="border: 1px solid black; padding: 8px;"><span>Menjelaskan ketiga bagian alur (awal, tengah/konflik, akhir/solusi) secara kronologis, logis, dan menggunakan bahasa yang runtut.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Menjelaskan ketiga bagian alur dengan benar, namun penyusunan kalimat atau transisi antar-bagian alur kurang runtut.</span></td><td style="border: 1px solid black; padding: 8px;"><span>Hanya menjelaskan dua bagian alur saja (misalnya awal dan akhir saja tanpa ada bagian konflik).</span></td><td style="border: 1px solid black; padding: 8px;"><span>Penjelasan alur sangat kacau, tidak sesuai cerita, atau tidak menjawab.</span></td></tr></tbody></table></div><div style="margin-top: 16px;"><p><strong>Pedoman Penskoran:</strong></p><p>Skor Total: 100</p><p>Rumus Nilai: (Skor Perolehan / Skor Maksimal) x 100</p></div></div></div></div></div><div data-v2-export-item="ff56b58c-7106-4836-a426-1a001be63173:soal" data-v2-export-jenis="soal" data-v2-export-pertemuan="9" class="page-break-before" style="break-before: page;"><div data-v2-export-marker="true" style="font-size: 10pt; font-weight: 700; margin-bottom: 8px;">Pertemuan 9 — Soal</div><div class="document-preview bg-white mx-auto p-6 md:p-12 text-black" style="width: 100%; max-width: 210mm;"><div data-section="modul" style="display: none;"><div style="text-align: center; margin-bottom: 20px; border-bottom: 3px solid black; padding-bottom: 10px;"><h1 style="font-size: 16pt; font-weight: bold; margin: 0px; text-transform: uppercase;">MODUL AJAR: BAHASA INDONESIA</h1><p class="italic">Materi: Materi - Kelas Kelas</p></div><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">I. IDENTIFIKASI DASAR</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Identitas Umum</td><td style="border: 1px solid black; padding: 6px; vertical-align: top;"><div><strong>Nama Penyusun:</strong> Guru</div><div><strong>Sekolah:</strong> Sekolah</div><div><strong>Mata Pelajaran:</strong> Bahasa Indonesia</div><div><strong>Materi:</strong> Materi </div><div><strong>Kelas/Fase:</strong> Kelas / Fase</div><div><strong>Semester:</strong> 1</div><div><strong>Jumlah Pertemuan:</strong> 32 (0 Menit)</div></td></tr><tr style="background-color: rgb(219, 234, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">II. IDENTIFIKASI MURID</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Pengetahuan Awal</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Minat</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Latar Belakang</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Aspek Kebutuhan Belajar</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(209, 250, 229);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">III. JENIS PENGETAHUAN MATERI</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Faktual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Konseptual</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Prosedural</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metakognitif</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Kaitan dengan Kehidupan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(254, 243, 199);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IV. INTEGRASI NILAI &amp; KARAKTER</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Nilai Karakter</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(224, 231, 255);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">V. DIMENSI PROFIL LULUSAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">DPL yang Dikembangkan</td><td style="border: 1px solid black; padding: 6px;">-</td></tr></tbody></table><table style="width: 100%; border-collapse: collapse; border: 1px solid black; margin-bottom: 20px; table-layout: fixed;"><colgroup><col style="width: 30%;"><col style="width: 70%;"></colgroup><tbody><tr style="background-color: rgb(226, 232, 240);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VI. DESAIN PEMBELAJARAN</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Capaian Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Tujuan Pembelajaran</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Pemahaman Bermakna</td><td style="border: 1px solid black; padding: 6px;"><div class="relative group/editable" style=""><div class="absolute inset-0 rounded pointer-events-none ring-0 group-hover/editable:ring-2 group-hover/editable:ring-primary/30 transition-all duration-150"></div>-</div></td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Model Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr><td style="border: 1px solid black; padding: 6px; font-weight: bold; vertical-align: top;">Metode Pembelajaran</td><td style="border: 1px solid black; padding: 6px;">-</td></tr><tr style="background-color: rgb(240, 253, 244);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VII. LINTAS DISIPLIN ILMU</td></tr><tr style="background-color: rgb(252, 231, 243);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">VIII. KEMITRAAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(207, 250, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">IX. LINGKUNGAN PEMBELAJARAN</td></tr><tr style="background-color: rgb(237, 233, 254);"><td colspan="2" style="border: 1px solid black; padding: 8px; font-weight: bold;">X. PEMANFAATAN DIGITAL</td></tr></tbody></table><div style="margin-bottom: 30px;"><div style="background-color: rgb(226, 232, 240); padding: 8px; font-weight: bold; margin-bottom: 16px; border: 1px solid black;">XI. PENGALAMAN BELAJAR (LANGKAH PEMBELAJARAN)</div><div style="padding: 20px; text-align: center; color: rgb(107, 114, 128); border: 1px solid black;">Langkah pembelajaran akan muncul setelah generate modul</div></div><table style="width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin-top: 50px;"><tbody><tr><td style="width: 50%; text-align: center; vertical-align: top;">Mengetahui,<br>Kepala Sekolah<br><br><br><br><strong>...........................</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td><td style="width: 50%; text-align: center; vertical-align: top;">Guru Mata Pelajaran<br><br><br><br><br><strong>Guru</strong><br><span style="font-size: 10pt;">NIP. ..............................</span></td></tr></tbody></table></div><div data-section="soal" style="display: block; margin-top: 40px;"><div data-subsection="soal-siswa"><h2 style="font-weight: bold; font-size: 12pt; text-align: center; margin-bottom: 12px;">LEMBAR SOAL</h2><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 1</p><p style="text-align: justify; margin: 0px;"><span>Di sebuah desa yang permai di kaki Gunung Merapi, hiduplah seorang anak bernama Bima. Bima dikenal sebagai anak yang rajin membantu ibunya di warung kecil mereka. Setiap pagi, sebelum matahari terbit, ia sudah bangun untuk menyapu halaman dan menyiapkan dagangan. Suatu hari, seorang saudagar kaya dari kota datang ke desa Bima. Ia terpesona oleh kejujuran dan kerajinan Bima. Saudagar itu kemudian mengajak Bima untuk bekerja di tokonya di kota, dengan janji pendidikan dan kehidupan yang lebih baik. Ibu Bima awalnya ragu, namun melihat kesempatan besar untuk masa depan anaknya, ia pun mengizinkan.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">1.</span> <span style="font-weight: normal;"><span>Siapakah tokoh utama dalam cerita tentang desa di kaki Gunung Merapi?</span></span></p><div style="margin-left: 20px; margin-top: 4px;"><p style="margin: 2px 0px; font-weight: normal;">A. <span>Ibu Bima</span></p><p style="margin: 2px 0px; font-weight: normal;">B. <span>Saudagar kaya</span></p><p style="margin: 2px 0px; font-weight: normal;">C. <span>Bima</span></p><p style="margin: 2px 0px; font-weight: normal;">D. <span>Penduduk desa</span></p></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 2 s.d no. 3</p><p style="text-align: justify; margin: 0px;"><span>Kisah petualangan Dimas dimulai saat ia menemukan peta tua di loteng rumah neneknya. Peta itu menunjukkan lokasi sebuah gua tersembunyi di Hutan Jati, tak jauh dari desanya. Konon, di dalam gua itu tersimpan harta karun peninggalan nenek moyang. Tanpa pikir panjang, Dimas mengajak sahabatnya, Rina, untuk ikut mencari. Mereka mempersiapkan perbekalan seadanya: senter, tali, dan beberapa botol air minum. Perjalanan menuju hutan ternyata tidak mudah. Jalan setapak yang terjal dan semak belukar yang lebat membuat mereka harus berjuang keras.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">2.</span> <span style="font-weight: normal;"><span>Di manakah Dimas menemukan peta tua yang membawanya berpetualang?</span></span></p><div style="margin-left: 20px; margin-top: 4px;"><p style="margin: 2px 0px; font-weight: normal;">A. <span>Di hutan jati</span></p><p style="margin: 2px 0px; font-weight: normal;">B. <span>Di rumah nenek</span></p><p style="margin: 2px 0px; font-weight: normal;">C. <span>Di tepi danau</span></p><p style="margin: 2px 0px; font-weight: normal;">D. <span>Di warung Bima</span></p></div></div><div style="margin-bottom: 18px;"><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">3.</span> <span style="font-weight: normal;"><span>Berdasarkan tindakannya, bagaimana watak Dimas dalam cerita penemuan peta?</span></span></p><div style="margin-left: 20px; margin-top: 4px;"><p style="margin: 2px 0px; font-weight: normal;">A. <span>Penakut dan ragu-ragu</span></p><p style="margin: 2px 0px; font-weight: normal;">B. <span>Berani dan tidak mudah menyerah</span></p><p style="margin: 2px 0px; font-weight: normal;">C. <span>Pemalas dan hanya suka bermain</span></p><p style="margin: 2px 0px; font-weight: normal;">D. <span>Cerdik dan suka menipu</span></p></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 4</p><p style="text-align: justify; margin: 0px;"><span>Di tepi Danau Toba yang biru jernih, tinggallah keluarga nelayan bernama keluarga Siregar. Ayah, Ibu, dan kedua anak mereka, Adi dan Lia, hidup rukun. Setiap sore, Ayah Siregar selalu mengajak Adi melaut untuk mengajarkan cara menangkap ikan. Lia, meskipun masih kecil, gemar membantu Ibunya membersihkan hasil tangkapan di rumah. Kehidupan mereka sederhana namun penuh kehangatan. Suatu ketika, badai besar datang mengancam desa mereka. Air danau naik tinggi, merusak beberapa rumah nelayan, termasuk rumah keluarga Siregar.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">4.</span> <span style="font-weight: normal;"><span>Kapan Ayah Siregar biasanya mengajak Adi melaut?</span></span></p><div style="margin-left: 20px; margin-top: 4px;"><p style="margin: 2px 0px; font-weight: normal;">A. <span>Setiap pagi sebelum matahari terbit</span></p><p style="margin: 2px 0px; font-weight: normal;">B. <span>Setiap siang saat terik</span></p><p style="margin: 2px 0px; font-weight: normal;">C. <span>Setiap sore</span></p><p style="margin: 2px 0px; font-weight: normal;">D. <span>Setiap malam</span></p></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 5</p><p style="text-align: justify; margin: 0px;"><span>Cerita tentang Kancil dan Buaya adalah salah satu dongeng favorit anak-anak Indonesia. Dalam cerita ini, Kancil yang cerdik berhasil menipu sekawanan buaya untuk menyusun barisan agar ia bisa menyeberangi sungai. Kancil berpura-pura bahwa Raja Buaya ingin mengadakan pesta dan membutuhkan banyak daging buaya. Dengan akalnya, Kancil berhasil sampai ke seberang sungai dengan selamat tanpa digigit buaya. Dongeng ini mengajarkan bahwa kecerdasan dapat mengalahkan kekuatan fisik.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">5.</span> <span style="font-weight: normal;"><span>Pesan moral apa yang dapat diambil dari cerita Kancil dan Buaya?</span></span></p><div style="margin-left: 20px; margin-top: 4px;"><p style="margin: 2px 0px; font-weight: normal;">A. <span>Kekuatan fisik selalu menang</span></p><p style="margin: 2px 0px; font-weight: normal;">B. <span>Kecerdikan lebih baik daripada kekuatan</span></p><p style="margin: 2px 0px; font-weight: normal;">C. <span>Jangan pernah percaya pada hewan</span></p><p style="margin: 2px 0px; font-weight: normal;">D. <span>Berbohong itu perbuatan baik</span></p></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 6</p><p style="text-align: justify; margin: 0px;"><span>Desa Cipta Karya terkenal dengan kerajinan batiknya. Ibu-ibu di desa ini memiliki keahlian luar biasa dalam menggambar motif-motif indah di atas kain. Salah satu motif yang paling populer adalah motif bunga melati yang melambangkan kesucian dan keindahan. Pak Lurah sangat mendukung para pengrajin batik desa. Ia sering membantu mempromosikan batik Cipta Karya ke berbagai pameran di kota. Berkat kerja keras mereka, batik dari desa ini kini mulai dikenal luas dan menjadi sumber penghidupan utama bagi banyak keluarga.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">6.</span> <span style="font-weight: normal;"><span>Perhatikan pernyataan-pernyataan berikut berdasarkan teks tentang desa Cipta Karya! Tentukan Benar atau Salah.</span></span></p><table style="width: 95%; border-collapse: collapse; border: 1px solid rgb(0, 0, 0); margin-bottom: 16px; margin-left: 20px; margin-top: 6px;"><thead><tr><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 40px;">No</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left;">Pernyataan</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 60px;">Benar</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 60px;">Salah</th></tr></thead><tbody><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">1</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Desa Cipta Karya terkenal dengan kerajinan ukiran kayu.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">2</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Motif bunga melati melambangkan kesucian.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">3</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Pak Lurah tidak mendukung para pengrajin batik.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">4</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Batik Cipta Karya kini mulai dikenal luas.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr></tbody></table></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 7</p><p style="text-align: justify; margin: 0px;"><span>Di sebuah desa yang permai di kaki Gunung Merapi, hiduplah seorang anak bernama Bima. Bima dikenal sebagai anak yang rajin membantu ibunya di warung kecil mereka. Setiap pagi, sebelum matahari terbit, ia sudah bangun untuk menyapu halaman dan menyiapkan dagangan. Suatu hari, seorang saudagar kaya dari kota datang ke desa Bima. Ia terpesona oleh kejujuran dan kerajinan Bima. Saudagar itu kemudian mengajak Bima untuk bekerja di tokonya di kota, dengan janji pendidikan dan kehidupan yang lebih baik. Ibu Bima awalnya ragu, namun melihat kesempatan besar untuk masa depan anaknya, ia pun mengizinkan.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">7.</span> <span style="font-weight: normal;"><span>Berdasarkan teks tentang Bima, tentukan apakah pernyataan berikut Benar atau Salah!</span></span></p><table style="width: 95%; border-collapse: collapse; border: 1px solid rgb(0, 0, 0); margin-bottom: 16px; margin-left: 20px; margin-top: 6px;"><thead><tr><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 40px;">No</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left;">Pernyataan</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 60px;">Benar</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 60px;">Salah</th></tr></thead><tbody><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">1</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Bima awalnya enggan membantu ibunya.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">2</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Seorang saudagar kaya datang ke desa Bima.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">3</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Bima diajak bekerja di desa.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">4</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Ibu Bima langsung setuju Bima pergi ke kota.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr></tbody></table></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 8</p><p style="text-align: justify; margin: 0px;"><span>Di tepi Danau Toba yang biru jernih, tinggallah keluarga nelayan bernama keluarga Siregar. Ayah, Ibu, dan kedua anak mereka, Adi dan Lia, hidup rukun. Setiap sore, Ayah Siregar selalu mengajak Adi melaut untuk mengajarkan cara menangkap ikan. Lia, meskipun masih kecil, gemar membantu Ibunya membersihkan hasil tangkapan di rumah. Kehidupan mereka sederhana namun penuh kehangatan. Suatu ketika, badai besar datang mengancam desa mereka. Air danau naik tinggi, merusak beberapa rumah nelayan, termasuk rumah keluarga Siregar.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">8.</span> <span style="font-weight: normal;"><span>Perhatikan pernyataan-pernyataan berikut mengenai latar cerita keluarga Siregar! Tentukan Benar atau Salah.</span></span></p><table style="width: 95%; border-collapse: collapse; border: 1px solid rgb(0, 0, 0); margin-bottom: 16px; margin-left: 20px; margin-top: 6px;"><thead><tr><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 40px;">No</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left;">Pernyataan</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 60px;">Benar</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 60px;">Salah</th></tr></thead><tbody><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">1</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Keluarga Siregar tinggal di tepi Sungai Musi.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">2</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Adi dan Lia adalah anak dari keluarga Siregar.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">3</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Mereka hidup berkecukupan tanpa masalah.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">4</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Badai besar merusak rumah mereka.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr></tbody></table></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 9</p><p style="text-align: justify; margin: 0px;"><span>Cerita tentang Kancil dan Buaya adalah salah satu dongeng favorit anak-anak Indonesia. Dalam cerita ini, Kancil yang cerdik berhasil menipu sekawanan buaya untuk menyusun barisan agar ia bisa menyeberangi sungai. Kancil berpura-pura bahwa Raja Buaya ingin mengadakan pesta dan membutuhkan banyak daging buaya. Dengan akalnya, Kancil berhasil sampai ke seberang sungai dengan selamat tanpa digigit buaya. Dongeng ini mengajarkan bahwa kecerdasan dapat mengalahkan kekuatan fisik.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">9.</span> <span style="font-weight: normal;"><span>Berdasarkan cerita Kancil dan Buaya, tentukan Benar atau Salah!</span></span></p><table style="width: 95%; border-collapse: collapse; border: 1px solid rgb(0, 0, 0); margin-bottom: 16px; margin-left: 20px; margin-top: 6px;"><thead><tr><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 40px;">No</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left;">Pernyataan</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 60px;">Benar</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 60px;">Salah</th></tr></thead><tbody><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">1</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Kancil menggunakan kekuatan fisiknya untuk menipu buaya.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">2</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Buaya-buaya dalam cerita ini digambarkan sangat cerdas.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">3</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Kancil berhasil menyeberangi sungai berkat kecerdikannya.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr><tr style=""><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">4</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top;"><span>Dongeng ini mengajarkan pentingnya kebohongan.</span></td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td><td style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; vertical-align: top; text-align: center;">○</td></tr></tbody></table></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 10</p><p style="text-align: justify; margin: 0px;"><span>Kisah petualangan Dimas dimulai saat ia menemukan peta tua di loteng rumah neneknya. Peta itu menunjukkan lokasi sebuah gua tersembunyi di Hutan Jati, tak jauh dari desanya. Konon, di dalam gua itu tersimpan harta karun peninggalan nenek moyang. Tanpa pikir panjang, Dimas mengajak sahabatnya, Rina, untuk ikut mencari. Mereka mempersiapkan perbekalan seadanya: senter, tali, dan beberapa botol air minum. Perjalanan menuju hutan ternyata tidak mudah. Jalan setapak yang terjal dan semak belukar yang lebat membuat mereka harus berjuang keras.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">10.</span> <span style="font-weight: normal;"><span>Pilih unsur-unsur yang terdapat dalam cerita petualangan Dimas! (Lebih dari satu jawaban benar)</span></span></p><div style="margin-left: 20px; margin-top: 4px;"><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>A. <span>Tokoh utama bernama Dimas</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>B. <span>Latar tempat di kota besar</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>C. <span>Alur cerita berupa pencarian harta karun</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>D. <span>Watak tokoh Dimas yang penakut</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>E. <span>Amanat untuk selalu berhati-hati</span></p></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 11</p><p style="text-align: justify; margin: 0px;"><span>Festival Layang-layang Nusantara kembali digelar di Pantai Sanur, Bali. Acara ini dihadiri oleh para pembuat layang-layang dari berbagai daerah di Indonesia. Ada layang-layang naga yang panjang menjulang, layang-layang garuda yang gagah, dan layang-layang hias aneka bentuk. Para pengunjung bersorak gembira melihat keindahan layang-layang yang diterbangkan tinggi di angkasa. Festival ini tidak hanya menjadi ajang unjuk kebolehan, tetapi juga sebagai sarana melestarikan tradisi permainan anak bangsa yang semakin jarang ditemui.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">11.</span> <span style="font-weight: normal;"><span>Pilih unsur intrinsik yang ada dalam cerita Festival Layang-layang Nusantara! (Lebih dari satu jawaban benar)</span></span></p><div style="margin-left: 20px; margin-top: 4px;"><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>A. <span>Tokoh: para pembuat layang-layang</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>B. <span>Latar waktu: malam hari</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>C. <span>Alur cerita: kegiatan festival</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>D. <span>Watak tokoh: pengunjung yang bersorak</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>E. <span>Amanat: melestarikan tradisi</span></p></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 12</p><p style="text-align: justify; margin: 0px;"><span>Di tepi Danau Toba yang biru jernih, tinggallah keluarga nelayan bernama keluarga Siregar. Ayah, Ibu, dan kedua anak mereka, Adi dan Lia, hidup rukun. Setiap sore, Ayah Siregar selalu mengajak Adi melaut untuk mengajarkan cara menangkap ikan. Lia, meskipun masih kecil, gemar membantu Ibunya membersihkan hasil tangkapan di rumah. Kehidupan mereka sederhana namun penuh kehangatan. Suatu ketika, badai besar datang mengancam desa mereka. Air danau naik tinggi, merusak beberapa rumah nelayan, termasuk rumah keluarga Siregar.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">12.</span> <span style="font-weight: normal;"><span>Pilih latar (tempat dan waktu) yang sesuai dengan cerita keluarga Siregar! (Lebih dari satu jawaban benar)</span></span></p><div style="margin-left: 20px; margin-top: 4px;"><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>A. <span>Tempat: Tepi Danau Toba</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>B. <span>Tempat: Hutan Jati</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>C. <span>Waktu: Saat musim kemarau</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>D. <span>Waktu: Ketika terjadi badai</span></p><p style="margin: 2px 0px; font-weight: normal;"><span style="margin-right: 8px;">☐</span>E. <span>Tempat: Desa Cipta Karya</span></p></div></div><div style="margin-bottom: 18px;"><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">13.</span> <span style="font-weight: normal;"><span>Jodohkan nama tokoh dengan wataknya yang sesuai berdasarkan cerita yang ada!</span></span></p><table style="width: 95%; border-collapse: collapse; margin-left: 20px; margin-top: 6px;"><tbody><tr><td style="width: 50%; vertical-align: top; padding: 4px 8px;"><p style="margin: 0px 0px 4px; font-weight: bold;">Premis</p><ol style="margin: 0px; padding-left: 20px; list-style-type: decimal;"><li style="margin: 2px 0px;"><span>Bima</span></li><li style="margin: 2px 0px;"><span>Dimas</span></li><li style="margin: 2px 0px;"><span>Kancil</span></li><li style="margin: 2px 0px;"><span>Ibu Bima</span></li></ol></td><td style="width: 50%; vertical-align: top; padding: 4px 8px;"><p style="margin: 0px 0px 4px; font-weight: bold;">Respon</p><ol style="margin: 0px; padding-left: 20px; list-style-type: upper-alpha;"><li style="margin: 2px 0px;"><span>Cerdik dan licik</span></li><li style="margin: 2px 0px;"><span>Rajin dan patuh</span></li><li style="margin: 2px 0px;"><span>Berani dan penuh semangat</span></li><li style="margin: 2px 0px;"><span>Ragu namun sayang pada anak</span></li></ol></td></tr></tbody></table></div><div style="margin-bottom: 18px;"><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">14.</span> <span style="font-weight: normal;"><span>Jodohkan unsur cerita dengan deskripsi yang tepat!</span></span></p><table style="width: 95%; border-collapse: collapse; margin-left: 20px; margin-top: 6px;"><tbody><tr><td style="width: 50%; vertical-align: top; padding: 4px 8px;"><p style="margin: 0px 0px 4px; font-weight: bold;">Premis</p><ol style="margin: 0px; padding-left: 20px; list-style-type: decimal;"><li style="margin: 2px 0px;"><span>Latar tempat pada cerita Bima</span></li><li style="margin: 2px 0px;"><span>Tokoh utama pada cerita Dimas</span></li><li style="margin: 2px 0px;"><span>Amanat cerita Kancil dan Buaya</span></li><li style="margin: 2px 0px;"><span>Alur cerita pada Festival Layang-layang</span></li></ol></td><td style="width: 50%; vertical-align: top; padding: 4px 8px;"><p style="margin: 0px 0px 4px; font-weight: bold;">Respon</p><ol style="margin: 0px; padding-left: 20px; list-style-type: upper-alpha;"><li style="margin: 2px 0px;"><span>Desa permai di kaki Gunung Merapi</span></li><li style="margin: 2px 0px;"><span>Pencarian harta karun</span></li><li style="margin: 2px 0px;"><span>Kecerdasan mengalahkan kekuatan</span></li><li style="margin: 2px 0px;"><span>Kegiatan festival</span></li></ol></td></tr></tbody></table></div><div style="margin-bottom: 18px;"><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">15.</span> <span style="font-weight: normal;"><span>Jodohkan latar tempat dengan cerita yang berhubungan!</span></span></p><table style="width: 95%; border-collapse: collapse; margin-left: 20px; margin-top: 6px;"><tbody><tr><td style="width: 50%; vertical-align: top; padding: 4px 8px;"><p style="margin: 0px 0px 4px; font-weight: bold;">Premis</p><ol style="margin: 0px; padding-left: 20px; list-style-type: decimal;"><li style="margin: 2px 0px;"><span>Loteng rumah nenek</span></li><li style="margin: 2px 0px;"><span>Tepi Danau Toba</span></li><li style="margin: 2px 0px;"><span>Pantai Sanur, Bali</span></li><li style="margin: 2px 0px;"><span>Warung kecil di desa</span></li></ol></td><td style="width: 50%; vertical-align: top; padding: 4px 8px;"><p style="margin: 0px 0px 4px; font-weight: bold;">Respon</p><ol style="margin: 0px; padding-left: 20px; list-style-type: upper-alpha;"><li style="margin: 2px 0px;"><span>Cerita keluarga Siregar</span></li><li style="margin: 2px 0px;"><span>Cerita Festival Layang-layang</span></li><li style="margin: 2px 0px;"><span>Cerita Bima membantu ibunya</span></li><li style="margin: 2px 0px;"><span>Cerita Dimas menemukan peta</span></li></ol></td></tr></tbody></table></div><div style="margin-bottom: 18px;"><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">16.</span> <span style="font-weight: normal;"><span>Jodohkan kejadian penting dengan urutan alur ceritanya!</span></span></p><table style="width: 95%; border-collapse: collapse; margin-left: 20px; margin-top: 6px;"><tbody><tr><td style="width: 50%; vertical-align: top; padding: 4px 8px;"><p style="margin: 0px 0px 4px; font-weight: bold;">Premis</p><ol style="margin: 0px; padding-left: 20px; list-style-type: decimal;"><li style="margin: 2px 0px;"><span>Awal cerita Bima</span></li><li style="margin: 2px 0px;"><span>Bagian tengah cerita Dimas</span></li><li style="margin: 2px 0px;"><span>Akhir cerita keluarga Siregar</span></li><li style="margin: 2px 0px;"><span>Awal cerita Kancil dan Buaya</span></li></ol></td><td style="width: 50%; vertical-align: top; padding: 4px 8px;"><p style="margin: 0px 0px 4px; font-weight: bold;">Respon</p><ol style="margin: 0px; padding-left: 20px; list-style-type: upper-alpha;"><li style="margin: 2px 0px;"><span>Kancil berpura-pura menghitung buaya</span></li><li style="margin: 2px 0px;"><span>Rumah keluarga Siregar rusak karena badai</span></li><li style="margin: 2px 0px;"><span>Bima membantu ibunya di warung</span></li><li style="margin: 2px 0px;"><span>Dimas dan Rina berjalan di hutan</span></li></ol></td></tr></tbody></table></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 17</p><p style="text-align: justify; margin: 0px;"><span>Cerita tentang Kancil dan Buaya adalah salah satu dongeng favorit anak-anak Indonesia. Dalam cerita ini, Kancil yang cerdik berhasil menipu sekawanan buaya untuk menyusun barisan agar ia bisa menyeberangi sungai. Kancil berpura-pura bahwa Raja Buaya ingin mengadakan pesta dan membutuhkan banyak daging buaya. Dengan akalnya, Kancil berhasil sampai ke seberang sungai dengan selamat tanpa digigit buaya. Dongeng ini mengajarkan bahwa kecerdasan dapat mengalahkan kekuatan fisik.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">17.</span> <span style="font-weight: normal;"><span>Siapakah tokoh utama dalam dongeng tentang hewan cerdik yang menipu buaya?</span></span></p><div style="margin-left: 20px;"><table role="presentation" width="100%" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 6px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"><tbody><tr><td style="border-width: medium; border-style: none; border-color: currentcolor; border-image: none; width: 75px; padding: 0px 8px 2px 0px; vertical-align: bottom;">Jawaban:</td><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 22px; line-height: 22px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr></tbody></table></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 18</p><p style="text-align: justify; margin: 0px;"><span>Festival Layang-layang Nusantara kembali digelar di Pantai Sanur, Bali. Acara ini dihadiri oleh para pembuat layang-layang dari berbagai daerah di Indonesia. Ada layang-layang naga yang panjang menjulang, layang-layang garuda yang gagah, dan layang-layang hias aneka bentuk. Para pengunjung bersorak gembira melihat keindahan layang-layang yang diterbangkan tinggi di angkasa. Festival ini tidak hanya menjadi ajang unjuk kebolehan, tetapi juga sebagai sarana melestarikan tradisi permainan anak bangsa yang semakin jarang ditemui.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">18.</span> <span style="font-weight: normal;"><span>Di manakah lokasi diadakannya Festival Layang-layang Nusantara yang diceritakan?</span></span></p><div style="margin-left: 20px;"><table role="presentation" width="100%" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 6px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"><tbody><tr><td style="border-width: medium; border-style: none; border-color: currentcolor; border-image: none; width: 75px; padding: 0px 8px 2px 0px; vertical-align: bottom;">Jawaban:</td><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 22px; line-height: 22px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr></tbody></table></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 19</p><p style="text-align: justify; margin: 0px;"><span>Di sebuah desa yang permai di kaki Gunung Merapi, hiduplah seorang anak bernama Bima. Bima dikenal sebagai anak yang rajin membantu ibunya di warung kecil mereka. Setiap pagi, sebelum matahari terbit, ia sudah bangun untuk menyapu halaman dan menyiapkan dagangan. Suatu hari, seorang saudagar kaya dari kota datang ke desa Bima. Ia terpesona oleh kejujuran dan kerajinan Bima. Saudagar itu kemudian mengajak Bima untuk bekerja di tokonya di kota, dengan janji pendidikan dan kehidupan yang lebih baik. Ibu Bima awalnya ragu, namun melihat kesempatan besar untuk masa depan anaknya, ia pun mengizinkan.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">19.</span> <span style="font-weight: normal;"><span>Berdasarkan teks, bagaimana watak Bima dalam membantu ibunya?</span></span></p><div style="margin-left: 20px;"><table role="presentation" width="100%" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 6px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"><tbody><tr><td style="border-width: medium; border-style: none; border-color: currentcolor; border-image: none; width: 75px; padding: 0px 8px 2px 0px; vertical-align: bottom;">Jawaban:</td><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 22px; line-height: 22px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr></tbody></table></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 20</p><p style="text-align: justify; margin: 0px;"><span>Di tepi Danau Toba yang biru jernih, tinggallah keluarga nelayan bernama keluarga Siregar. Ayah, Ibu, dan kedua anak mereka, Adi dan Lia, hidup rukun. Setiap sore, Ayah Siregar selalu mengajak Adi melaut untuk mengajarkan cara menangkap ikan. Lia, meskipun masih kecil, gemar membantu Ibunya membersihkan hasil tangkapan di rumah. Kehidupan mereka sederhana namun penuh kehangatan. Suatu ketika, badai besar datang mengancam desa mereka. Air danau naik tinggi, merusak beberapa rumah nelayan, termasuk rumah keluarga Siregar.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">20.</span> <span style="font-weight: normal;"><span>Apa yang dilakukan keluarga Siregar di awal cerita sebelum badai datang?</span></span></p><div style="margin-left: 20px;"><table role="presentation" width="100%" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 6px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"><tbody><tr><td style="border-width: medium; border-style: none; border-color: currentcolor; border-image: none; width: 75px; padding: 0px 8px 2px 0px; vertical-align: bottom;">Jawaban:</td><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 22px; line-height: 22px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr></tbody></table></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 21</p><p style="text-align: justify; margin: 0px;"><span>Desa Cipta Karya terkenal dengan kerajinan batiknya. Ibu-ibu di desa ini memiliki keahlian luar biasa dalam menggambar motif-motif indah di atas kain. Salah satu motif yang paling populer adalah motif bunga melati yang melambangkan kesucian dan keindahan. Pak Lurah sangat mendukung para pengrajin batik desa. Ia sering membantu mempromosikan batik Cipta Karya ke berbagai pameran di kota. Berkat kerja keras mereka, batik dari desa ini kini mulai dikenal luas dan menjadi sumber penghidupan utama bagi banyak keluarga.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">21.</span> <span style="font-weight: normal;"><span>Jelaskan siapa saja tokoh yang ada dalam cerita tentang desa Cipta Karya dan bagaimana watak mereka berdasarkan teks!</span></span></p><div style="margin-left: 20px;"><table role="presentation" width="100%" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 8px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"><tbody><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr></tbody></table></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 22</p><p style="text-align: justify; margin: 0px;"><span>Kisah petualangan Dimas dimulai saat ia menemukan peta tua di loteng rumah neneknya. Peta itu menunjukkan lokasi sebuah gua tersembunyi di Hutan Jati, tak jauh dari desanya. Konon, di dalam gua itu tersimpan harta karun peninggalan nenek moyang. Tanpa pikir panjang, Dimas mengajak sahabatnya, Rina, untuk ikut mencari. Mereka mempersiapkan perbekalan seadanya: senter, tali, dan beberapa botol air minum. Perjalanan menuju hutan ternyata tidak mudah. Jalan setapak yang terjal dan semak belukar yang lebat membuat mereka harus berjuang keras.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">22.</span> <span style="font-weight: normal;"><span>Berdasarkan teks tentang petualangan Dimas, jelaskan latar tempat dan latar waktu terjadinya peristiwa utama!</span></span></p><div style="margin-left: 20px;"><table role="presentation" width="100%" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 8px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"><tbody><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr></tbody></table></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 23</p><p style="text-align: justify; margin: 0px;"><span>Di sebuah desa yang permai di kaki Gunung Merapi, hiduplah seorang anak bernama Bima. Bima dikenal sebagai anak yang rajin membantu ibunya di warung kecil mereka. Setiap pagi, sebelum matahari terbit, ia sudah bangun untuk menyapu halaman dan menyiapkan dagangan. Suatu hari, seorang saudagar kaya dari kota datang ke desa Bima. Ia terpesona oleh kejujuran dan kerajinan Bima. Saudagar itu kemudian mengajak Bima untuk bekerja di tokonya di kota, dengan janji pendidikan dan kehidupan yang lebih baik. Ibu Bima awalnya ragu, namun melihat kesempatan besar untuk masa depan anaknya, ia pun mengizinkan.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">23.</span> <span style="font-weight: normal;"><span>Cerita tentang Bima yang diajak bekerja di kota memiliki alur maju. Jelaskan kejadian-kejadian yang termasuk dalam bagian awal, tengah, dan akhir dari alur cerita tersebut!</span></span></p><div style="margin-left: 20px;"><table role="presentation" width="100%" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 8px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"><tbody><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr></tbody></table></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 24</p><p style="text-align: justify; margin: 0px;"><span>Cerita tentang Kancil dan Buaya adalah salah satu dongeng favorit anak-anak Indonesia. Dalam cerita ini, Kancil yang cerdik berhasil menipu sekawanan buaya untuk menyusun barisan agar ia bisa menyeberangi sungai. Kancil berpura-pura bahwa Raja Buaya ingin mengadakan pesta dan membutuhkan banyak daging buaya. Dengan akalnya, Kancil berhasil sampai ke seberang sungai dengan selamat tanpa digigit buaya. Dongeng ini mengajarkan bahwa kecerdasan dapat mengalahkan kekuatan fisik.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">24.</span> <span style="font-weight: normal;"><span>Dongeng Kancil dan Buaya mengajarkan bahwa 'kecerdasan dapat mengalahkan kekuatan fisik'. Jelaskan mengapa pesan moral ini penting dan bagaimana penerapannya dalam kehidupan sehari-hari siswa!</span></span></p><div style="margin-left: 20px;"><table role="presentation" width="100%" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 8px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"><tbody><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr></tbody></table></div></div><div style="margin-bottom: 18px;"><div style="margin-bottom: 18px;"><p style="font-weight: bold; margin-bottom: 8px;">Teks untuk Soal no. 25</p><p style="text-align: justify; margin: 0px;"><span>Festival Layang-layang Nusantara kembali digelar di Pantai Sanur, Bali. Acara ini dihadiri oleh para pembuat layang-layang dari berbagai daerah di Indonesia. Ada layang-layang naga yang panjang menjulang, layang-layang garuda yang gagah, dan layang-layang hias aneka bentuk. Para pengunjung bersorak gembira melihat keindahan layang-layang yang diterbangkan tinggi di angkasa. Festival ini tidak hanya menjadi ajang unjuk kebolehan, tetapi juga sebagai sarana melestarikan tradisi permainan anak bangsa yang semakin jarang ditemui.</span></p></div><p style="margin: 0px 0px 6px; font-weight: normal;"><span style="font-weight: bold;">25.</span> <span style="font-weight: normal;"><span>Jelaskan latar tempat dan sebutkan tokoh-tokoh yang terlibat dalam cerita Festival Layang-layang Nusantara berdasarkan teks yang diberikan!</span></span></p><div style="margin-left: 20px;"><table role="presentation" width="100%" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 8px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"><tbody><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr><tr><td style="border-width: medium medium 1px; border-style: none none solid; border-color: currentcolor currentcolor rgb(85, 85, 85); border-image: none; height: 28px; line-height: 28px; padding: 0px; vertical-align: bottom;">&nbsp;</td></tr></tbody></table></div></div></div><div style=""></div><div data-subsection="soal-kisi" style="margin-top: 24px;"><h2 style="font-weight: bold; font-size: 12pt; text-align: center; margin-bottom: 12px;">KISI-KISI / ANALISIS BUTIR SOAL</h2><table style="width: 100%; border-collapse: collapse; border: 1px solid rgb(0, 0, 0); margin-bottom: 16px;"><thead><tr><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: center; width: 6%;">No</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left; width: 22%;">Tipe Soal</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 8px; background-color: rgb(229, 231, 235); font-weight: bold; text-align: left; width: 14%;">Level Kognitif</th><th style="border: 1px solid rgb(0, 0, 0); padding: 6px 