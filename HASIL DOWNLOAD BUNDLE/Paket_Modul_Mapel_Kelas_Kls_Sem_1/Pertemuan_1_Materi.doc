    "penjaskes": "",
    "matematika": "Tidak terlalu relevan secara langsung.",
    "seniBudaya": "",
    "bahasaIndonesia": "Pengembangan keterampilan berbicara (berdiskusi, presentasi), menyimak (mendengarkan pendapat), dan menulis (refleksi, mencatat ide)."
  },
  "materiIntegrasiKBC": "",
  "metodePembelajaran": [
    "Ceramah Interaktif",
    "Diskusi Kelompok",
    "Tanya Jawab"
  ],
  "pemanfaatanDigital": "",
  "tujuanPembelajaran": "TP1: Peserta didik mampu menjelaskan keunikan karakter diri sendiri dan menghargai keberagaman karakter teman sebaya melalui kegiatan diskusi kelas.",
  "capaianPembelajaran": "Murid mampu memahami ide pokok informasi tentang keunikan diri dan keberagaman teman sebaya, serta menyajikan pendapat dan menanggapi diskusi sesuai tata cara.",
  "karakteristikMateri": "",
  "aspekPengetahuanAwal": "Murid Kelas IV (Fase B) telah mengenal konsep 'diri sendiri' dan 'teman'. Mereka mungkin sudah memiliki pengalaman berinteraksi dengan teman yang memiliki karakter dan latar belakang yang berbeda. Murid juga umumnya sudah dapat mengidentifikasi beberapa karakteristik atau kesukaan pribadi mereka.",
  "dimensiProfilLulusan": [
    "DPL 3",
    "DPL 6"
  ],
  "aspekKebutuhanBelajar": "Murid memerlukan bimbingan dalam mengidentifikasi, mengekspresikan keunikan diri, dan mengembangkan empati serta toleransi terhadap keberagaman. Mereka membutuhkan kesempatan untuk praktik diskusi, kolaborasi, dan refleksi diri untuk membangun pemahaman yang mendalam.",
  "kemitraanPembelajaran": {
    "orangTua": "Mendorong anak untuk berbagi pengalaman tentang keunikan diri dan menghargai perbedaan yang ditemui di lingkungan rumah dan masyarakat.",
    "duniaUsaha": "",
    "instansiTerkait": "Tidak ada.",
    "tokohMasyarakat": "",
    "perguruanTinggiLSM": "",
    "guruBidangStudiLain": "Guru PPKn (untuk penguatan nilai toleransi dan kebhinekaan), Guru Seni Budaya (untuk apresiasi bakat dan ekspresi keunikan diri).",
    "mgmpKomunitasBelajar": ""
  },
  "pemanfaatanDigitalDetail": {
    "asesmen": "Penggunaan formulir daring sederhana untuk refleksi individu (jika ada perangkat yang memadai) atau sekadar pencatatan observasi guru melalui aplikasi digital.",
    "pelaksanaan": "Menampilkan video atau gambar ilustrasi tentang keberagaman melalui proyektor, serta bisa memanfaatkan aplikasi polling sederhana untuk mengumpulkan pendapat awal jika waktu memungkinkan.",
    "perencanaan": "Menggunakan perangkat lunak presentasi (misalnya PowerPoint atau Canva) untuk menyiapkan materi pengantar dan panduan diskusi."
  },
  "lingkunganPembelajaranDetail": {
    "ruangFisik": "Kelas yang fleksibel dengan pengaturan meja dan kursi yang mudah diubah untuk diskusi kelompok. Tersedia papan tulis/layar proyektor untuk menampilkan media pembelajaran.",
