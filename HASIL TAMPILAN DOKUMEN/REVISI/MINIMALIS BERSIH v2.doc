<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns:m='http://schemas.openxmlformats.org/officeDocument/2006/math' xmlns='http://www.w3.org/TR/REC-html40'><head><meta charset='utf-8'><title>Modul_Multi_Bahasa_Indonesia_5_Ide_Pokok_Inti_pembahasan</title><style>
/* Reset dasar */
*{box-sizing:border-box;margin:0;padding:0;min-height:0!important;max-height:none!important;
  height:auto!important;flex:none!important;overflow:visible!important;
  position:static!important;float:none!important}
