<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns:m='http://schemas.openxmlformats.org/officeDocument/2006/math' xmlns='http://www.w3.org/TR/REC-html40'><head><meta charset='utf-8'><title>Modul_Multi_Matematika_Kelas_III_Kalimat_Matematika</title><style>
/* Reset dasar */
*{box-sizing:border-box;margin:0;padding:0;min-height:0!important;max-height:none!important;
  height:auto!important;flex:none!important;overflow:visible!important;
