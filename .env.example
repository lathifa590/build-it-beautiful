# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN pernah commit file `.env` (sudah masuk .gitignore).
#
# Hanya 3 variabel di bawah yang benar-benar dibaca oleh src/.
# Untuk deploy, isi yang sama di Cloudflare Pages -> Settings -> Variables and secrets.

# Dipakai di src/integrations/supabase/client.ts dan beberapa fetch ke Edge Functions.
VITE_SUPABASE_URL=

# Dipakai di src/integrations/supabase/client.ts dan src/pages/Auth.tsx.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Fitur Dokumen Pertemuan V2. Biarkan kosong / 'false' untuk mematikan.
VITE_ENABLE_PERTEMUAN_DOCS_V2=false

# Catatan: VITE_SUPABASE_PROJECT_ID dan VITE_SUPABASE_ANON_KEY tidak dipakai
# oleh kode mana pun. Boleh dihapus dari .env lokal.
