# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN pernah commit file `.env` (sudah masuk .gitignore).
# Untuk deploy, isi variabel yang sama di dashboard hosting (Cloudflare Pages / Vercel).

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_ENABLE_PERTEMUAN_DOCS_V2=true
